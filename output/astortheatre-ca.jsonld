    ],
    "http://schema.org/name": [
      {
        "@value": "Astor Academy Filmmaking Club"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Attention Young Filmmakers!</p>\\n<p>Filmmaking Club was started by Kyle Smyth in 2024.  We were very excited to have Dan Williams join us soon afterwards.  Our club members make original short films and take their projects from screenwriting, editing, production planning, cinematography, directing, and editing to get them to the final product. </p>\\n"
      }
    ],
