    "http://schema.org/name": [
      {
        "@value": "Harry Potter and the Sorcerer&#8217;s Stone &#8211; 25th Anniversary"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;It’s Back to Hogwarts season and, as we celebrate the 25th Anniversary of the first film, this year is extra special. You’re invited to return to Harry Potter and the Philosopher’s Stone at the Astor, with 12 minutes of never-before-seen behind-the-scenes footage debuting on the big screen.&lt;/p&gt;\\n"
      }
    ],
