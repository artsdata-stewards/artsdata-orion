    ],
    "http://schema.org/image": [
      {
        "@id": "https://astortheatre.ca/wp-content/uploads/2026/08/Big-Stage-Open-Mic-june-11-x-17-in.webp"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://astortheatre.ca/event/september-big-stage-open-mic-night/"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-09-26T18:30:00-03:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-09-26T21:30:00-03:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://astortheatre.ca/genid/d47f147c2982c024"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://astortheatre.ca/event/september-big-stage-open-mic-night/"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "September Big Stage Open Mic Night"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Big Stage Open Mics are BACK at the Astor on Saturday, September 26!&lt;br /&gt;\\nJoin us for a fantastic evening featuring local community talent.&lt;br /&gt;\\nWe have missed you on our stage!&lt;br /&gt;\\nYou can sing, dance, tell jokes, read a poem, play the piano – you have a talent- we want to see it!&lt;br /&gt;\\nYou can sign up the night of the event at 6 p.m. at our Box Office&lt;br /&gt;\\nJust want to watch? No problem, this is a free, all-ages event. Come on out and support local talent in our community!&lt;br /&gt;\\nThis event is free for all ages. We will be collecting donations at the door to help us continue offering events like this one to our community.&lt;br /&gt;\\nOur Astor bar and concessions will be open&lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@value": "Organization"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
