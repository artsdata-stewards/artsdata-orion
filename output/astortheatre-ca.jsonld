  {
    "@id": "https://astortheatre.ca/event/a-homeland-christmas-we-are-canadian/2026-12-12/",
    "https://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "https://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "A Homeland Christmas - We ARE Canadian! | Astor Theatre & Arts Centre"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Christmas and the holiday season for those of different cultures is important. It's a time to gather as community . And in solidarity for all we hold dear. The memories we gather.....Those we remember.....The young ones we encourage. The beautiful life we live here...in Canada. Homeland Christmas is a gathering ... and... a wonderful one! It pairs the best of professional musicians from Canada with much of our very own talent and brings together a magnificent cast to give you the best of Christmas and the holiday season on Broadway right here at home. Don your Christmas and holiday finery as will we, and truly celebrate this beautiful place we call home. Come early. Celebrate with a glass of something nice. Find friends and make new ones. It's easy when there are friends easily found!"
      }
    ],
    "https://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://astortheatre.ca/event/a-homeland-christmas-we-are-canadian/2026-12-12/"
      }
    ],
