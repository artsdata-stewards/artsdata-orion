    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "A modern indie folk trio from Newfoundland, The Once have collected a trio of Canadian Folk Music Awards, numerous ECMA awards, and was named Artist of the Year by the Newfoundland & Labrador Arts Council. They have earned not one, but two JUNO nominations for Roots Album of the Year and continue to take their music around the world."
      }
    ],
