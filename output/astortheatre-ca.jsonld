  {
    "@id": "https://astortheatre.ca/event/moments-of-youth/",
    "https://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "https://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Moments of Youth | Astor Theatre & Arts Centre"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "On the night before graduation, the Senior Class at Winthrop Creek High partakes in a fun-filled scavenger hunt which features a massive grand prize. With their dreams on the horizon, they share one epic night of laughs and secrets before their futures begin.Winner of 40 Film Festival awards worldwide, Moments of Youthis screening on October 2nd at 6 PM at the Astor Theater! A virtual Q+A will immediately follow both screenings with Writer/Director, Gregory Pellerito and members of the creative team. Gregory and the team are excited to field your questions on all things Moments of Youth, and the film world. The film was released in January on Amazon and is receiving rave reviews. Drawing many comparisons to beloved films such as Ferris Bueller's Day Off, Dazed and Confused, and The Breakfast Club; Moments of Youth is being heralded as a modern-day classic."
      }
    ],
    "https://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://astortheatre.ca/event/moments-of-youth/"
      }
    ],
