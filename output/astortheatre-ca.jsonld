    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Nirvanna the Band the Show the Movie (2025) is a comedy film directed by Matt Johnson, continuing his mockumentary series about two best friends (Matt and Jay) trying to book a gig at Toronto\\'s Rivoli club. The movie follows them using a \"time machine\" to 2008 to finally achieve their goal, featuring high-concept stunts. </p>\\n"
      }
