    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>With Robert Chafe, one of Canada’s most acclaimed performers.Discover Taking on Water, a spellbinding blend of theatre, music, and movement that brings the stories of coastal Newfoundland and Labrador to life.Award-winning actor and writer Robert Chafe interviewed residents living and working along a rapidly changing ocean.</p>\\n"
      }
