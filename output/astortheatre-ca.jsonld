    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Astor Academy Animation Club"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Calling all kids aged 7 to 13!</p>\\n<p>Have you ever wanted to make your own animated movies?</p>\\n<p>Stop-Motion Club started in 2024 by Desmond Smyth, a local high school student who had an interest in Stop-Motion when he was younger and wanted to teach the younger generation about this animation form.</p>\\n<p>Our club has expanded, not only teaching stop-motion animation but 2D frame-by-frame hand-drawn-style animation, green screen animation, and frame-by-frame pivot-stick-figure-style techniques all using your cellphone or tablet. </p>\\n"
      }
    ],
