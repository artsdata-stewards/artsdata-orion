    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Astor Academy Playwrights Study Circle | Astor Theatre & Arts Centre"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Are you interet interested in learning about theatre and famous theatre playwrights?   Join Katherine Schellmer in the Playwrights Study Circle!  A brand new Astor Academy designed for adults.  Meeting on Friday evenings in our Gorham Room, this program will provide a fun, informative learning experience. Katherine has written professionally for theatre, TV, radio, and film.  She was also an educator at The National Theatre School of Canada for three years, running a sessional course entitled “Solo Show” in which she mentored and then directed students performing their own works.  She hopes to use her experience/knowledge to invigorate the theatre community in Queens County. In this program, the group study a specific playwright, as well as the time period the play was written in; world events, cultural events, the forces that shaped the creation of the work, and the reaction to the work when it premiered."
      }
    ],
    "https://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://astortheatre.ca/event/astor-academy-playwrights-study-circle/"
      }
    ],
