      }
    ],
    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "September Big Stage Open Mic Night | Astor Theatre & Arts Centre"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Big Stage Open Mics are BACK at the Astor on Saturday, September 26! Join us for a fantastic evening featuring local community talent. We have missed you on our stage! You can sing, dance, tell jokes, read a poem, play the piano – you have a talent- we want to see it! You can sign up the night of the event at 6 p.m. at our Box Office Just want to watch? No problem, this is a free, all-ages event. Come on out and support local talent in our community! This event is free for all ages. We will be collecting donations at the door to help us continue offering events like this one to our community. Our Astor bar and concessions will be open"
      }
    ],
    "https://ogp.me/ns#url": [
      {
        "@language": "en-us",
