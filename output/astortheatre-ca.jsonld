      }
    ],
    "http://schema.org/name": [
      {
        "@value": "The Stanfields"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;In celebration of 30 years of Queens County, The Stanfields are coming to the Astor Stage! The Stanfields are a multiple award-winning six-piece Folk\\'n\\'Roll band based in Halifax, Canada. Combining Rock music with solid nods to Celtic and Americana, they play what they want, sing what they feel, and leave nothing on the table.&lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@value": "Organization"
      }
    ],
    "http://schema.org/keywords": [
      {
        "@value": "Live Performances"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
