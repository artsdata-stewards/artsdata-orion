    ],
    "http://schema.org/image": [
      {
        "@id": "https://astortheatre.ca/wp-content/uploads/2026/10/SAS-Glass-Adult-Workshop-11-x-17-in-1.webp"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://astortheatre.ca/event/sas-glass-stained-glass-xmas-ornaments-workshop/2026-11-26/"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-26T17:00:00-04:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-26T20:00:00-04:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://astortheatre.ca/genid/d47f147c2982c024"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://astortheatre.ca/events/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "SAS Glass Stained Glass Xmas Ornaments Workshop"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Each participant will fabricate at least 4 stained-glass Xmas ornaments by fusing or kiln carving.</p>\\n<p>Activity: pick out glass, frit, cut and grind glass, cut paper and design kiln-carved and fused Xmas decorations. Finished results ready for pickup the next day after firing at SAS Glass</p>\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": "Organization"
      }
    ],
