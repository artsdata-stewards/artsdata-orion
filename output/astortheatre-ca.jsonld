  {
    "@id": "https://astortheatre.ca/event/scary-movie-6/2026-07-21/",
    "https://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "https://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Scary Movie 6 | Astor Theatre & Arts Centre"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Twenty-six years after outrunning a suspiciously familiar masked killer (“Ghostface”), the Core Four are back in the killer’s crosshairs and no horror movie IP is safe. Marlon Wayans (“Shorty”), Shawn Wayans (“Ray”), Anna Faris (“Cindy”), and Regina Hall (“Brenda”) reunite in Scary Movie alongside returning favorites and fresh faces to slash through reboots, remakes, requels, prequels, sequels, spin-offs, elevated horror, origin stories, anything with the word legacy in it, and every “final chapter” that absolutely isn’t final. Nothing is sacred. No trope survives. Every line gets crossed. The Wayans are back to cancel the Cancel Culture."
      }
    ],
    "https://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://astortheatre.ca/event/scary-movie-6/2026-07-21/1/"
      }
    ],
    "https://ogp.me/ns#site_name": [
