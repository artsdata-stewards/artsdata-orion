    ],
    "http://schema.org/image": [
      {
        "@id": "https://astortheatre.ca/wp-content/uploads/2026/09/Once-Upon-A-Time-In-A-Cinema-OG.webp"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://astortheatre.ca/event/lcfs-once-upon-a-time-in-a-cinema/2026-10-07/1/"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-10-07T16:00:00-03:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-10-07T18:00:00-03:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://astortheatre.ca/genid/d47f147c2982c024"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://astortheatre.ca/event/lcfs-once-upon-a-time-in-a-cinema/2026-10-07/1/"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "LCFS: ONCE UPON A TIME IN A CINEMA"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>ONCE UPON A TIME IN A CINEMA is set in a small-town cinema during one eventful Friday night screening from hell. Over the course of one evening, the film follows the travails of beleaguered cinema owner Earl Clancy (Colin Morgan) as he faces a myriad of disasters, any one of which could sink him. Drawing from writer/director David Gleeson\\'s own experience growing up in a family of cinema owners where his father\\'s 78-year career marked the longest in the cinema business in Ireland, if not the world, this film is a love letter to a peculiarly Irish cinema experience, which was as much about connecting with people as it was about the movie.</p>\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@value": "Organization"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
  {
    "@id": "https://astortheatre.ca/event/lcfs-once-upon-a-time-in-a-cinema/2026-10-07/1/#masthead",
    "@type": [
      "https://schema.org/WPHeader"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://astortheatre.ca/event/lcfs-once-upon-a-time-in-a-cinema/2026-10-07/1/"
      }
    ]
