    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>A former political prisoner who believes he recognizes his torturer in a man whose car broke down at his garage. After kidnapping him, Vahid and friends grapple with doubt, morality, and revenge. It is a profound, politically charged exploration of trauma. </p>\\n"
      }
