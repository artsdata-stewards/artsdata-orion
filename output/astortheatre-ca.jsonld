      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://astortheatre.ca/event/seniors-creating-an-astor-academy-program/2026-11-24/"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
