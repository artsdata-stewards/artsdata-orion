    "http://schema.org/url": [
      {
        "@id": "https://astortheatre.ca/event/los-desperados-canadas-premier-tribute-to-the-eagles-2/"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
