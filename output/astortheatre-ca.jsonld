    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Grand Tour"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>THE GRAND TOUR is a timeless journey through classic country music! Join us for electrifying performances of hits from the 50\\'s, 60\\'s, 70\\'s, and 80\\'s.</p>\\n<p>Experience the soulful voices of George Jones, Johnny Cash, Conway Twitty, Jim Reeves, Charley Pride and much more, brought to life with fresh energy and passion. These talented musicians will have you remembering the days when you would sing along to the radio or sitting at the Grand Ole Opry! Don\\'t miss this nostalgic celebration of country music\\'s rich heritage!</p>\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": "Organization"
      }
    ],
