      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Step into a world of \"reverie”, mystery and music! When a group of troubled teenage girls—including a fashionista, a lonely wallflower, and a fame-weary pop star—arrive at Camp Steeped, they expect a typical therapeutic camp. Instead, a sip of \"super-steeped\" tea, transports them to Nocturne Grove, a surreal realm where magic is banned and an eccentric, evil Queen uses mind-control to dominate her subjects. "
      }
    ],
    "https://ogp.me/ns#url": [
