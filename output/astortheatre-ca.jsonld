    ],
    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Astor Academy Animation Club | Astor Theatre & Arts Centre"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Calling all kids aged 7 to 13! Have you ever wanted to make your own animated movies? Stop-Motion Club started in 2024 by Desmond Smyth, a local high school student who had an interest in Stop-Motion when he was younger and wanted to teach the younger generation about this animation form. Our club has expanded, not only teaching stop-motion animation but 2D frame-by-frame hand-drawn-style animation, green screen animation, and frame-by-frame pivot-stick-figure-style techniques all using your cellphone or tablet. "
      }
    ],
    "https://ogp.me/ns#url": [
      {
