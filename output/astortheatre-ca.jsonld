    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Panic at the Radio Station – Radio Theatre Camp Production"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Come join the Astor Academy Radio Theatre Camp as they put on a skit show, \"Panic at The Radio Station\" that spans parody, satire, and slapstick, all set in a News Broadcasting Station in Halifax. Completely written and voiced by our talented youth, this production will make you laugh and cry, so come out this Friday at 5pm.</p>\\n"
      }
