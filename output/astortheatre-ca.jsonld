  {
    "@id": "https://astortheatre.ca/event/john-wing-go-east-old-man-with-special-guest-dan-mitchelmore/",
    "https://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "https://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "John Wing - Go East, Old Man With Special Guest Dan Mitchelmore | Astor Theatre & Arts Centre"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "⭐ The Man, The Myth, The Credits ⭐ John Wing's resume reads like a history book of late-night television and world-renowned comedy stages. He has amassed over 350 television appearances across North America. John will be joined by Halifax comedian Dan Mitchelmore, one of the rising young voices in Nova Scotia's comedy scene. Dan has been performing stand-up across the city and province for the past two years. He's known for his approachable style, crowd engagement, and ability to create a fun atmosphere wherever he perform John will also be using a special Guitar during the show which will be donated to Guitars for Vets after the tour. We welcome Vets and Family members to sign the guitar case or place a card in it with a special message for the Vet that will receive it."
      }
    ],
    "https://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://astortheatre.ca/event/john-wing-go-east-old-man-with-special-guest-dan-mitchelmore/"
      }
    ],
    "https://ogp.me/ns#site_name": [
