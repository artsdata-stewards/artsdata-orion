        "@value": "E.T. The Extra-Terrestrial Sponsored by the Region of Queens Municipality"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;E.T. the Extra-Terrestrial (1982), directed by Steven Spielberg, tells the story of a lonely 10-year-old boy named Elliott who befriends a gentle alien stranded on Earth. Elliott, his older brother Michael, and little sister Gertie hide the extraterrestrial in their suburban home, forming a deep emotional and telepathic bond with him.&lt;/p&gt;\\n"
      }
    ],
