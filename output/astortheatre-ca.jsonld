    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Campbell & Johnston: A Modern guitar-driven blues steeped in Classic Rock & Roots Whether performing as an acoustic duo or fronting a full electric band, they deliver a seamless interplay of blistering guitar solos, soulful vocals, and rich harmonies. Their live shows pulse with raw energy and emotional intimacy, leaving audiences both exhilarated and deeply moved."
      }
    ],
