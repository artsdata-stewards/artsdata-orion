    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Returning for the third year, Andrew will be joining us again from New York City to lead our one-week musical theatre camp. Andrew is a NY-based actor and teacher, originally from Truro, and has been running his camps in theatres around NS for the last 17 summers!</p>\\n"
      }
