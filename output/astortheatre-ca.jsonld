  {
    "@id": "https://astortheatre.ca/event/the-met-opera-eugene-onegin/",
    "https://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "https://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "The Met Opera : Eugene Onegin | Astor Theatre & Arts Centre"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Following her acclaimed 2024 company debut in Puccini’s Madama Butterfly, soprano Asmik Grigorian returns to the Met as Tatiana, the lovestruck young heroine in this ardent operatic adaptation of Pushkin, which will be transmitted live from the Metropolitan Opera stage. Baritone Iurii Samoilov is the urbane Onegin, who realizes his affection for her all too late. The Met’s evocative production, directed by Tony Award–winner Deborah Warner, “offers a beautifully detailed reading of … Tchaikovsky’s lyrical romance” (The Telegraph)."
      }
    ],
    "https://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://astortheatre.ca/event/the-met-opera-eugene-onegin/"
      }
    ],
