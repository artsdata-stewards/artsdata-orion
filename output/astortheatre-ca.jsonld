    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Alfie Zappacosta is undeniably one of Canada’s premier songwriters and performers with chart topping hits and a recording and acting career that has spanned 40 years. He continues to evolve as an artist by “doing it his way”, an effort that has been rewarded with an impressive song catalogue and a discerning loyal fan base.</p>\\n"
      }
