    ],
    "http://schema.org/name": [
      {
        "@value": "HADESTOWN: THE MUSICAL"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;The live theater capture of the hit musical Hadestown, which won eight Tony Awards in 2019 including Best Musical and the 2020 Grammy Award for Best Musical Theater Album, featuring the five original principals of the Broadway company. The genre-defying new musical blends modern American folk music with New Orleans-inspired jazz to reimagine a sweeping ancient tale. Following two intertwining love stories — that of young dreamers Orpheus and Eurydice, and that of King Hades and his wife Persephone — Hadestown invites audiences on a hell-raising journey to the underworld and back.&lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@value": "Organization"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
