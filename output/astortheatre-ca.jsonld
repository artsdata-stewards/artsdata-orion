  {
    "@id": "https://astortheatre.ca/genid/a473e92d667c1284",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/image": [
      {
        "@id": "https://astortheatre.ca/wp-content/uploads/2026/09/Playwrights-Study-Circle-Poster-2-1.webp"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://astortheatre.ca/event/astor-academy-playwrights-study-circle/"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-09-25T17:00:00-03:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-09-25T19:30:00-03:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://astortheatre.ca/genid/d47f147c2982c024"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://astortheatre.ca/event/astor-academy-playwrights-study-circle/"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Astor Academy Playwrights Study Circle"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Are you interet interested in learning about theatre and famous theatre playwrights?  &lt;/p&gt;\\n&lt;p&gt;Join Katherine Schellmer in the Playwrights Study Circle!  A brand new Astor Academy designed for adults.  Meeting on Friday evenings in our Gorham Room, this program will provide a fun, informative learning experience. Katherine has written professionally for theatre, TV, radio, and film.  She was also an educator at The National Theatre School of Canada for three years, running a sessional course entitled “Solo Show” in which she mentored and then directed students performing their own works. &lt;/p&gt;\\n&lt;p&gt;She hopes to use her experience/knowledge to invigorate the theatre community in Queens County.&lt;/p&gt;\\n&lt;p&gt;In this program, the group study a specific playwright, as well as the time period the play was written in; world events, cultural events, the forces that shaped the creation of the work, and the&lt;br /&gt;\\nreaction to the work when it premiered.&lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@value": "Organization"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
