    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Beyond The First Glance Kristal D'Amato Art Show | Astor Theatre & Arts Centre"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The Astor is excited to welcome Kristal D'Amato Art Show - Beyond The First Glance in our Upstairs Gallery for the month of October.   The camera often reveals details that disappear when we take in scenes all at once: the textures worn into driftwood by the tide, the glow of light across a shell, the reflections hidden in still water, or the unexpected arrangement of ordinary objects. These small discoveries have become the starting point for much of my work. Curiosity leads to every piece I create. Sometimes it ends with a photograph. Sometimes that photograph becomes something entirely new - a mandala that uncovers patterns hidden within nature, or a watercolour interpretation that explores the same scene through softness, colour and emotion. Each transformation asks the same question: What else is hidden here?"
      }
    ],
    "https://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://astortheatre.ca/event/beyond-the-first-glance-kristal-damato-art-show/2026-10-07/"
      }
    ],
    "https://ogp.me/ns#site_name": [
