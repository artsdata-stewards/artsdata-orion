    "http://schema.org/name": [
      {
        "@value": "Seniors Creating an Astor Academy Program"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;eniors Creating is a brand new Astor Academy program for seniors.  We will be offering free art workshops with professional artists to allow seniors to engage in the arts while connecting with other seniors in our community.  Each month we will have a new workshop series.&lt;/p&gt;\\n&lt;p&gt;Art supplies, tea, coffee and snacks will be provided.  &lt;/p&gt;\\n&lt;p&gt;We are excited to be starting off with a 4 week painting session with Beth Lenco.  &lt;/p&gt;\\n"
      }
    ],
