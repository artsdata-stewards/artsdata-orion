    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Curtain Call Academy JR Camp Production | Astor Theatre & Arts Centre"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Lincoln is a FAN FAVOURITE at the Astor Academy, holding successful Theatre Camps since 2019. His ORIGINAL Curtian Call Academy Camp is now in its 8th year. This year, he is bringing this awesome camp experience to the next generation in Curtain Call Academy JR! Lincoln puts his spin on the decades-long Astor Theatre Camp tradition. In this one-of-a-kind program, Lincoln & his campers have developed an original play from start to finish, learning plenty of theatre skills along the way! They want you to come and see what they have created in this hilarious theatrical production that takes a creative spin on characters you know and love."
      }
    ],
    "https://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://astortheatre.ca/event/curtain-call-academy-jr-camp-production/"
