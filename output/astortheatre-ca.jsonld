    "http://schema.org/name": [
      {
        "@value": "Astor Academy Animation Club"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Calling all kids aged 7 to 13!&lt;/p&gt;\\n&lt;p&gt;Have you ever wanted to make your own animated movies?&lt;/p&gt;\\n&lt;p&gt;Stop-Motion Club started in 2024 by Desmond Smyth, a local high school student who had an interest in Stop-Motion when he was younger and wanted to teach the younger generation about this animation form.&lt;/p&gt;\\n&lt;p&gt;Our club has expanded, not only teaching stop-motion animation but 2D frame-by-frame hand-drawn-style animation, green screen animation, and frame-by-frame pivot-stick-figure-style techniques all using your cellphone or tablet. &lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@value": "Organization"
      }
    ],
