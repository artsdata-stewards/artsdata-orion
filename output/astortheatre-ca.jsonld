  {
    "@id": "https://astortheatre.ca/genid/b6ea9edac3fa6c8a",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/image": [
      {
        "@id": "https://astortheatre.ca/wp-content/uploads/2026/11/MV5BN2JjOGQ1OGMtZmUwYS00YmQ2LTllNzQtZjU2YjY1NzM2NzJjXkEyXkFqcGc@._V1_.webp"
      }
