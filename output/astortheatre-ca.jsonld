      }
    ],
    "http://schema.org/name": [
      {
        "@value": "September Big Stage Open Mic Night"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Big Stage Open Mics are BACK at the Astor on Saturday, September 26!<br />\\nJoin us for a fantastic evening featuring local community talent.<br />\\nWe have missed you on our stage!<br />\\nYou can sing, dance, tell jokes, read a poem, play the piano – you have a talent- we want to see it!<br />\\nYou can sign up the night of the event at 6 p.m. at our Box Office<br />\\nJust want to watch? No problem, this is a free, all-ages event. Come on out and support local talent in our community!<br />\\nThis event is free for all ages. We will be collecting donations at the door to help us continue offering events like this one to our community.<br />\\nOur Astor bar and concessions will be open</p>\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@value": "Organization"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
