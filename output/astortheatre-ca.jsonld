        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
  {
    "@id": "https://astortheatre.ca/genid/dd55b98ccb8ad640",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/image": [
      {
        "@id": "https://astortheatre.ca/wp-content/uploads/2026/09/WOC-Marriage-Monologues-.webp"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://astortheatre.ca/event/the-marriage-monologues-presented-by-the-winds-of-change-dramatic-society/2026-11-28/"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-28T19:00:00-04:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-28T21:00:00-04:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://astortheatre.ca/genid/d47f147c2982c024"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://astortheatre.ca/events/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Marriage Monologues Presented by the Winds of Change Dramatic Society"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Experience this inaugural performance of The Marriage Monologues, an original play created from the synthesis of 100 conversations about love, marriage, divorce, romance and everything in between!</p>\\n<p>Featuring a compelling original script, The Marriage Monologues explores themes of love, loss, tragedy, hope and joy in the context of the romantic relationships that shape our lives. This series of monologues are at times poignant, at times funny, sometimes disturbing yet thoroughly entertaining and relatable. A diverse cast of veteran and brand-new performers share individual narratives created from a composite of 100 stories collected by writer Libby Broadbent over the course of more than a year.</p>\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": "Organization"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
