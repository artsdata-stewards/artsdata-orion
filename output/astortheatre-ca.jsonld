      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://astortheatre.ca/event/seaniors-creating-carding-workshop-facilitated-by-janice-macmillan/2026-11-10/"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-10T11:00:00-04:00"
      }
    ],
