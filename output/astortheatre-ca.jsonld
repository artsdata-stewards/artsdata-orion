      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "HADESTOWN: THE MUSICAL"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>The live theater capture of the hit musical Hadestown, which won eight Tony Awards in 2019 including Best Musical and the 2020 Grammy Award for Best Musical Theater Album, featuring the five original principals of the Broadway company. The genre-defying new musical blends modern American folk music with New Orleans-inspired jazz to reimagine a sweeping ancient tale. Following two intertwining love stories — that of young dreamers Orpheus and Eurydice, and that of King Hades and his wife Persephone — Hadestown invites audiences on a hell-raising journey to the underworld and back.</p>\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": "Organization"
      }
    ],
