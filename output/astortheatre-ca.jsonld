    "http://schema.org/name": [
      {
        "@value": "Seniors Connecting An Astor Academy Program"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;Seniors Connecting was created in 2021 and facilitated by Sandi Atkinson. &lt;/p&gt;\\n&lt;p&gt;Seniors meet weekly for a time of connection and enjoy coffee, tea and snacks together.  Each week, they sing, dance, and do crafts.  They even performed a Christmas Radio Play that aired on QCCR two years running. &lt;/p&gt;\\n&lt;p&gt;This year we are excited to have Sandi co-leading with Sheree Cee and we look forward to seeing of the things that they do this year.   &lt;/p&gt;\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@value": "Organization"
      }
