        "@id": "https://astortheatre.ca/wp-content/uploads/2026/10/SAS-Glass-Adult-Workshop-11-x-17-in-1.webp"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://astortheatre.ca/event/sas-glass-stained-glass-xmas-ornaments-workshop/2026-11-12/"
      }
    ],
    "http://schema.org/startDate": [
