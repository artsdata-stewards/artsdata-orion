      {
        "@value": "Joshua Slauenwhite Everything Artsy Art Show"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "&lt;p&gt;The Astor Theatre is welcoming abstract artist Joshua Slauenwhite to our upper gallery for the month of September. Joshua is an amature artist who is branching outside of his comfort zone to display his unique collection of handcrafted items. Be sure to stop by, sign our guest book and see what this new local artist has to offer. &lt;/p&gt;\\n"
      }
    ],
