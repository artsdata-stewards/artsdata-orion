    "http://schema.org/name": [
      {
        "@value": "Bee Gees Revisited"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>VaughnCo Entertainment is proud to present the most outstanding Bee Gees Tribute show. Bee Gees Revisited is the ultimate tribute to the Bee Gees. Come and experience the sound, the harmonies, and the beautiful falsetto voices of the brothers Gibb. Performing with a full band the show recreates the Bee Gees 1998 Las Vegas appearance live.</p>\\n"
      }
    ],
