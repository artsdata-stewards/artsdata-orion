    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Seniors Connecting An Astor Academy Program"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Seniors Connecting was created in 2021 and facilitated by Sandi Atkinson. </p>\\n<p>Seniors meet weekly for a time of connection and enjoy coffee, tea and snacks together.  Each week, they sing, dance, and do crafts.  They even performed a Christmas Radio Play that aired on QCCR two years running. </p>\\n<p>This year we are excited to have Sandi co-leading with Sheree Cee and we look forward to seeing of the things that they do this year.   </p>\\n"
      }
    ],
