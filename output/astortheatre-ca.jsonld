    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Wuthering Heights"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Emerald Fennell’s 2026 adaptation of Wuthering Heights is a gritty, R-rated retelling focusing on the intense, destructive, and often violent love between Heathcliff (Jacob Elordi) and Catherine Earnshaw (Margot Robbie). The story follows their childhood bond as outcasts on the Yorkshire moors, leading to a tragic, obsessive, and revenge-fueled relationship as adults after Catherine marries a wealthier man.</p>\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": "Organization"
      }
