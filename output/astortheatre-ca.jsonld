    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Each participant will fabricate at least 4 stained-glass Xmas ornaments by fusing or kiln carving. Activity: pick out glass, frit, cut and grind glass, cut paper and design kiln-carved and fused Xmas decorations. Finished results ready for pickup the next day after firing at SAS Glass"
      }
    ],
    "https://ogp.me/ns#url": [
