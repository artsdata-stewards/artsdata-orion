    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Tale of Tea & Thyme"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Step into a world of \"reverie”, mystery and music! When a group of troubled teenage girls—including a fashionista, a lonely wallflower, and a fame-weary pop star—arrive at Camp Steeped, they expect a typical therapeutic camp. Instead, a sip of \"super-steeped\" tea, transports them to Nocturne Grove, a surreal realm where magic is banned and an eccentric, evil Queen uses mind-control to dominate her subjects. </p>\\n"
      }
    ],
