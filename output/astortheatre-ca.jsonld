    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Masters of the Universe (2026)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>After being separated for 15 years, the Sword of Power leads Prince Adam (Nicholas Galitzine) back to Eternia where he discovers his home shattered under the fiendish rule of Skeletor (Jared Leto). To save his family and his world, Adam must join forces with his closest allies, Teela (Camila Mendes) and Duncan/Man-At-Arms (Idris Elba), and embrace his true destiny as He-Man -- the most powerful man in the universe.</p>\\n"
      }
    ],
