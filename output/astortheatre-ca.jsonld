    "http://schema.org/name": [
      {
        "@value": "The Grand Tour"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Experience the soulful voices of George Jones, Johnny Cash, Conway Twitty, Jim Reeves, Charley Pride and much more, brought to life with fresh energy and passion. These talented musicians will have you remembering the days when you would sing along to the radio or sitting at the Grand Ole Opry!  Don\\'t miss this nostalgic celebration of country music\\'s rich heritage!</p>\\n"
      }
