      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://astortheatre.ca/event/the-marriage-monologues-presented-by-the-winds-of-change-dramatic-society/2026-11-27/"
      }
    ],
    "http://schema.org/startDate": [
