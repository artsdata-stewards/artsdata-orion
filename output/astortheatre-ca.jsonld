    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>A memorable evening of John Prine\\'s finest songs & stories, performed by eight seasoned veteran songwriter/musicians\\' and friends\\', who are lifelong fans of John Prine. A show that includes a multimedia layer of captivating still pics.</p>\\n"
      }
