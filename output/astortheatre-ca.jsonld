    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Shark Week: Jaws: 50th (ish) Anniversary | Astor Theatre & Arts Centre"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "When a gigantic great white shark begins to menace the small island community of Amity, a police chief, a marine scientist and grizzled fisherman set out to stop it. Jaws is considered one of the greatest films of all time and often credited as being the first summer blockbuster. Steven Spielberg's breakthrough movie, it solidified his relationship with Universal, won three Academy Awards®, spawned three sequels, two video games, two musicals, two theme park rides and ranks as one of the top-grossing films in Universal history."
      }
    ],
    "https://ogp.me/ns#url": [
      {
        "@language": "en-us",
