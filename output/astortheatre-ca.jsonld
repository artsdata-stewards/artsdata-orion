      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Seniors Connecting was created in 2021 and facilitated by Sandi Atkinson.  Seniors meet weekly for a time of connection and enjoy coffee, tea and snacks together.  Each week, they sing, dance, and do crafts.  They even performed a Christmas Radio Play that aired on QCCR two years running.  This year we are excited to have Sandi co-leading with Sheree Cee and we look forward to seeing of the things that they do this year.   "
      }
    ],
    "https://ogp.me/ns#url": [
