    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>The Astor Theatre is welcoming abstract artist Joshua Slauenwhite to our upper gallery for the month of September. Joshua is an amature artist who is branching outside of his comfort zone to display his unique collection of handcrafted items. Be sure to stop by, sign our guest book and see what this new local artist has to offer. </p>\\n"
      }
