    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>discover herself, her own strengths, and her own power. Alongside Shrek, Donkey, and a cast of both new and familiar characters, she learns that her story belongs to her.</p>\\n"
      }
    ],
