  {
    "@id": "https://astortheatre.ca/event/little-lorriane/2026-05-27/",
    "https://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "https://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Little Lorraine | Astor Theatre & Arts Centre"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "In a remote corner of the North Atlantic, a group of friends fall down on their luck after their coal mining jobs dissolve due to a majorfire. In a moment of questionable good luck, they get hired by our hero’s uncle to come work on his lobster boat. With money in their pockets and food on the table, the monotony of pulling up lobster pots turns upside down when the catch turns from lobster to bricks of hash, and later, kilos of cocaine. Soon, relationships get tested by outsiders and each other after an anonymous tip to Federal Agents brings an undercover officer to the otherwise sleepy town. The friends have todecide whether to stay the course or run for their lives before the paranoid and suspicious Uncle Huey turns from ship’s captain to undertaker."
      }
    ],
    "https://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://astortheatre.ca/event/little-lorriane/2026-05-27/1/"
      }
    ],
    "https://ogp.me/ns#site_name": [
      {
        "@language": "en-us",
        "@value": "Astor Theatre & Arts Centre"
      }
    ],
    "https://ogp.me/ns#updated_time": [
