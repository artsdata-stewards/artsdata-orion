      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Seaniors Creating Carding Workshop Facilitated by Janice MacMillan"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Enjoy a 3 week class where you will learn the basics of carding with Janice MacMillan from Sir Earl Photography.<br />\\nShe started her company because photography helped her cope with her Chronic Pain.<br />\\nThe cards you will make for this classes have flowers that have raindrops on their petals,<br />\\nyou will customize your cards using a photo that has a meaning to you. Carding is something that you can enjoy for years after this class. The cards you make in this workshop can be gifted to your friends & family.</p>\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@value": "Organization"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
