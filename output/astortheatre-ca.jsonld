  {
    "@id": "https://astortheatre.ca/event/andrew-morrisey-camp-production/",
    "https://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "https://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Andrew Morrisey Camp Production | Astor Theatre & Arts Centre"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Andrew is a NY-based actor and teacher, originally from Truro, and has been running his camps in theatres around NS for the last 17 summers! Andrew is a Music Theatre graduate of several programs, including Circle in the Square Theatre School’s Acting program in NYC -the only accredited training attached to a Broadway theatre. As a teacher, he has worked with voice students who have performed in regional theatres across the US, on national tours, and on Broadway.  Andrew has worked hard with this campers this week to perform selections from a few musicals, but we are keeping it under our hats to which ones :)  Come and see how amazing our Astor Academy Youth are and how much they have learned in one week!  "
      }
    ],
    "https://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://astortheatre.ca/event/andrew-morrisey-camp-production/"
