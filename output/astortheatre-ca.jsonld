    "@id": "https://astortheatre.ca/event/the-marriage-monologues-presented-by-the-winds-of-change-dramatic-society/2026-11-27/",
    "https://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "https://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "The Marriage Monologues Presented by the Winds of Change Dramatic Society | Astor Theatre & Arts Centre"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Experience this inaugural performance of The Marriage Monologues, an original play created from the synthesis of 100 conversations about love, marriage, divorce, romance and everything in between! Featuring a compelling original script, The Marriage Monologues explores themes of love, loss, tragedy, hope and joy in the context of the romantic relationships that shape our lives. This series of monologues are at times poignant, at times funny, sometimes disturbing yet thoroughly entertaining and relatable. A diverse cast of veteran and brand-new performers share individual narratives created from a composite of 100 stories collected by writer Libby Broadbent over the course of more than a year."
      }
    ],
    "https://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://astortheatre.ca/event/the-marriage-monologues-presented-by-the-winds-of-change-dramatic-society/2026-11-27/"
