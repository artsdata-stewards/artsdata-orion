    "@id": "https://astortheatre.ca/event/run-terry-run/",
    "https://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "https://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Run Terry Run | Astor Theatre & Arts Centre"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "RUN TERRY RUN delivers an intimate, entirely archival look at Terry Fox's legendary 1980 Marathon of Hope. Utilizing over 90 restored reels of long-lost 16mm raw footage and pristine, untouched audio tapes, the documentary foregoes modern \"talking head\" interviews. Instead, it uses real-time dialogue from Terry, his brother Darrell, and friend Doug Alward to reveal the true gritty determination and deeply human side of the 21-year-old Canadian icon as he united a nation."
      }
    ],
    "https://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://astortheatre.ca/event/run-terry-run/"
      }
    ],
