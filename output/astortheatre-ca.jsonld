    "http://schema.org/name": [
      {
        "@value": "Life Drawing an Astor Academy Program"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Life Drawing was started by Roger Savage. Weekly studio sessions provide the opportunity for lay and professional visual artists of our region to practice and improve their drawing and observation skills. Participants are from communities along the South Shore. This program costs $20 per session to provide payment to the models used in the drawing sessions. </p>\\n"
      }
    ],
