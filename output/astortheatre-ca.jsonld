    "http://schema.org/name": [
      {
        "@value": "Forgotten Island"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Your best friendship is worth fighting for. DreamWorks Animation, the studio that brought you unforgettable bonds between a boy and a dragon in How to Train Your Dragon, an ogre and a donkey in Shrek, and a robot and a gosling in The Wild Robot, now welcomes a dazzling and emotional story about two lifelong best friends who must come together before they drift apart in Forgotten Island.</p>\\n"
      }
    ],
