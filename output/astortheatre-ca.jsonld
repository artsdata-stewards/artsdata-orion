    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Harry Potter and the Sorcerer’s Stone – 25th Anniversary"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>It’s Back to Hogwarts season and, as we celebrate the 25th Anniversary of the first film, this year is extra special. You’re invited to return to Harry Potter and the Philosopher’s Stone at the Astor, with 12 minutes of never-before-seen behind-the-scenes footage debuting on the big screen.</p>\\n"
      }
