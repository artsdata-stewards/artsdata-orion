      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "A 1952 New York City shoe salesman and relentless table tennis hustler who schemes, charms, and gambles his way from the Lower East Side to international championships. Driven by extreme ego and self-absorption, he scams his way into high-stakes matches while juggling an affair with a married woman, Rachel, and manipulating elite figures like Kay Stone."
      }
    ],
    "https://ogp.me/ns#url": [
