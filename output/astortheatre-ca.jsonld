        "@id": "https://astortheatre.ca/wp-content/uploads/2026/10/OG-Forgotten-Island-poster.webp"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://astortheatre.ca/event/forgotten-island-2/2026-11-14/1/"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-14T11:00:00-04:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-14T13:00:00-04:00"
      }
    ],
    "http://schema.org/location": [
      {
