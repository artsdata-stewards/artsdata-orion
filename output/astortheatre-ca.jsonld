    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "In celebration of 30 years of Queens County, The Stanfields are coming to the Astor Stage! The Stanfields are a multiple award-winning six-piece Folk'n'Roll band based in Halifax, Canada. Combining Rock music with solid nods to Celtic and Americana, they play what they want, sing what they feel, and leave nothing on the table."
      }
    ],
    "https://ogp.me/ns#url": [
