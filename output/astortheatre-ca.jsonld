    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Wicked: For Good"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Now demonized as the Wicked Witch of the West, Elphaba lives in exile in the Ozian forest, while Glinda resides at the palace in Emerald City, reveling in the perks of fame and popularity. As an angry mob rises against the Wicked Witch, she\\'ll need to reunite with Glinda to transform herself, and all of Oz, for good.</p>\\n"
      }
