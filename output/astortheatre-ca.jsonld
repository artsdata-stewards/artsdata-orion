    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Spider-Man: Brand New Day"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>It\\'s a BRAND NEW DAY for Peter Parker. Fighting crime full-time as Spider-Man in a world that doesn’t remember him -- and the pressure of seeing his old friends move on without him -- sparks a change in Peter he may not have the power to control. But that transformation might also be the only thing that can stop a shocking new threat to the city and those he loves - a powerful villain no one can even see. The world may have forgotten Peter Parker, but he hasn’t forgotten them.</p>\\n"
      }
    ],
    "http://schema.org/performer": [
