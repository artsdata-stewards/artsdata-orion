    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Run Terry Run"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>RUN TERRY RUN delivers an intimate, entirely archival look at Terry Fox\\'s legendary 1980 Marathon of Hope. Utilizing over 90 restored reels of long-lost 16mm raw footage and pristine, untouched audio tapes, the documentary foregoes modern \"talking head\" interviews. Instead, it uses real-time dialogue from Terry, his brother Darrell, and friend Doug Alward to reveal the true gritty determination and deeply human side of the 21-year-old Canadian icon as he united a nation.</p>\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "en",
        "@value": "Organization"
      }
    ],
