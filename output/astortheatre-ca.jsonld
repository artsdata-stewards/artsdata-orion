  {
    "@id": "https://astortheatre.ca/event/los-desperados-canadas-premier-tribute-to-the-eagles/",
    "https://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "https://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Los Desperados, Canada's Premier Tribute to The EAGLES | Astor Theatre & Arts Centre"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Get ready for an Unforgettable Evening as Los Desperados, Canada's Premier Tribute to The EAGLES take the stage. LOS DESPERADOS Formed in 2021, Los Desperados have quickly become known as Canada's Premier Tribute To The EAGLES for their impeccable musicianship, rich harmonies, and authentic renditions of Eagles classics. This powerhouse six-piece lineup includes Cory Maxam (lead vocals/guitar), Izzy Martinez (guitar/vocals), Gabor 'Gabe' Obert (guitar/keys/vocals), Michael Paterson (keyboards), Ed Lauzon (bass/vocals), and Chris Houle (drums). Together, they recreate the magic of the Eagles with stunning precision and heart. Playing All Their Greatest like Hotel California, Take It Easy, Desperado, Lyin' Eyes, and Life in the Fast Lane performed with the lush harmonies and guitar work that made the Eagles legendary. Every note is delivered with deep respect for the originals, creating a live experience that feels both nostalgic and fresh. Los Desperados Canada's Eagles Show— a must-see celebration of The Eagles."
      }
    ],
    "https://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://astortheatre.ca/event/los-desperados-canadas-premier-tribute-to-the-eagles/"
