      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "SHAUN THE SHEEP: THE BEAST OF MOSSY BOTTOM sees the residents of Mossy Bottom Farm looking forward to Halloween -- until the clumsy Farmer trashes the Flock's beloved pumpkin patch! When Shaun turns MAD SCIENTIST to fix the problem, things rapidly spiral out of control... With The Farmer missing and a wild beast roaming the woods of Mossingham, all the ingredients are in place for a monstrously fun family adventure."
      }
    ],
    "https://ogp.me/ns#url": [
