      {
        "@value": "Watercolor Mushroom Workshop with local artist Kalen Roblee"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Explore your creative side and learn to paint an Amanita mushroom! </p>\\n<p>Join local artist Kalen Roblee on Saturday, November 14 at the Astor Theatre & Arts Centre for a relaxed, beginner-friendly watercolor workshop. </p>\\n<p>All materials are provided!<br />\\n16+</p>\\n"
      }
