    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "One Battle After Another | Astor Theatre & Arts Centre"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Bob is a washed-up revolutionary who lives in a state of stoned paranoia, surviving off-grid with his spirited and self-reliant daughter, Willa. When his evil nemesis resurfaces, and Willa goes missing, the former radical scrambles to find her as both father and daughter battle the consequences of their pasts."
      }
    ],
    "https://ogp.me/ns#url": [
      {
        "@language": "en-us",
