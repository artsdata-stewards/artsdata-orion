      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://astortheatre.ca/event/met-tuesday-twenty-years-of-the-met-in-cinemas-an-anniversary-celebration/"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Twenty Years of the Met in Cinemas: An Anniversary Celebration"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Twenty Years of the Met in Cinemas is a celebration of the Met’s two decades of onstage glory as experienced in movie theatres, featuring highlights from the company’s collection of more than 185 extraordinary onscreen performances.</p>\\n<p>Hosted by star soprano Renée Fleming, this special presentation will showcase unforgettable moments from some of opera’s greatest stars, culled from the series’ vast archive of transmissions, featuring such remarkable artists as Lise Davidsen, Natalie Dessay, Joyce DiDonato, Elīna Garanča, Dmitri Hvorostovsky, Jonas Kaufmann, Peter Mattei, Matthew Polenzani, Nadine Sierra, and, of course, Fleming herself.</p>\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@value": "Organization"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
