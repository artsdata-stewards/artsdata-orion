    "http://schema.org/name": [
      {
        "@value": "“Hello Again” featuring the music of Neil Diamond with Sean Andrews"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>A life story told through the music of Neil Diamond<br />\\nBoardwalk Productions is excited to bring Sean Andrews in \"Hello Again\" featuring the music of Neil Diamond, to the Astor Theatre for an unforgettable evening of story, song, and nostalgia. This powerful musical experience has played to sold-out audiences, earning standing ovations and glowing reviews wherever it appears.</p>\\n"
      }
    ],
