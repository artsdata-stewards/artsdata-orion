      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "E.T. the Extra-Terrestrial (1982), directed by Steven Spielberg, tells the story of a lonely 10-year-old boy named Elliott who befriends a gentle alien stranded on Earth. Elliott, his older brother Michael, and little sister Gertie hide the extraterrestrial in their suburban home, forming a deep emotional and telepathic bond with him."
      }
    ],
