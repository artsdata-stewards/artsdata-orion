    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "The Grand Tour | Astor Theatre & Arts Centre"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "THE GRAND TOUR is a timeless journey through classic country music! Join us for electrifying performances of hits from the 50's, 60's, 70's, and 80's. Experience the soulful voices of George Jones, Johnny Cash, Conway Twitty, Jim Reeves, Charley Pride and much more, brought to life with fresh energy and passion. These talented musicians will have you remembering the days when you would sing along to the radio or sitting at the Grand Ole Opry! Don't miss this nostalgic celebration of country music's rich heritage!"
      }
    ],
    "https://ogp.me/ns#url": [
      {
        "@language": "en-us",
