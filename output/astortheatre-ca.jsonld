      }
    ],
    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Seaniors Creating Carding Workshop Facilitated by Janice MacMillan | Astor Theatre & Arts Centre"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Enjoy a 3 week class where you will learn the basics of carding with Janice MacMillan from Sir Earl Photography. She started her company because photography helped her cope with her Chronic Pain. The cards you will make for this classes have flowers that have raindrops on their petals, you will customize your cards using a photo that has a meaning to you. Carding is something that you can enjoy for years after this class. The cards you make in this workshop can be gifted to your friends & family."
      }
    ],
    "https://ogp.me/ns#url": [
