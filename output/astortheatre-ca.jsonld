      {
        "@value": "TULUA"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>TULUA are a young traditional Irish band hailing from the southeast of Ireland. Meaning \"tribe of many paths\" TULUA have been deeply exploring and sharing music of their local area and other parts of Ireland, bringing the audience with them on a captivating journey of songs about love, tunes about life and everything in between.</p>\\n"
      }
    ],
