    "http://schema.org/name": [
      {
        "@value": "Holiday Foam Clay Workshop with Teresa McLaughlin"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>In this workshop we will focus on Holiday themed decor.<br />\\nEach participant will be guided through creating both of these original , seasonal style ornaments  from odourless, non toxic air dry foam clay.<br />\\nAll materials will be provided and workshop artists will be able to take home a selection of completed pieces.</p>\\n"
      }
