  {
    "@id": "https://astortheatre.ca/genid/9683ac34e4a1b5b1",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/image": [
      {
        "@id": "https://astortheatre.ca/wp-content/uploads/2026/10/Kristal-DAmato-11-x-17-in.webp"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://astortheatre.ca/event/beyond-the-first-glance-kristal-damato-art-show/2026-10-21/"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-10-21T11:00:00-03:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-10-21T16:00:00-03:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://astortheatre.ca/genid/d47f147c2982c024"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://astortheatre.ca/event/beyond-the-first-glance-kristal-damato-art-show/2026-10-21/"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Beyond The First Glance Kristal D’Amato Art Show"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>The Astor is excited to welcome Kristal D\\'Amato Art Show - Beyond The First Glance in our Upstairs Gallery for the month of October.  </p>\\n<p>The camera often reveals details that disappear when we take in scenes all at once: the textures worn into driftwood by the tide, the glow of light across a shell, the reflections hidden in still water, or the unexpected arrangement of ordinary objects. These small discoveries have become the starting point for much of my work.</p>\\n<p>Curiosity leads to every piece I create. Sometimes it ends with a photograph. Sometimes that photograph becomes something entirely new - a mandala that uncovers patterns hidden within nature, or a watercolour interpretation that explores the same scene through softness, colour and emotion. Each transformation asks the same question: What else is hidden here?</p>\\n"
      }
    ],
    "http://schema.org/performer": [
      {
        "@value": "Organization"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
