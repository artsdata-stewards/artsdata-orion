      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Richard Eyre’s beloved production of Bizet’s masterpiece returns to theaters, led by mezzo-soprano Elina Garanca as the title character and tenor Roberto Alagna as Don José in the indelible 2010 Met performance—a fan favorite of The Met: Live in HD series. Yannick Nézet-Séguin conducts in his company-debut season."
      }
    ],
    "https://ogp.me/ns#url": [
