    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Curtain Call Academy JR Camp Production"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Lincoln is a FAN FAVOURITE at the Astor Academy, holding successful Theatre Camps since 2019.<br />\\nHis ORIGINAL Curtian Call Academy Camp is now in its 8th year.<br />\\nThis year, he is bringing this awesome camp experience to the next generation in Curtain Call Academy JR!<br />\\nLincoln puts his spin on the decades-long Astor Theatre Camp tradition. In this one-of-a-kind program, Lincoln & his campers have developed an original play from start to finish, learning plenty of theatre skills along the way!<br />\\nThey want you to come and see what they have created in this hilarious theatrical production that takes a creative spin on characters you know and love.</p>\\n"
      }
    ],
