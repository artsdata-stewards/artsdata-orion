    "http://schema.org/name": [
      {
        "@value": "Care for All – North American Premiere"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Experience the North American premiere of Care for All, an acclaimed new Welsh musical that tells the inspiring story of the people who believed healthcare should be available to everyone.</p>\\n<p>Featuring powerful original music and compelling storytelling, Care for All explores themes of compassion, community, sacrifice, and hope that continue to resonate today.</p>\\n"
      }
    ],
