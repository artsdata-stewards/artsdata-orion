    "http://schema.org/name": [
      {
        "@value": "Beyond The First Glance Kristal D’Amato Art Show"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Curiosity leads to every piece I create. Sometimes it ends with a photograph. Sometimes that photograph becomes something entirely new - a mandala that uncovers patterns hidden within nature, or a watercolour interpretation that explores the same scene through softness, colour and emotion. Each transformation asks the same question: What else is hidden here. </p>\\n"
      }
