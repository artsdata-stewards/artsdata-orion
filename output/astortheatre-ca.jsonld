  {
    "@id": "https://astortheatre.ca/event/hadestown-the-musical/2026-08-25/",
    "https://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "https://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "HADESTOWN: THE MUSICAL | Astor Theatre & Arts Centre"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The live theater capture of the hit musical Hadestown, which won eight Tony Awards in 2019 including Best Musical and the 2020 Grammy Award for Best Musical Theater Album, featuring the five original principals of the Broadway company. The genre-defying new musical blends modern American folk music with New Orleans-inspired jazz to reimagine a sweeping ancient tale. Following two intertwining love stories — that of young dreamers Orpheus and Eurydice, and that of King Hades and his wife Persephone — Hadestown invites audiences on a hell-raising journey to the underworld and back."
      }
    ],
    "https://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://astortheatre.ca/event/hadestown-the-musical/2026-08-25/1/"
      }
    ],
    "https://ogp.me/ns#site_name": [
      {
        "@language": "en-us",
        "@value": "Astor Theatre & Arts Centre"
      }
    ],
    "https://ogp.me/ns#updated_time": [
