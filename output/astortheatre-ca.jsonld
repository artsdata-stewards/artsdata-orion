      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Emerald Fennell’s 2026 adaptation of Wuthering Heights is a gritty, R-rated retelling focusing on the intense, destructive, and often violent love between Heathcliff (Jacob Elordi) and Catherine Earnshaw (Margot Robbie). The story follows their childhood bond as outcasts on the Yorkshire moors, leading to a tragic, obsessive, and revenge-fueled relationship as adults after Catherine marries a wealthier man."
      }
    ],
    "https://ogp.me/ns#url": [
      {
