    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Disclosure Day"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>If you found out we weren’t alone, if someone showed you, proved it to you, would that frighten you? This summer, the truth belongs to seven billion people. We are coming close to … Disclosure Day.</p>\\n"
      }
    ],
