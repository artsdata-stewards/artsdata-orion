    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "February Big Stage Open Mic Night"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Our next Big Stage Open Mic Night will feature a special guest host, Nicole Whynot! A fantastic evening featuring local community talent.</p>\\n<p>You can sing, dance, tell jokes, read a poem, play the piano - you have a talent- we want to see it!<br />\\nYou can sign up the night of the event at 6 p.m. at our Box Office<br />\\nJust want to watch? No problem, this is a free, all-ages event. Come on out and support local talent in our community!</p>\\n"
      }
    ],
