      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Fresh off the worldwide blockbuster success of summer 2024’s funniest comedy, Despicable Me 4, Illumination expands its joyful animated universe with a riotous new chapter, featuring all-new characters, in the biggest global animated franchise in history: Minions & Monsters. This is the rambunctious, ridiculous and totally true story of how the Minions conquered Hollywood, became movie stars, lost everything, unleashed monsters onto the world and then banded together to try and save the planet from the mayhem they had just created."
      }
    ],
    "https://ogp.me/ns#url": [
