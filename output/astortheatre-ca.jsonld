    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Experience the North American premiere of Care for All, an acclaimed new Welsh musical that tells the inspiring story of the people who believed healthcare should be available to everyone. Featuring powerful original music and compelling storytelling, Care for All explores themes of compassion, community, sacrifice, and hope that continue to resonate today."
      }
