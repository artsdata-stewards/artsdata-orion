    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>Bugonia is a dark sci-fi comedy about two conspiracy-obsessed men who kidnap a powerful pharmaceutical CEO, Michelle Fuller (Emma Stone), believing she\\'s an alien orchestrating humanity\\'s destruction, leading to a twisted, darkly funny power struggle filled with shocking twists, self-sacrifice, and philosophical questions about truth and belief, culminating in a cosmic revelation about Earth\\'s fate.</p>\\n"
      }
