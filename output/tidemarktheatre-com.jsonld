        "@language": "en",
        "@value": "\n\n\t\t\n\t\n\t\t\t\t\t\t\n\t\t\n\n\t\t\t\n\t\n\t\n\t\t\n\t\n\t\t\t\t\t\n\n\n\n\n\t\t\t\t\t\n\t\n\t\n\n\n\n\t\n\t\t\n\t\n\n\n\t\n\t\t\t\t\t\t\n\t\t\n\n\t\t\t\n\t\n\n\t\t\t\n\t\n\t\n\t\t\n\tNovember 24 @ 7:00 pm\n\n\t\n\n\n\t\n\t\t\n\n\t Venue \n\t\n\t\t\t\t Tidemark Theatre \n\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t\t\t\n\n1220 Shoppers Row\n\t\n\t\t\n\t\tCampbell River,\n\n\tBC\n\n\tV9W 2C8\n\n\tCanada\n\n\n\n\t\t\t\t\t\t\t\t\t\t\t\t\t+ Google Map\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\n\t\t\t\n\t\t\t\n\t\t\t\t\t\n\t\t\t\n\n\t\n\n\n\n\t\t\t\n\t\n\t\n\t\t\n\t$20.00\n\n\t\n\n\n\t\n\t\tBuy Tickets\t\n\n\n\t\n\t\t\n\t\n\t\t\t\t\t\n\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t\n\t\t\t\n\t\t\t\t\n\t\t\t\n\t\t\t\t\t\t\t\n\t\t\n\t\n\n\t\n\t\t\t\t\t\n\t\t\t\t\t\t\t\t\n\t\t\t\t\tSeating Plan\t\t\t\t\n\t\t\t\n\t\t\t\n\n\t\n\n\n\n\t\n\n\n\t\n\n\n\t\t\t\n\t\n\t\n\t\t\n\t\t\tCRFF Ha-Chan, Shake Your Booty!\n\t\n\t\n\n\n\t\n\t\tHaru (Rinko Kikuchi) and Luis (Alejandro Edda) love competing in Tokyo’s ballroom dance scene, but after a tragedy, Haru withdraws into isolation. When friends coax her back to the studio, she develops an infatuation with the new instructor and must face what comes next as sparks begin to fly.\n122 minutes\nRated R\nJapanese, English, Spanish\nTickets: $20 Admission (+applicable taxes & fees)\n\n\t\n\n\n\n\t\n\t\t\n\t\n\n\n\t\n\t\t\t\t\t\t\n\t\t\n\n\t\t\t\n\t\n\t\n\t\t\n\t\t\tShare this:\n\t\n\t\n\n\n\t\n\t\t\n\t\n\t\t\t\n\t\t\t\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\tShare on Facebook\n\t\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\n\t\t\t\n\t\t\n\t\t\t\n\t\t\t\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\tShare on X\n\t\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\n\t\t\t\n\t\t\n\t\t\t\n\t\t\t\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\tShare on Linkedin\n\t\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\n\t\t\t\n\t\t\n\t\t