    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://quoivivrerimouski.ca/evenements/rimouski/force-dusure"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "À force d&#039;usure"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dans le cadre des RMS 31 en collaboration avec Tour de bras!\n\nFiche technique\nAnnée 2021\nGenre Documentaire\nPays Québec\nLangue Français\nDurée 24 minutes\nRéalisation Antoine Amnotte Dupuis |&nbsp;Bascaille\n\nÀ force d'usure expose le chemin atypique que trois percussionnistes empruntent pour capter des moments sonores improbables. Bain de rouille. Dissolution de flûtes. Sucrage de tambours. Fonte de glaçe. Trempage de bois. Autant de réactions qui agissent à différentes échelles de temps sur la matière. Sur fond de xylo-tourisme, le trio Bascaille déploie son instrumentarium en dégradation.\n\nSuivi d'une prestation musicale et d’une discussion.\n\n&nbsp;\n\n** ATTENTION **\n\nVEUILLEZ ACHETER VOTRE BILLET EN LIGNE GRÂCE AU LIEN SUR CETTE PAGE - LE NOMBRE DE PLACE SERA RÉDUIT POUR DES RAISONS SANITAIRES.\n\nLE PORT DU MASQUE DE PROCÉDURE SERA OBLIGATOIRE PENDANT LA PROJECTION\nMasques en vente sur place"
      }
    ],
