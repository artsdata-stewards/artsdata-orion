      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://quoivivrerimouski.ca/evenements/rimouski/quarantine-playground-ggril"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://quoivivrerimouski.ca/sites/default/files/styles/fiche_d/public/2021-03/Quarantine_playground.png"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://quoivivrerimouski.ca/genid/e46ca4313105a279"
      },
      {
        "@id": "https://quoivivrerimouski.ca/genid/c78e73ea12809388"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://quoivivrerimouski.ca/genid/6951c66636b25605"
      }
    ],
    "http://schema.org/mainEntityOfPage": [
      {
        "@id": "https://quoivivrerimouski.ca/genid/7e6474a608c40368"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://quoivivrerimouski.ca/evenements/rimouski/quarantine-playground-ggril"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Quarantine Playground | GGRIL"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Qu’on se le dise: jouer de la musique sur Zoom, ou bien c'est impossible, ou bien c'est affligeant. Tous s’y sont essayés afin de trouver un sens à la vie de musicien, en ces temps de COVID.&nbsp;\n\n&nbsp;\n\nNe reculant devant rien, l’orchestre rimouskois le GGRIL se spécialise dans le plaisir : afin de contrer l’impossibilité de faire de la musique, ils ont fait appel aux compositeurs Germaine Liu et Joe Sorbara (Toronto), afin de créer une expérience orchestrale interactive qui leur permette de retrouver le plaisir de jouer. Est-ce une pièce de musique? Peut-être, mais c'est surtout une occasion de détourner les codes. Au lieu de tenter de déjouer les limites de la téléprésence et de vouloir faire de la musique ordinaire, la pièce Quarantine Playground utilise ces limites comme terrain de jeu. Pour vos yeux et vos oreilles, cette œuvre interdisciplinaire, présentée en première mondiale, transforme les contraintes en dérogations libératrices pour un moment de bonheur partagé.\n\n&nbsp;\n\nLa création de Quarantine Playground a été rendue possible grâce au soutien du Conseil des Arts et des Lettres du Québec.\n\n&nbsp;\n\nMUSICIEN-NES\nAlexandre Robichaud, trompette\nAlexis Gagnier-Michel, violoncelle\nClarisse Bériault, hautbois\nEmie Lachapelle, saxophones\nÉric Normand, basse\nGermaine Liu, percussions\nIsabelle Clermont, harpe\nJoe Sorbara, percussions\nOlivier D'Amours, guitare électrique\nPatricia Ho-Yi Wang, violon\nRémy Bélanger de Beauport, thérémine\nRobert Bastien, claviers &amp; électroniques\nRobin Servant, accordéon\nSébastien Côrriveau, clarinette basse\nTom Jacques, percussions\n\n&nbsp;"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "PT1H00M"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/MixedEventAttendanceMode"
      }
    ]
  },
