      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://quoivivrerimouski.ca/sites/default/files/styles/fiche_d/public/2019-10/jean_marc_parent.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://quoivivrerimouski.ca/genid/d591e44a93f29aa1"
      },
      {
        "@id": "https://quoivivrerimouski.ca/genid/a29c83d4a3ae8a2c"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://quoivivrerimouski.ca/genid/922c5cccdebe5e1c"
      }
    ],
    "http://schema.org/mainEntityOfPage": [
      {
        "@id": "https://quoivivrerimouski.ca/genid/f28fba4bceb14aea"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://quoivivrerimouski.ca/evenements/rimouski/jean-marc-parent"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Jean-Marc Parent"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "REPORT DU 18 OCTOBRE 2021\n\n&nbsp;\n\n[INFO] Les détenteurs de billets sont invités à les conserver. Soyez assurés que chaque détenteur sera contacté par le personnel de la billetterie afin de connaître les différentes options offertes. Dans le cas d'un report du spectacle, tous les billets seront honorés pour la nouvelle représentation ou remboursés, si cette nouvelle date ne convient pas.&nbsp;\n\n&nbsp;\n\nAvec ses 30 ans de carrière en poche et plus de 300&nbsp;000 billets vendus lors de sa dernière tournée, Jean-Marc Parent est de retour avec un 11e spectacle. L'humoriste nous emmène dans un univers utopique où la vieillesse et la maladie n'existent pas et où un gâteau au chocolat fait maigrir...Dans une ambiance festive, ce conteur inimitable vous fera réaliser que nous nous créons tous de petites utopies quotidiennes. Quelle est la vôtre ?"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "PT1H00M"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/MixedEventAttendanceMode"
      }
    ]
  },
