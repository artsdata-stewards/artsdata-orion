      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://quoivivrerimouski.ca/evenements/rimouski/par-ici-marko-tonich"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://quoivivrerimouski.ca/sites/default/files/styles/fiche_d/public/2021-06/PAR-ICI_fond.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://quoivivrerimouski.ca/genid/335732540d479331"
      },
      {
        "@id": "https://quoivivrerimouski.ca/genid/298c2e590198cf83"
