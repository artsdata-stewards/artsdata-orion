      }
    ],
    "http://schema.org/mainEntityOfPage": [
      {
        "@id": "https://quoivivrerimouski.ca/genid/46079d48e90ad7fd"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://quoivivrerimouski.ca/evenements/rimouski/linda-babin-prend-son-bain"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Linda Babin prend son bain"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Mardi 27 juillet\nDistrict Pointe-au-Père\nDépart du centre communautaire Pointe-au-Père, à 18 h\n\nJeudi 29 juillet\nDistrict Saint-Robert\nDépart du centre communautaire Saint-Robert, à 18 h\n\nQuand Linda Babin prend son bain, ça éclabousse de tous bords! Avec son maillot et son casque de bain, elle ne passe pas inaperçue à bord de son bain roulant qui déambule de ruelles en trottoirs! Et si son savon lui glisse des mains, elle est bien gênée d'aller le récupérer... gênée? Juste au début alors, car dès que le rideau de douche s'ouvre, elle se livre à tout un tas d'exubérances hilarantes, pour le plus grand plaisir des spectateurs! Une animation humoristique pour toute la famille.\n\nSurveillez, il est possible que cette animation surprise déambule sur les trottoirs de votre rue cet été! Soyez à l’affût!\n\nEn cas de mauvais temps, les animations seront annulées."
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "PT1H00M"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/MixedEventAttendanceMode"
      }
    ]
  },
  {
    "@id": "https://quoivivrerimouski.ca/genid/b865132acc498d9b",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/ComedyPerformance"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2021-08-04T18:00:00-04:00"
      },
      {
        "@type": "http://schema.org/Date",
