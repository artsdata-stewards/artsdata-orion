    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Brel ! Le spectacle"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Sur scène, Olivier Laurent n’imite pas Brel, il est Brel, faisant revivre les textes de ses plus grandes chansons. Avec ce concert présenté partout dans le monde, c'est par la voix, la rage, l'ironie et la tendresse que l'artiste rend cet hommage magistral au plus grand chanteur francophone que la Belgique ait connu. Accompagné de 4 musiciens d’exception, il se donne à corps perdu avec fougue et élégance. Une grande bouffée de poésie avec des frissons garantis !"
      }
    ],
