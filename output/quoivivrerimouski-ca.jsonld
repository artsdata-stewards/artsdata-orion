      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://quoivivrerimouski.ca/genid/5d03a94509c8438e"
      },
      {
        "@id": "https://quoivivrerimouski.ca/genid/accca8ef4dd12de1"
