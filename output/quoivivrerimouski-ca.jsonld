        "@id": "https://quoivivrerimouski.ca/sites/default/files/styles/fiche_d/public/2021-03/DroleDoiseaux_R%C3%A9gulier_8-12.png"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://quoivivrerimouski.ca/genid/c635bb39a40b5185"
