    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "After : la chute"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Alors que Tessa prend la plus importante décision de sa vie, celle-ci change du tout au tout. Des secrets sur sa famille, ainsi qu’à propos de celle d’Hardin, sont révélés et remettent en doute toutes les bases de leur relation. Leur futur à deux, durement acquis, pourra-t-il malgré tout survivre?\n\nDistribution\nHero Fiennes Tiffin\nJosephine Langford\nJohn Flanagan\n\nRéalisation\nCastille Landon\n\nDate de sortie\n10 septembre 2021 Pays États-Unis"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "PT1H00M"
      }
    ],
