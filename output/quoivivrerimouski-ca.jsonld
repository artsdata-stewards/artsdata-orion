    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Slam de la semaine | Anthony Lacroix"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Ça va bien aller, mais ça ne va pas nécessairement bien, et c'est pourquoi on vous présente aujourd'hui le texte «Ataxie d'eau lourde» d'Anthony Lacroix, poète, éditeur-fondateur des Éditions Fond'tonne et passionné commis à la bibliothèque Lisette-Morin.\n\nOn en profite pour envoyer des câlins cosmiques à vous tous et toutes qui avez la zone orange un peu grise."
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
