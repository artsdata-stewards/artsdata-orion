    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Le club Vinland"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Vinland, c’est l’histoire d’un éducateur exceptionnel dans un collège de garçons de l’est du Québec de la fin des années 1940. Adulé de ses élèves mais perçu comme trop dérangeant par les supérieurs de sa congrégation, le charismatique Frère Jean est un progressiste annonciateur des changements à venir dans le Québec des années 1950 et 1960. Voulant à la fois résoudre une énigme historique, motiver ses élèves et empêcher le décrochage d’Émile, un étudiant en difficultés, Frère Jean entreprend de conduire des fouilles archéologiques visant à prouver l’établissement d’une colonie Vikings (le Vinland) sur la côte du Saint-Laurent. L’entreprise bouleversera la vie du collège et laissera sa marque sur les destins du jeune Émile – et de Frère Jean lui-même.\n\nDistribution\nSébastien Ricard\nRémy Girard\nFrançois Papineau\nFabien Cloutier\nÉmilie Bibeau\nXavier Huard\nArnaud Vachon\n\nRéalisation\nBenoit Pilon\n\nDate de sortie\n27 août 2021\n\nPays\nQuébec, Canada"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "PT1H00M"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/MixedEventAttendanceMode"
      }
    ]
  },
