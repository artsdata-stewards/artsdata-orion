    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Tom &amp; Jerry"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Jerry emménage dans le meilleur hôtel de New York à la veille du «mariage du siècle», forçant le planificateur désespéré de l’événement à embaucher Tom pour se débarrasser de lui. La bataille qui s’ensuit menace de détruire sa carrière, le mariage et peut-être l’hôtel lui-même. Mais bientôt, un problème encore plus grave se pose: un membre du personnel diaboliquement ambitieux conspirant contre les trois.\n\nDistribution\nChloë Grace Moretz\nMichael Peña\nKen Jeong\nChristina Chong\nJordan Bolger\nPallavi Sharda\n\nRéalisation\nTim Story\n\nDate de sortie\n26 février 2021\n\nPays\nÉtats-Unis"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "PT1H00M"
      }
    ],
