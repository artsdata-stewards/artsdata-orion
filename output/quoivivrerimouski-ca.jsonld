    "http://schema.org/url": [
      {
        "@id": "https://quoivivrerimouski.ca/evenements/rimouski/lancement-les-outrages-du-desir"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://quoivivrerimouski.ca/sites/default/files/styles/fiche_d/public/2021-07/214094322_3851178278344846_8532407780306562606_n_0.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://quoivivrerimouski.ca/genid/d835029a9259a32b"
      },
      {
        "@id": "https://quoivivrerimouski.ca/genid/ff8d6372910a8a9c"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://quoivivrerimouski.ca/genid/05d0459b136507eb"
      }
    ],
    "http://schema.org/mainEntityOfPage": [
      {
        "@id": "https://quoivivrerimouski.ca/genid/be10d0356cea1bab"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://quoivivrerimouski.ca/evenements/rimouski/lancement-les-outrages-du-desir"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Lancement | Les outrages du désir"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Les outrages du désir de Marcel Méthot est un texte de nature arlequine, mais revisitée. Caustique et critique, l’histoire d’amour enflammée prend place entre les rayons à sous-vêtement d’un magasin à grande surface et déborde parfois dans l’arrière-boutique. On y retrouve les déboires de l’écrivain célèbre, sulfureux et jamais publié, Francis, qui aimerait terminer un roman, car il est certain que ça charmerait les femmes. Il a raison.&nbsp;\n\nJoignez-vous à nous afin de découvrir (ou redécouvrir) cet auteur de chez nous! Le lancement se fera sur la terrasse extérieure située à l'arrière de la boutique de la librairie Vénus.\n\nEn cas de pluie, l'événement se déroulera dans notre nouvelle salle au 2e étage de la Librairie.&nbsp;\n\nBIOGRAPHIE DE L'AUTEUR&nbsp;\nEnseignant en psychosociologie et en travail social à l’Université du Québec à Rimouski, où il a produit une thèse de doctorat sur la pensée utopique, Marcel Méthot est auteur, slammeur et animateur. Plusieurs fois finaliste de la Ligue de slam de l’Est-du-Québec, il a remporté, en septembre 2013, la médaille d’argent au Grand slam de poésie de Montréal. Il a remporté le Concours national de La plus grande menterie au Festival du Rendez-vous des grandes gueules de Trois-Pistoles en 2018. Il a publié, à compte d’auteur, les tomes 1, 2 et 3 de Tant qu’à écrire! (recueil de slams) en 2018 et 2019. Les outrages du désir est son premier roman."
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "PT1H00M"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/MixedEventAttendanceMode"
      }
    ]
  },
