    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Raton Lover à Rimouski"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Salle rouge du Paradis | Ouverture des portes à 18h30\n\nFortement influencé par les 70’s rugissantes, Raton Lover, quartet pop-rock franco accrocheur, affiche son amour inconditionnel pour les Harmonium, Beatles, Wilco, The Band et autres icônes de l'époque. Alternant entre ballades chaleureuses aux accents folk-rock et incursions plus pesantes, le talent sensible de ces bums de bonne famille culmine dans un spectacle énergique et rassembleur."
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "PT1H00M"
      }
