    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Slam de la semaine | Elise Argouarc&#039;h"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "La vie est un brin pesante ces temps-ci, alors pour se donner un petit kick pour commencer la semaine, Quoi Vivre Rimouski a appelé en renfort Slam Est-du-Québec pour nous livrer des petites pépites poétiques chaque lundi.\nCette semaine, c'est Elise Argouarc'h qui vous offre ses mots!"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
