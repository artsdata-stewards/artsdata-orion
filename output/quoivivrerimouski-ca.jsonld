    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Conte audio no 1"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "En février, quatre nouveaux contes qui réchauffent le cœur vous entraîneront dans de folles aventures! Que ce soit au coin du feu, sous les couvertures, ou collés en famille sur le divan, fermez les yeux et laissez votre imagination vagabonder au son de la voix de notre équipe de joyeux conteurs!\n\nCette semaine: Marie-Baba et les 40 rameurs \nAutrices: Carole Tremblay\nIllustrations: Dominique Jolin\npar Dominique &amp; Compagnie\n\n«Quand on a pour papa le plus terrible des pirates des mers du Sud, que peut-on bien se faire offrir pour son anniversaire? Une fabuleuse chasse au trésor, évidemment!»"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "PT1H00M"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/MixedEventAttendanceMode"
      }
    ]
  },
