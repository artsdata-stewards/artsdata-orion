      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://quoivivrerimouski.ca/genid/062a44b167d9bc57"
      },
      {
        "@id": "https://quoivivrerimouski.ca/genid/1063c5d9d2e1b082"
