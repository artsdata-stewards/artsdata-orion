      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://quoivivrerimouski.ca/genid/9b45f08874a0b287"
      },
      {
        "@id": "https://quoivivrerimouski.ca/genid/4bf164e305104b36"
