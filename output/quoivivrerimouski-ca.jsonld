    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Laboratoire public d’Archéologie"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le Laboratoire d’archéologie et de patrimoine de l’Université du Québec à Rimouski s’installe au Musée régional de Rimouski du 1er au 17 octobre 2021. Les visiteurs seront invités à échanger avec les archéologues en résidence pendant qu’ils poursuivent leurs recherches sur du matériel archéologique rimouskois et bas-laurentien.\n\n\nHoraire :\n\nDu mercredi au dimanche de 12 h à 17 h\n\nLes jeudis de 12 h à 19 h&nbsp;\n\n&nbsp;\n\nL'exposition a lieu dans la salle TROIS.\n\n&nbsp;"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "PT1H00M"
      }
    ],
