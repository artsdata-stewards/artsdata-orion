    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Éclats de romantisme"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "« Éclats de romantisme » célèbre le retour de David Jalbert, au piano, avec la soprano Magali Simard-Galdès pour vous offrir des airs d’Alma Mahler, Richard Strauss, Olivier Messiaen et Francis Poulenc. Ses complices du Quatuor Saint-Germain le rejoignent pour le majestueux quintette de Brahms qui sera servi comme feux d’artifice en conclusion du festival.\n\nUne présentation d’Hydro-Québec."
      }
    ],
