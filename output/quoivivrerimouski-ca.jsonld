    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://quoivivrerimouski.ca/evenements/rimouski/le-cerf-aux-flocons"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Le cerf-aux-flocons"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Cerf-aux-flocons\nArietes Lanula demitti\n\nLe Cerf-aux-flocons fait partie de la famille des Cervidés-des-neiges. Il porte un spectaculaire panache d’un blanc pur. Créature mi-animale, mi-arbre, on raconte que son panache lui vient du bois d’un arbre très ancien, l’Albero benevolo. Il porte de la fourrure au cou et aux pattes, ce qui le tient au chaud. Il affectionne les boisés où vivent des arbres vénérables avec qui il aime discuter. Il a le pouvoir d’attraper les flocons avec sa langue sans les faire fondre. Il possède une collection incroyable de flocons. Il aime bien aussi, à l’occasion, goûter aux pétouloumes des Tipetums quand il y a des Tipetums aux alentours. Apercevoir un Cerf-aux-flocons porte chance. Profites-en pour fermer les yeux et faire un vœu.\n\nLisbeth et Gretchen Von Riseth vont tout&nbsp;t'apprendre sur cette créature dans leur&nbsp;capsule!"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "PT1H00M"
      }
    ],
