      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://quoivivrerimouski.ca/sites/default/files/styles/fiche_d/public/2021-09/belles_be%CC%82tes.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://quoivivrerimouski.ca/genid/d591e44a93f29aa1"
      },
      {
        "@id": "https://quoivivrerimouski.ca/genid/0bd548784b0345be"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://quoivivrerimouski.ca/genid/2677f34846ac8230"
      },
      {
        "@id": "https://quoivivrerimouski.ca/genid/ddf9a65f3fa68fc8"
