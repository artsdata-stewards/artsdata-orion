    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://quoivivrerimouski.ca/evenements/rimouski/escouade-musicale"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Escouade musicale"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "L'Escouade musicale invite gastronomes, randonneurs et cyclistes à prendre une pause musicale au Sentier du littoral de Rimouski !\n\nUne occasion parfaite pour prendre le temps, profiter du magnifique paysage, tout en savourant la prestation de notre duo de la relève.\n\nConsultez la programmation ci-dessus pour plus de détails!\n\nINFORMATIONS IMPORTANTES\n\n\n\tVous devez vous inscrire via le bouton «Réservez en ligne» du concert qui vous intéresse;\n\tDes chaises seront fournies sur place;\n\tPrévoyez votre arrivée au plus 30 minutes à l'avance pour vous rendre sur le site du concert\n\tEn cas de mauvaise température, l'annulation sera annoncée au plus tard 2h avant le concert sur le site web des Concerts aux Îles du Bic&nbsp;\n\tLe port du masque est obligatoire durant le spectacle pour les personnes de 10 ans et plus.\n\n\nEn partenariat avec la Ville de Rimouski"
      }
    ],
