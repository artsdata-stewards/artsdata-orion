    "http://schema.org/image": [
      {
        "@id": "https://quoivivrerimouski.ca/sites/default/files/styles/fiche_d/public/2021-06/15%20ans%21.jpg?h=5b35c6ff"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://quoivivrerimouski.ca/genid/f7afb8ff06428efb"
