    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "La déesse des mouches à feu"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Catherine traverse l’adolescence en même temps que ses parents amorcent un processus de divorce. L’exploration ne sera pas douce ni romantique, d’une dérape à l’autre, elle vieillit dans le chaos violent et spectaculaire de l’adolescence grunge des années 90.\n\nDistribution\nKelly Depeault\nCaroline Néron\nNormand D'Amour\nÉléonore Loiselle\nRobin L'Houmeau\nNoah Parker\nMarine Johnson\nAntoine Desrochers\nMaxime Gibeault\n\nRéalisation\nAnaïs Barbeau-Lavalette\n\nDate de sortie\n25 septembre 2020\n\nPays\nCanada, Québec"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "PT1H00M"
      }
    ],
