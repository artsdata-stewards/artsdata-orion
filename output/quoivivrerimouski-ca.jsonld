        "@id": "https://quoivivrerimouski.ca/sites/default/files/styles/fiche_d/public/2021-07/Photo%20promo%20Expo%204_d%C3%A9tail%20Entre%20chien%20et%20Loup_Cr%C3%A9dit%20photo%20Jean-Fran%C3%A7ois%20Lajoie_2021.jpg"
