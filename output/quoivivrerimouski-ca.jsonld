    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://quoivivrerimouski.ca/evenements/rimouski/raya-et-le-dernier-dragon"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Raya et le dernier dragon"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Raya et le dernier dragon de Walt Disney Studios nous entraîne dans une aventure épique dans le monde fantastique de Kumandra où les humains et les dragons vivaient en harmonie il y a de cela très longtemps. Lorsqu’une force maléfique a menacé leurs terres, les dragons se sont sacrifiés pour sauver l’humanité. Aujourd’hui, 500 ans plus tard, cette même force maléfique est de retour et c’est à la confiante guerrière solitaire Raya, que revient le devoir de retrouver le dernier dragon afin de restaurer les terres brisées et rassembler les peuples divisés.\n\nRéalisation\nPaul Briggs\nDean Wellins\n\nDate de sortie\n5 mars 2021\n\nPays\nÉtats-Unis"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "PT1H00M"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/MixedEventAttendanceMode"
      }
    ]
  },
