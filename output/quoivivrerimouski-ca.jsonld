    "http://schema.org/image": [
      {
        "@id": "https://quoivivrerimouski.ca/sites/default/files/styles/fiche_d/public/2021-06/ANG3_Photo%201-Rick_2021_0.jpeg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://quoivivrerimouski.ca/genid/cf9ddecba3030fd9"
      },
      {
