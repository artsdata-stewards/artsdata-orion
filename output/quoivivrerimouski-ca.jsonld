      },
      {
        "@id": "https://quoivivrerimouski.ca/genid/348837b90c737349"
      }
    ],
    "http://schema.org/mainEntityOfPage": [
      {
        "@id": "https://quoivivrerimouski.ca/genid/62bac91cc7140d97"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://quoivivrerimouski.ca/evenements/rimouski/gravier-lime"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Gravier lime"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "La programmation En Continu se poursuit avec la présentation de GRAVIER LIME.\nFormé de Gabriel Dufour Langlois à la guitare, Thomas Gaudet-Asselin à la basse ainsi que Tom Jacques à la batterie, Gravier Lime est un trio de musique instrumentale aux sonorités tumultueuses et authentiques. Tantôt dans l’improvisation et la spontanéité, tantôt dans les structures écrites, la musique de Gravier Lime développe son côté suret aussi bien dans le free jazz que dans le rock où douces mélodies atonales ainsi qu’harmonies éthérées se fracassent à des instants de débauche musicale et d’improvisations frivoles. Riches du partage présent entre eux, les musiciens se servent de ce lien afin de créer collectivement une musique qui les inspire à dépasser leurs propres limites ainsi que leur confort musical afin d’évoluer dans une voie nouvelle à chacun. Spontanéité volubile et tableaux pastels à prévoir.\n\n\nLa prestation pourra être visionnée en direct sur le web, via la plateforme Quoi Vivre Rimouski.\n\nBANDCAMP\nhttps://gravierlime.bandcamp.com/album/gravierlime-ep\n\n\nINFO COVID\n\n\nLe port du masque de procédure est obligatoire.\nLes portes ouvrent à 19h30.\nAchat groupé par bulles, vous devez avoir la même adresse pour vous asseoir ensemble. Les places sont limitées donc ne perdez pas de temps!\n\n\nSi vous ressentez des symptômes ou avez côtoyé une personne ressentant des\nsymptômes de la COVID-19 (toux ou mal de gorge, état de fatigue généralisé, fièvre, difficulté à respirer), nous vous demandons de ne pas vous présenter à la salle."
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "PT1H00M"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/MixedEventAttendanceMode"
      }
    ]
  },
