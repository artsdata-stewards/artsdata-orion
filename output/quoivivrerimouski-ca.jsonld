    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Un employé de banque solitaire découvre qu’il n’est qu’un personnage anonyme dans le vaste monde d’un jeu vidéo nommé Free City.\n\nDistribution\nRyan Reynolds\nTaika Waititi\nJoe Keery\nLil Rel Howery\nUtkarsh Ambudkar\n\nRéalisation\nShawn Levy\n\nDate de sortie\n13 août 2021"
      }
