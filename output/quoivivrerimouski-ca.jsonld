      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Olivier D&#039;Amours vous chante des chansons d&#039;amour"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Comme le musicien amoureux qui viendrait chanter sous le balcon de son public adoré, les chansons d’amour d’Olivier D’Amours viendront vous toucher droit au coeur. Dans un enchaînement de tounes francophones pop et d’interventions cocasses et/ou poético-grivoises, la voix d’Olivier se mêle à sa guitare pour vous charmer et vous faire oublier la distance qui vous sépare.\n\nUne prestation quétaine, mais vraiment divertissante donnée par un artiste très impliqué au sein de la scène culturelle locale!\n\n\nPour ses 15 ans, la Coopérative de solidarité Paradis vous offre cinq prestations disponibles pendant une semaine, gratuitement, sur Quoi Vivre Rimouski, à écouter de la maison !\n\nPour consulter la programmation complète des 15 ans, c'est ICI"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "PT1H00M"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/MixedEventAttendanceMode"
      }
    ]
  },
