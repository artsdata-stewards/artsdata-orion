    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://quoivivrerimouski.ca/evenements/rimouski/les-vieux-chums"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Les vieux chums"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Pierrot rentre à Saint-Hyacinthe, sa ville natale, pour y revoir les gens et les lieux qu’il aime et qu’il a toujours portés en lui, même lorsqu’il vivait à l’étranger. Il vient boucler la boucle, fermer les livres. Serein, Pierrot n’a aucune peur de cette mort qui se pointe prématurément. Il sollicite son ami d’enfance, Jacques, pour l’aider à bien finir ses jours. La démarche qui est peu commune mènera néanmoins les deux amis vers une apaisante quiétude.\n\nDistribution\nPatrick Labbé Paul Doucet Luka Limoges Marie-Pier Labrecque Stéphan Côté Luc Proulx\n\nRéalisation\nClaude Gagnon\n\nDate de sortie\n21 mai 2021\n\nPays\nCanada, Québec"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "PT1H00M"
      }
    ],
