    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Trio Salicorne"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Trio Salicorne brise la glace!&nbsp;\nPremier spectacle de la programmation En Continu.\n\nUn accordéon, une guitare, deux violons et trois paires de pieds font vibrer des mélodies issues de la tradition québécoise, celtique, scandinave, américaine. Le trio puise dans l’air salin du Saint-Laurent pour vous proposer une musique parfois intimiste, parfois enlevante.\n\nAvec Sabrina Berger Robin Servant et Patricia Ho-Yi Wang"
      }
    ],
