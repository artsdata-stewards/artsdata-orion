    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "TOUR DE BRAS EN MANCHES COURTES"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "En juin, Tour de Bras vous offre un événement de chansons et de musiques fraîches pour l'arrivée du beau temps !\n\n\nVous pouvez réserver vos places pour chacun des spectacles dans leur billetterie respective!\nFaites vite! Les places sont TRÈS limitées!\n\n\nTAMAYUGÉ | 17 juin\n&nbsp; &nbsp; &nbsp; &gt;&gt; Billets &lt;&lt;\n\n\n\nHommage à Rose\nDrummond | 26 juin\n&nbsp; &nbsp; &nbsp; &gt;&gt; Billets &lt;&lt;\n\n\n\n&nbsp;\n\n&nbsp;\n\n&nbsp;\n\n&nbsp;\n\n&nbsp;"
      }
    ],
