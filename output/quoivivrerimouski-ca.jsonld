        "@id": "http://kg.artsdata.ca/resource/MusicPerformance"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2021-03-28T14:00:00-04:00"
      }
    ],
    "http://schema.org/endDate": [
      {
