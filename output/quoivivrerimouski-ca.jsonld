    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Le parcours d&#039;orientation du Carrousel"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le Carrousel international du film de Rimouski invite tous les résidents de Rimouski à sortir jouer à l'extérieur! Le temps sera bon, le soleil brillera et les oiseaux chanteront une fois revenus du sud. Que de bonnes raisons pour participer au parcours d’orientation du Carrousel. Un itinéraire amusant dans les sentiers du parc Beauséjour créé en collaboration avec RIKICO. Ce parcours stimulant et bien sûr imprégné du septième art, saura divertir petits et grands, jusque dans votre salon! Faits divers, énigmes et bien plus encore seront au rendez-vous. Une autre activité présentielle qui n’a pas froid aux yeux! Pour plus d'information, visitez le www.carrousel.qc.ca"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "PT1H00M"
      }
