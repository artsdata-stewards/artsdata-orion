    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "No time to die | version originale anglaise"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "In No Time To Die, Bond has left active service and is enjoying a tranquil life in Jamaica. His peace is short-lived when his old friend Felix Leiter from the CIA turns up asking for help. The mission to rescue a kidnapped scientist turns out to be far more treacherous than expected, leading Bond onto the trail of a mysterious villain armed with dangerous new technology.\n\nCast\nDaniel Craig\nLéa Seydoux\nRami Malek\nRalph Fiennes\nLashana Lynch\nBen Whishaw\nJeffrey Wright\nAna de Armas\nBilly Magnussen\nChristoph Waltz\nNaomie Harris\nRory Kinnear\nDali Benssalah\nDavid Dencik\n\nDirectors\nCary Joji Fukunaga\nCary Fukunaga"
      }
    ],
