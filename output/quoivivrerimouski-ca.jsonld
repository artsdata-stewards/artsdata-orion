    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Cégep en spectacle"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "C'est le 24 novembre prochain, à 19 h 30, que nous vous présenterons la 44e finale locale de Cégeps en spectacle à la Salle Georges-Beaulieu.\nAdmission : 10 $ (argent comptant ou carte de débit). En vente au D-107 ou à la porte le soir du spectacle.\nOuvert à toute la population, l'évènement mettra en scène différents domaines des arts tels que l'art oratoire, le chant, la danse, la musique et le théâtre, en interprétation ou en création.\nLe numéro gagnant de cette soirée obtiendra son laissez-passer pour la finale régionale de l'Est-du-Québec, qui se tiendra en mars 2023 aux Îles-de-la-Madeleine.\nSoyez des nôtres! 🙂"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "PT1H00M"
      }
