    "http://schema.org/image": [
      {
        "@id": "https://quoivivrerimouski.ca/sites/default/files/styles/fiche_d/public/2021-03/Table%20ronde_Les%20enfants%20et%20les%20%C3%A9crans.png"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://quoivivrerimouski.ca/genid/006f3a4c03928a4c"
      },
      {
        "@id": "https://quoivivrerimouski.ca/genid/7e7a74417ff4c759"
