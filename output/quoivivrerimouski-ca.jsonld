        "@value": "2021-08-05"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://quoivivrerimouski.ca/evenements/rimouski/la-bulle-des-kombini"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://quoivivrerimouski.ca/sites/default/files/styles/fiche_d/public/2021-07/DEA4_Photo%20Bulle%20Kombini.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://quoivivrerimouski.ca/genid/677e6b916c7ef994"
      },
      {
        "@id": "https://quoivivrerimouski.ca/genid/0a5683006270bd89"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://quoivivrerimouski.ca/genid/9e1933b6d95edf55"
      }
    ],
    "http://schema.org/mainEntityOfPage": [
      {
        "@id": "https://quoivivrerimouski.ca/genid/0e3804faab577f5e"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://quoivivrerimouski.ca/evenements/rimouski/la-bulle-des-kombini"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "La bulle des Kombini"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Mercredi 4 août\nDistrict Saint-Germain\nDépart du centre communautaire Sainte-Agnès Nord, à 18 h\n\nJeudi 5 août\nDistrict Nazareth\nDépart du centre communautaire Nazareth, à 18 h\n\nEn réponse à la crise sanitaire actuelle, les Foutoukours veulent faire vivre une expérience apaisante et magique aux citoyens. Par la force clownesque du duo des Kombini, la poésie propre aux Foutoukours et la collaboration de plusieurs partenaires municipaux, la Bulle des Kombini a été un moment fort de l’été dernier pour plusieurs municipalité. C’est maintenant au tour de Rimouski de profiter de ce beau moment.\n\nLa bulle des Kombini, une œuvre déambulatoire visuelle et auditive! Des milliers de bulles s’envolent, de la douce musique se répand et deux clowns saluent la foule pour apporter sourire et réconfort.\n\nSurveillez, il est possible que cette animation surprise déambule sur les trottoirs de votre rue cet été! Soyez à l’affût!\n\nEn cas de mauvais temps, les animations seront annulées."
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "PT1H00M"
      }
    ],
