    "http://schema.org/url": [
      {
        "@id": "https://quoivivrerimouski.ca/evenements/rimouski/le-voyage-en-chanson-des-peres-petu"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://quoivivrerimouski.ca/sites/default/files/styles/fiche_d/public/2021-07/DEA1_Photo%20Peres%20Petu.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://quoivivrerimouski.ca/genid/19913d5607450018"
      },
      {
        "@id": "https://quoivivrerimouski.ca/genid/262ede46787b75a8"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://quoivivrerimouski.ca/genid/8e042895ba600b73"
      }
    ],
    "http://schema.org/mainEntityOfPage": [
      {
        "@id": "https://quoivivrerimouski.ca/genid/bfefb286a82cc9ab"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://quoivivrerimouski.ca/evenements/rimouski/le-voyage-en-chanson-des-peres-petu"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Le voyage en chanson des Pères Pétu"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Mardi 13 juillet\nDistrict Sainte-Blandine/Mont-Lebel\nDépart de l’Église de Sainte-Blandine, à 18 h\n\nJeudi 15 juillet\nDistrict Le Bic\nDépart de la rue Marie-Bellavance, à 18 h\n\nLes Pères Pétu c’est le duo formé par les musiciens Éric Bégin (voix et guitare) et Éloi Amesse (violon, voix et podorythmie). Les deux complices ont forgé leur répertoire en puisant autant dans les classiques de la chanson que dans la musique folklorique québécoise et irlandaise. Depuis une dizaine d’années, leur mission de perpétuer l’amour de la chanson et de la musique les a fait sillonner le Québec et l’Ontario pour présenter leur spectacle jeunesse Le Voyage en Chanson des Pères Pétu (anciennement baptisé Sur les traces de la musique québécoise) à plus de 500 reprises dans les écoles, salles de spectacles, festivals, maisons de la culture, etc.\n\nEn parallèle, ils n’ont cessé de présenter leur spectacle familial décontracté Veuillez Réveiller vos Veillées, au cours duquel ils se donnent la liberté de choisir des pièces de façon spontanée dans leur grand répertoire de musiques trad et de chansons québécoises, selon l’humeur du public. Leur mot d’ordre est d’échanger avec celui-ci et de toujours être à l’affut de la pièce qui saura les transporter.\n\nLeur nouvelle proposition, Les Pères Pétu déambulent, est la version déambulatoire de ce spectacle rassembleur, qui est toujours très apprécié autant des publics familiaux que des publics d’aînés.\n\nSurveillez, il est possible que cette animation surprise déambule sur les trottoirs de votre rue cet été! Soyez à l’affût!\n\nEn cas de mauvais temps, les animations seront annulées."
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "PT1H00M"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/MixedEventAttendanceMode"
      }
    ]
  },
