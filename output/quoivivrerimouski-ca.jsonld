    "http://schema.org/image": [
      {
        "@id": "https://quoivivrerimouski.ca/sites/default/files/styles/fiche_d/public/2021-02/tipetum-traits.png"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://quoivivrerimouski.ca/genid/c53c1a1d91c4cbba"
      },
      {
        "@id": "https://quoivivrerimouski.ca/genid/dea726e46647e5ba"
