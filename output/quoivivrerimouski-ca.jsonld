    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://quoivivrerimouski.ca/evenements/rimouski/un-vrai-gentleman"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Un vrai gentleman"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "UN VRAI GENTLEMAN | Un film de Aisling Chin-Yee &amp; Chase Joynt\n\nFiche technique\nAnnée 2021\nGenre Documentaire\nPays Québec\nLangue&nbsp;Anglais\nSous-titres Français\nDurée 84 minutes&nbsp;\n\nPendant des décennies, la vie du musicien de jazz américain Billy Tipton fut présentée comme l’histoire d’une femme ambitieuse se faisant passer pour un homme afin de poursuivre une carrière musicale. Dans UN VRAI GENTLEMAN, l’histoire de Billy Tipton est repensée et interprétée par des artistes trans qui peignent collectivement le portrait de ce héros improbable. Les cinéastes se sont associés au fils de Billy Tipton, Billy Jr., afin d’honorer cet héritage complexe et controversé : comment raconter l’histoire d’une personne qui se cachait en plein jour, mais qui faisait tout pour être vue ?\n\nEn collaboration avec le Festi Jazz international de Rimouski\n\nTIFF Canada's Top Ten |&nbsp;2020\nSélection des 10 meilleurs films de l'année par le TIFF \n\nInside Out Film festival |&nbsp;2020\nMeilleur long-métrage canadien \n\nRencontres internationales du documentaire de Montréal |&nbsp;2020\nMention Spéciale / Prix Magnus Isacsson \n\nRencontres internationales du documentaire de Montréal |&nbsp;2020\nPrix Nouveaux Regards \n\nSouth Western International Film Festival | 2020\nPrix du public\n\n&nbsp;\n\n** ATTENTION **\nVEUILLEZ ACHETER VOTRE BILLET EN LIGNE GRÂCE AU LIEN SUR CETTE PAGE - LE NOMBRE DE PLACE SERA RÉDUIT POUR DES RAISONS SANITAIRES.\nLE PORT DU MASQUE DE PROCÉDURE SERA OBLIGATOIRE PENDANT LA PROJECTION.\n(Nous en aurons sur place)"
      }
    ],
