    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://quoivivrerimouski.ca/evenements/rimouski/les-trois-accords-live-dans-le-plaisir"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Les Trois Accords : Live dans le plaisir"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Live dans le plaisir, un film musical des Trois Accords. Capté dans un studio de production virtuelle à la fine pointe de la technologie, la formation livre une performance immersive unique devant un écran géant incurvé de 50 pieds avec lequel ils ne font qu’un. Une prise de vue permettant la création d’images cinématographiques époustouflantes!\n\nAvec des décors déjantés où la beauté des forêts tropicales, les images grandioses de l’espace, les animaux sauvages et les pistes de courses croisent des images vhs documentaires et des messages vocaux aux incidences loufoques, le groupe transporte ses plus grands succès dans l’univers de son plus récent album, Beaucoup de plaisir. Une aventure musicale originale qui vous plonge au cœur de leur monde coloré et éclaté!\n\nDistribution\nPierre-Luc Boisvert\nCharles Dubreuil\nAlexandre Parr\nSimon Proulx\n\nRéalisation\nLouis-Philippe Eno\n\nDate de sortie\n21 mai 2021\n\nPays\nCanada, Québec"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "PT1H00M"
      }
    ],
