    "http://schema.org/url": [
      {
        "@id": "https://quoivivrerimouski.ca/evenements/rimouski/linda-babin-prend-son-bain"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://quoivivrerimouski.ca/sites/default/files/styles/fiche_d/public/2021-07/DEA3_Photo%20Linda%20Babin%20%282%29_CREDIT%20Charles%20Briand.jpg"
