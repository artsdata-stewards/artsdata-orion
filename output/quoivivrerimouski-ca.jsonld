    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Venom : Ça va être un carnage"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Tom Hardy revient sur grand écran sous la peau du Symbiote Eddie Brock / Venom, l’un des personnages les plus grands et les plus complexes de Marvel. Réalisé par Andy Serkis, le film met également en vedette Michelle Williams, Naomie Harris et Woody Harrelson, dans le rôle du méchant Cletus Kasady/Carnage. Venom va aussi affronter Shriek.\n\nDistribution\nTom Hardy\nWoody Harrelson\nMichelle Williams\n\nRéalisation\nAndy Serkis\n\nDate de sortie\n30 septembre 2021\n\nPays\nÉtats-Unis"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "PT1H00M"
      }
