    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Programme Jazz Pop"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dans le cadre de la 36e édition du Festi Jazz international de Rimouski présenté par Québecor, le grand chapiteau de la Place Festi Jazz Québecor accueille Programme Jazz Pop;\n\n&nbsp;\n\nDepuis 2010, le programme de musique jazz-pop du Cégep de Rimouski accueille des étudiants et des étudiantes de partout au Québec pour leur offrir une formation de haut niveau, stimulante et axée sur la scène et le spectacle. Chaque année, le Festi Jazz propose à ces jeunes artistes une vitrine exceptionnelle en les invitant de se produire professionnellement sur une des plus belle scène de la région. Venez entendre et apprécier leur travail en bonne compagnie !"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "PT1H00M"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/MixedEventAttendanceMode"
      }
    ]
  },
