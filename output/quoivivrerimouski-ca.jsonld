    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://quoivivrerimouski.ca//evenements/rimouski/marc-antoine-levesque-0"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Marc-Antoine Lévesque"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Disponible du 15&nbsp;juin dès 17h jusqu'au 22&nbsp;juin!\n\nJeune humoriste Rimousko-montréalais et dernièrement lauréat du prix Coup de cœur du public au festival Le Tremplin de Dégelis, Marc-Antoine Lévesque est revenu en région pour vous faire rire!\n\nLa tournée de son premier spectacle Scrap book s’est vue interrompue par la pandémie, qu’à cela ne tienne! Marc-Antoine s’en est rapidement remis au numérique et est déjà en écriture pour un prochain spectacle.\n\nVous l’avez peut-être déjà aperçu sur Youtube, Twitch ou en Facebook Live …\nNe manquez pas sa prestation En Continu, le temps d’une part - ou deux - de gâteau !\n\n\nPour ses 15 ans, la Coopérative de solidarité Paradis vous offre cinq prestations disponibles pendant une semaine, gratuitement, sur Quoi Vivre Rimouski, à écouter de la maison !\n\nPour consulter la programmation complète des 15 ans, c'est ICI\n\n&nbsp;"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "PT1H00M"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/MixedEventAttendanceMode"
      }
    ]
  },
