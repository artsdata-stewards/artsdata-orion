    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Fred Fortin en trio"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Fred fait partie d’une certaine garde établie.\nUne valeur sûre pour des guitares bien appuyées et un son cru.\nQu’il nous parle d’oiseau de malheur, d’amour ou de la routine essoufflante,\nSa poésie granuleuse forme de véritables films dans nos têtes.\nBien entouré comme à son habitude, Fortin offre un&nbsp;power trio fougueux et démentiel.\n\nhttps://fredfortin.bandcamp.com/"
      }
    ],
