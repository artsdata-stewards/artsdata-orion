      {
        "@id": "https://quoivivrerimouski.ca/evenements/rimouski/bootlegger"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://quoivivrerimouski.ca/sites/default/files/styles/fiche_d/public/2021-06/ANG5_Photo%20promo%20Bootlegger_2021.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://quoivivrerimouski.ca/genid/83b0899e9c9feecd"
      },
      {
        "@id": "https://quoivivrerimouski.ca/genid/19666a3965f5f331"
      }
    ],
    "http://schema.org/offers": [
      {
