    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Les Vitrines du Carrousel"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le Carrousel international du film désire offrir une activité en présentielle et exceptionnelle aux habitants de Rimouski. Du 20 au 28 mars prochain, nous vous proposons un parcours de courts-métrages en plein cœur du centre-ville de Rimouski. En effet, pendant huit jours, avec l’aide des commerces rimouskois participants, nous ferons jouer des courts métrages dans les vitrines de ceux-ci. Vous pourrez alors vous arrêter et profiter d’un magnifique court film, le tout à l’extérieur en respectant la distanciation sociale et gratuitement. Un circuit amusant et haut en couleur qui saura divertir petits et grands."
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "PT1H00M"
      }
