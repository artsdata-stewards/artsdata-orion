        "@id": "https://quoivivrerimouski.ca/sites/default/files/styles/fiche_d/public/2021-02/BSL_UNsmile_JPG_squareW.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://quoivivrerimouski.ca/genid/253c5c96725dd511"
      },
      {
        "@id": "https://quoivivrerimouski.ca/genid/f6b5034155b69f51"
