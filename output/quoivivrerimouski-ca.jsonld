    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "La famille Addams 2"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dans ce tout nouveau film, les Addams s’emmêlent dans des aventures loufoques et se retrouvent impliqués dans des affrontements hilarants avec toutes sortes de personnages sans méfiance. Restant toujours fidèle à elle-même, la famille Addams apporte sa fantaisie et sa folie emblématiques où qu’elle aille.\n\nRéalisation\nGreg Tiernan\nConrad Vernon\n\nDate de sortie\n1 octobre 2021\n\nPays\nÉtats-Unis, Grande-Bretagne, Canada"
      }
    ],
