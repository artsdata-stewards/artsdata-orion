    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://quoivivrerimouski.ca/evenements/rimouski/box-40e-anniversaire"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "The Box 40e anniversaire"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Formé en 1981, la formation&nbsp;The Box&nbsp;voit le jour en 1982 et domine les palmarès dix années durant. Fort de 4 prix Félix et 4 albums tous certifiés or et platine, le groupe a sorti depuis plusieurs opus ainsi qu’un mini-album en 2018. La formation n’a pas cessé de se produire en concert au Canada et ailleurs depuis, tant en salles de spectacles qu’en festivals. Déjà 40 ans depuis le jour un. The Box n’a aucune intention de prendre sa retraite !&nbsp;\n\n&nbsp;\n\nPrincipales mesures sanitaires en vigueur :&nbsp;Passeport vaccinal et pièce d’identité demandés lors de l’entrée en salle&nbsp;| Nombre de places limité à 500 personnes&nbsp;| Plan de salle adapté qui offre plusieurs types d’ilots de sièges pour : une, deux, trois ou quatre personnes. Les sièges regroupés en ilots sont dédiés aux personnes résidant à une même adresse | Distance de 1 siège entre chaque ilot de sièges"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "PT1H00M"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/MixedEventAttendanceMode"
      }
    ]
  },
