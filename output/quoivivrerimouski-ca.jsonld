    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Visites guidées historiques des Circuits Rimouski"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Découvrez l'architecture, l'histoire et le patrimoine du centre-ville en compagnie d'une guide-interprète de la Société rimouskoise du patrimoine. Vous sillonnerez le coeur de Rimouski, là où sont concentrées les grandes institutions civiles et religieuses. Ce circuit permet de comprendre les grandes étapes du développement urbain."
      }
    ],
