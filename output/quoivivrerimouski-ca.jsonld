    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Evan Hansen, un lycéen atteint de trouble d’anxiété sociale et son parcours de découverte de soi et d’acceptation après le suicide d’un camarade de classe.\n\nDistribution\nBen Platt\nAmy Adams\nJulianne Moore\nKaitlyn Dever\nAmandla Stenberg\nDanny Pino\n\nRéalisation\nStephen Chbosky\n\nDate de sortie\n24 septembre 2021\n\nPays\nÉtats-Unis"
      }
    ],
