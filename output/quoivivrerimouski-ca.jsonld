    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Délicieux"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "France, 1789, juste avant la Révolution. Avec l’aide d’une jeune femme surprenante, un chef qui a été limogé par son maître trouve la force de se libérer de sa position de serviteur et ouvre le premier restaurant.\n\nDistribution\nGrégory Gadebois\nIsabelle Carré\nBenjamin Lavernhe\nGuillaume de Tonquédec\nChristian Bouillette\nLorenzo Lefèbvre\n\nRéalisation\nÉric Besnard\n\nDate de sortie\n17 septembre 2021\n\nPays\nFrance, Belgique"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "PT1H00M"
      }
    ],
