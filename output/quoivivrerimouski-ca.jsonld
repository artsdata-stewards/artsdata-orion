    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Coucou Passe-Partout, le spectacle"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Billets en vente bientôt | Détails à venir\n\nMise en scène : Marc St-Martin\n\nAprès l'immense succès télévisuel de l’émission, Passe-Partout, Passe-Carreau et Passe-Montagne sillonnent enfin les routes du Québec à la rencontre de leurs poussinots et poussinettes. Retrouvez-les sur scène dans un spectacle incluant des jeux participatifs et les chansons populaires de l'émission préférée des tout-petits. Un spectacle à la fois divertissant et stimulant pour tous les enfants d'âge préscolaire… et les parents nostalgiques!\n\nPublic : 2 ans et plus | Durée : 50 minutes"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "PT1H00M"
      }
    ],
