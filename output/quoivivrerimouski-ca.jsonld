        "@value": "2021-10-16"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://quoivivrerimouski.ca/evenements/rimouski/gravier-lime"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://quoivivrerimouski.ca/sites/default/files/styles/fiche_d/public/2021-09/event%20FB%20EN%20CONTINU.png"
      }
    ],
    "http://schema.org/organizer": [
      {
