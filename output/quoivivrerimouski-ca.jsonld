        "@id": "http://kg.artsdata.ca/resource/ComedyPerformance"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2022-10-18T20:00:00-04:00"
      },
      {
        "@type": "http://schema.org/Date",
        "@value": "2020-10-28T21:00:00-04:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2022-10-18"
      }
    ],
    "http://schema.org/url": [
