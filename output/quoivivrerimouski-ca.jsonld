      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://quoivivrerimouski.ca/sites/default/files/styles/fiche_d/public/2021-03/JulieDumont_Espaceatelier3W.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://quoivivrerimouski.ca/genid/253c5c96725dd511"
      },
      {
        "@id": "https://quoivivrerimouski.ca/genid/221c11c0e02213d1"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://quoivivrerimouski.ca/genid/639ade2f8098d36b"
      }
