      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://quoivivrerimouski.ca/evenements/rimouski/les-15-ans-du-paradis"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Les 15 ans du Paradis"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "La programmation EN CONTINU se poursuit avec LA SÉRIE ANNIVERSAIRE de la COOP PARADIS. Célébrons ses 15 ans de marmite culturelle bouillonnante avec cinq mini-spectacles d’artistes locaux à découvrir et/ou avec lesquel.le.s renouer, tous diffusés sur Quoi Vivre Rimouski.\n\nEntre le 15 et le 19 juin, chaque jour de la semaine à 17h, pour l’apéro, un spectacle sera rendu disponible en ligne. Vous aurez une semaine pour les visionner sur le site de Quoi Vivre. À vos confettis !\n\nLe Paradis souffle ses 15 bougies en rêvant de son déménagement à venir et vous donne rendez-vous pour sa pendaison crémaillère quand on sera tous et toutes vacciné.e.s !"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "PT1H00M"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/MixedEventAttendanceMode"
      }
    ]
  },
