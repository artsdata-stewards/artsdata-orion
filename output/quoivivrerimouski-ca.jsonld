    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://quoivivrerimouski.ca/evenements/rimouski/les-libres"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Les libres"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "** ATTENTION **\nVEUILLEZ ACHETER VOTRE BILLET EN LIGNE GRÂCE AU LIEN SUR CETTE PAGE - LE NOMBRE DE PLACE SERA RÉDUIT POUR DES RAISONS SANITAIRES.\nLE PORT DU MASQUE DE PROCÉDURE SERA OBLIGATOIRE PENDANT LA PROJECTION. (Nous en aurons sur place)\nLes Libres est un documentaire qui nous plonge dans la vie de quatre détenus à l’aboutissement de leur peine d’incarcération. C’est dans une usine de transformation du bois que Pierrot, Samuel, Steeve et Frédéric entament un dernier droit de six mois avant de tenter de se retrouver un emploi et de réintégrer la société.\nEst-ce qu’une usine de palettes de bois peut faire d’eux des humains transformés ? Ces détenus ne seront-ils jamais des hommes libres ?\nCe long métrage répond à ces questions à travers le regard de ces individus qui expriment leurs motivations et leurs craintes, au cours d'un programme fondamental dans une perspective de réhabilitation sociale.\nFiche technique\nAnnée : 2020\nGenre : Documentaire\nPays : Québec\nLangue : Français\nDurée : 94 minutes\nRéalisation : Nicolas Levesque"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "PT1H00M"
      }
