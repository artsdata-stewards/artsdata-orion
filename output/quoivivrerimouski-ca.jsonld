    ],
    "http://schema.org/mainEntityOfPage": [
      {
        "@id": "https://quoivivrerimouski.ca/genid/1c069466523636f7"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://quoivivrerimouski.ca/evenements/rimouski/bootlegger"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Bootlegger"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Bootlegger est une formation rimouskoise composée d'anciens membres de Goof Bald, Sally + Everyone et A Civil War for a Clown. Sa musique combine différents genres musicaux puissants, offrant un style qui oscille entre le stoner rock et le punk. La formation interprétera sur scène les compositions de son dernier album, Moonshine. Laissez-vous transporter par les mélodies pesantes et les solos de guitares déjantés de Bootlegger!\nhttps://youtu.be/5lcxnBVxWMM\nInscription obligatoire : billetterie de Spect’Art, au 418 724-0800 ou sur spectart.com. Un billet est nécessaire pour avoir une place, même si c’est gratuit.\nPour la saison estivale, Spect’Art Rimouski et le Service des loisirs, de la culture et de la vie communautaire de la Ville de Rimouski sont fiers d’offrir à nouveau en présentiel Les 5 à l’Angélus, une série de 5 spectacles présentés gratuitement, les mercredis du 14 juillet au 11 août 2021, à 17 heures, à la Salle DESJARDINS-TELUS.\nSoyez assurés que notre priorité est d’offrir une expérience sécuritaire et agréable autant pour les spectateurs que les artistes et le personnel. Nous vous demandons de bien prendre connaissance du Guide du spectateur de Spect’Art Rimouski qui présente les diverses mesures mises en place afin de respecter les normes sanitaires émises par la Santé publique et la CNESST lors de votre passage à la salle.\n-\tNombre de places limité à 225 personnes;\n-\tPlan de salle adapté qui offre différents types d’ilots de sièges pour 1 ou 2 personnes. Pour des îlots de 3 ou 4 personnes, vous devez communiquer avec la billetterie pour procéder à l'achat de billets. Les sièges regroupés en ilots sont dédiés AUX PERSONNES RÉSIDANT À UNE MÊME ADRESSE; \n-\tDistance de 2 mètres entre chaque ilot de sièges afin de respecter les normes de distanciation physique;\n-\tToutes les personnes âgées de 10 ans et plus devront porter un masque de procédure (et non un couvre-visage en tissu) avant, pendant et après le spectacle. Chaque spectateur a la responsabilité d’apporter son masque de procédure.\nCodiffusion : Spect’Art Rimouski"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "PT1H00M"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/MixedEventAttendanceMode"
      }
    ]
  },
