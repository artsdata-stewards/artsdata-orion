    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "ANNULÉ | Village de Sainte-Blandine 1925"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "À l'origine de sa fabrication, en 1981, la maquette représentait plus de 130 bâtiments, incluant les maisons, commerces, granges et remises. Pour cette exposition, étant donné l'espace réduit, les principaux bâtiments comme l'église, le presbytère et quelques commerces seront exposés. De plus, quelques personnages, charrettes, chevaux et accessoires seront fournis.\n\nOn peut voir la maquette complète à l'adresse suivante : https://www.sainte-blandine.com/\n\nCrédit photo | Normand Brisson"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "PT1H00M"
      }
    ],
