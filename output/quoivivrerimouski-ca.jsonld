    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Spectacle Band Rock"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Après trois longues années d’absence, l’École de musique du Bas-Saint-Laurent&nbsp;est heureuse de présenter la 10e&nbsp;édition du spectacle annuel de son programme Band Rock!\n\nAprès de nombreuses répétitions de groupe supervisées par Alexis Carrier et une séance d’enregistrement en studio en avril dernier, les élèves inscrits au programme Band Rock de l’École de musique du Bas-Saint-Laurent sont fins prêts à vous présenter le fruit de leur travail. Cette année, seize musiciens talentueux composent les cinq groupes au programme&nbsp;:&nbsp;Les belles et le Beat,&nbsp;La Maman et les Papaz,&nbsp;Pick Slide, Spaced Out et La Brigade.&nbsp;Ils vous présenteront un spectacle enlevant et varié qui ravira assurément tous les amateurs de musique Rock&nbsp;!\n\nLes billets sont disponibles en prévente auprès des musiciens, à l'École de musique du Bas Saint-Laurent&nbsp;ou&nbsp;à la porte le soir du concert."
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "PT1H00M"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/MixedEventAttendanceMode"
      }
    ]
  },
