    ],
    "http://schema.org/location": [
      {
        "@id": "https://quoivivrerimouski.ca/genid/7d02f37127144c6f"
      },
      {
        "@id": "https://quoivivrerimouski.ca/genid/f89de4c3967a51d6"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://quoivivrerimouski.ca/genid/e7773aba4a44167e"
