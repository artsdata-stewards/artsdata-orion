  {
    "@id": "https://quoivivrerimouski.ca/genid/01b14877a44804ef",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/BroadcastEvent"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2020-12-16"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2020-12-22"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://quoivivrerimouski.ca/evenements/rimouski/solos-prets-porter"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://quoivivrerimouski.ca/sites/default/files/styles/fiche_d/public/2020-12/solos.jpeg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://quoivivrerimouski.ca/genid/32372287de2dba98"
      },
      {
        "@id": "https://quoivivrerimouski.ca/genid/360de1dc78062b17"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://quoivivrerimouski.ca/genid/f7f31d41e73a5732"
      }
    ],
    "http://schema.org/mainEntityOfPage": [
      {
        "@id": "https://quoivivrerimouski.ca/genid/7aaa6d11387cfd6b"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://quoivivrerimouski.ca/evenements/rimouski/solos-prets-porter"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Solos prêts-à-porter"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Du 16 au 22 décembre, entre 16h et 20h, découvrez un parcours poétique et intimiste en vous baladant dans le centre-ville de Rimouski.&nbsp;\nBande-annonce dans l'événement virtuel!\n\nÀ la tombée du jour, les passants et passantes pourront découvrir gratuitement huit projections, qui se déposeront au creux de leurs mains, présentant chacune un solo de danse, dont cinq provenant de Québec et trois de Paris. Une occasion de tirer profit de la noirceur hâtive de l’hiver pour mettre l’art en lumière !\n\nPour recevoir les solos, il faudra se rendre devant les commerces participants entre 16h et 20h. Devant la vitrine, il faudra ensuite tendre les mains, tel un geste de soutien; l’artiste se déposera directement et délicatement aux creux de nos paumes. Pour une meilleure expérience visuelle, les spectateurs sont invités à porter des gants ou des mitaines de couleur pâle ou encore à utiliser les pages blanches d'un cahier.\n\nLes commerces participants sont:\n- La Vie Laine\n- La CaSa de la Couture\n- La Maison Fleurie\n- Fleuriste Desjardins\n- Audition Musik\n- Vert Pomme\n\nPour accompagner l’expérience, un balado a été créé par La Rotonde, diffuseur spécialisé en danse de la ville de Québec. Chaque épisode correspond à un solo : il contient la trame sonore de l'oeuvre suivie d'une discussion inédite avec l'équipe artistique. Nous vous recommandons de télécharger le balado sur votre téléphone avant de vous rendre explorer le parcours en toute tranquillité. Bonne écoute !&nbsp;\nApple Podcasts ==&gt; https://apple.co/3n6mfn7\nGoogle Podcasts ==&gt; https://bit.ly/3n5ezSo\nSpotify ==&gt; https://spoti.fi/2VYxdiK\n\nCe projet est une présentation de la compagnie Danse K par K, le Théâtre du Bic, la SOPER, la Ville de Rimouski, Spect'Art et le Vieux-Théâtre de St-Fabien\n&nbsp;"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "PT1H00M"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/MixedEventAttendanceMode"
      }
    ]
  },
