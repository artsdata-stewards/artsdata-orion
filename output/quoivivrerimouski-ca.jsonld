    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Nomadland | version originale - sous-titres en français"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Une femme dans la soixantaine qui, après avoir tout perdu dans la Grande Récession, se lance dans un voyage à travers l’Ouest américain, vivant en tant que nomade des temps modernes dans une camionnette.\n\nDistribution\nFrances McDormand\nDavid Strathairn\nLinda May\nBob Wells\nSwankie\n\nRéalisation\nChloé Zhao\n\nDate de sortie\n16 avril 2021\n\nPays\nÉtats-Unis"
      }
    ],
