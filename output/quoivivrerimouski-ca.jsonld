    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Bien plus qu’une simple captation de concert, cet accompagnement à l’album Notre-Dame-des-Sept-Douleurs nous arrive tel un vrai vent de fraîcheur; une œuvre éclatée, ambitieuse et festive, véritable tour de force visuel du réalisateur Laurence « Baz » Morais.\n\nRéalisation\nLaurence « Baz » Morais\n\nDate de sortie\n14 novembre 2021\n\nPays\nCanada, Québec"
      }
    ],
