    ],
    "http://schema.org/mainEntityOfPage": [
      {
        "@id": "https://quoivivrerimouski.ca/genid/4dcf6fc54d67f177"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://quoivivrerimouski.ca/evenements/rimouski/belles-betes"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Belles Bêtes"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "De la naissance cellulaire au déploiement numérique,&nbsp;Belles Bêtes&nbsp;offre un voyage au cœur de l'évolution de l'espèce humaine, un hommage à sa beauté et sa sensibilité. De concert avec l’infrarouge, la rétroaction vidéo et une gestuelle inspirée de la mythologie grecque et égyptienne, Mars elle danse magnifie sur scène la performance du danseur.&nbsp;Par la juxtaposition de corps réels et de corps vidéo, la chorégraphe Soraïda Caron crée un hybride visuel donnant l'impression que ces images proviennent de l'intérieur du danseur, faisant ainsi écho à ses propres souvenirs et peut-être aux vôtres. Un spectacle unique mélangeant plusieurs médias à découvrir sur scène !\n\n&nbsp;\n\nPrincipales mesures sanitaires en vigueur :&nbsp;Passeport vaccinal et pièce d’identité demandés lors de l’entrée en salle&nbsp;| Nombre de places limité à 500 personnes&nbsp;| Plan de salle adapté qui offre plusieurs types d’ilots de sièges pour : une, deux, trois ou quatre personnes. Les sièges regroupés en ilots sont dédiés aux personnes résidant à une même adresse | Distance de 1 siège entre chaque ilot de sièges"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "PT1H00M"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/MixedEventAttendanceMode"
      }
    ]
  },
