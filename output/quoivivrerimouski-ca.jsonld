    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://quoivivrerimouski.ca/evenements/rimouski/duo-sainte-cecile-12"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Duo Sainte-Cécile | 1/2"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "L'Escouade musicale invite gastronomes, randonneurs et cyclistes à prendre une pause musicale au Sentier du littoral de Rimouski !\n\nUne occasion parfaite pour prendre le temps, profiter du magnifique paysage, tout en savourant la prestation de notre duo de la relève.\n\nINFORMATIONS IMPORTANTES\n\n\n\tVous devez vous inscrire via le bouton «Réservez en ligne» ci-contre;\n\tDes chaises seront fournies sur place;\n\tPrévoyez votre arrivée au plus 30 minutes à l'avance pour vous rendre sur le site du concert\n\tEn cas de mauvaise température, l'annulation sera annoncée au plus tard 2h avant le concert sur le site web des Concerts aux Îles du Bic&nbsp;\n\tLe port du masque est obligatoire durant le spectacle pour les personnes de 10 ans et plus.\n\n\nEn partenariat avec la Ville de Rimouski"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "PT1H00M"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/MixedEventAttendanceMode"
      }
    ]
  },
