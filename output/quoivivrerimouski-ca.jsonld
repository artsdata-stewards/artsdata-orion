    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://quoivivrerimouski.ca/evenements/rimouski/alex-burger-sweet-monteregie"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Alex Burger | Sweet Montérégie"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Contribution volontaire sur place&nbsp;\n\nAlex Burger chante comme il parle, avec toute l’expressivité et les couleurs de la langue queb, qui épouse son « classic rock » intemporel à merveille. Il nous fait brailler à ses heures avec des ballades country qui sonnent comme si Hank Williams était né dans les années ‘90 en Montérégie. Le reste du temps, il nous garroche toute sa fougue avec l’aisance d’un gars qui est à sa place sur un stage, qui nous conte sa vie à travers ses chansons et qui rock comme pas un.\n\nCe spectacle sera présenté en formule extérieure à la Ferme Rioux du Parc National du Bic\n\nhttps://alexburger.bandcamp.com/releases"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "PT1H00M"
      }
