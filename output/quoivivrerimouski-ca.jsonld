    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Félix et le trésor de Morgäa"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Convaincu que son père disparu en mer deux ans plus tôt est toujours vivant, Félix, 12 ans, part à sa recherche en compagnie du vieux Tom, un marin à la retraite, Quack, le perroquet voleur à la tire unijambiste et Ulysse, le chat qui se comporte comme un chien. Leur périple les conduit jusqu’à l’Ile-de-la-Nuit-Éternelle, dans une cité souterraine où se cache une société secrète dirigée par la mégalomane Morgäa, détentrice d’un trésor.\n\nDistribution\nGabriel Lessard\nKarine Vanasse\nGuy Nadon\nMarc Labrèche\nAntoine Durand\nTristan Harvey\nÉveline Gélinas\nCatherine Proulx-Lemay\n\nRéalisation\nNicola Lemay\n\nDate de sortie\n26 février 2021\n\nPays\nCanada, Québec"
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "PT1H00M"
      }
    ],
