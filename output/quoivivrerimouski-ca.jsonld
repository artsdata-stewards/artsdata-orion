      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://quoivivrerimouski.ca/evenements/rimouski/el-yuc-thomas-gaudet-asselin"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://quoivivrerimouski.ca/sites/default/files/styles/fiche_d/public/2021-06/el%20yuc%20copie.jpg?h=8ee2c2dc"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://quoivivrerimouski.ca/genid/16b646c9d8ddbb38"
      },
      {
        "@id": "https://quoivivrerimouski.ca/genid/d82fa2e762267203"
      }
    ],
    "http://schema.org/offers": [
