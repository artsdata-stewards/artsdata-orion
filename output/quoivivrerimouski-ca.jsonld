        "@id": "https://quoivivrerimouski.ca/sites/default/files/styles/fiche_d/public/2021-07/UnFleuveLhiver.png"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://quoivivrerimouski.ca/genid/d591e44a93f29aa1"
      },
      {
        "@id": "https://quoivivrerimouski.ca/genid/8435ca6f022964b1"
