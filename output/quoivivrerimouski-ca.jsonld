    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Retrouvailles"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le coup de départ du festival s’effectue autour d’un de nos trésors d’ici : Mathieu Gaudet (au piano). Au menu, « La truite » de Franz Schubert, le magnifique Trio de Gabriel Fauré et le duo « Escenas del Sur » d’Efrain Oscher. Il sera accompagné d’Élise Lavoie, de James Darling, d’Ali Kian Yazdanfar à la contrebasse et de Frédéric Lambert à l’alto.\n\nRéalisé en association avec le gouvernement du Canada."
      }
    ],
    "http://schema.org/duration": [
      {
        "@language": "fr",
        "@value": "PT1H00M"
      }
