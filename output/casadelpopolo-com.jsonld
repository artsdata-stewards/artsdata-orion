  {
    "@id": "https://festivalphenomena.tuxedobillet.com/",
    "http://ogp.me/ns#type": [
      {
        "@language": "en",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en",
        "@value": "https://tuxedov1.blob.core.windows.net/tuxedo-festivalphenomena/show/Lancement%20du%20livre%20Traveler%E2%80%99s%20Faith%20de%20Marie%20Davidson_-Oy_H8xlY6WfK0dRAMCi_.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en",
        "@value": "<p>Admission générale</p><p><strong style=\"color: rgb(0, 0, 0);\">La Sotterenea – La Sala Rossa</strong></p><p><strong style=\"color: rgb(0, 0, 0);\">casadelpopolo.com</strong></p><p><strong style=\"color: rgb(0, 0, 0);\">4848, boulevard Saint-Laurent, sous-sol</strong></p><p><strong style=\"color: rgb(0, 0, 0);\">Montréal (Québec)</strong></p><p><br></p><p>Ouverture des portes à 19h</p><p><br></p><p><strong style=\"color: black;\">Les Filles électriques</strong><span style=\"color: black;\"> ont le plaisir de vous inviter au lancement du tout premier recueil de poésie de </span><strong style=\"color: black;\">Marie Davidson</strong><span style=\"color: black;\">, </span><em style=\"color: black;\">Traveler's Faith</em><span style=\"color: black;\">, écrit en anglais et à la projection de son film </span><em style=\"color: black;\">Deep Fried.</em></p><p><br></p><p><span style=\"color: black;\">Pour prolonger un peu la chaleur suspendue de l'été et les déplacements qu'il inspire, Marie Davidson nous convie à une lecture de son premier recueil.</span></p><p><br></p><p><em style=\"color: black;\">Traveler's Faith</em><span style=\"color: black;\"> s'ouvre sur ces mots :</span></p><p><em style=\"color: black;\">Écrire un poème, c'est comme créer une chanson. On ne peut pas le planifier. Il faut attendre, et quand il arrive, il faut l'écrire. Il ne sert à rien d'essayer d'être autre chose que ce que l'on est.</em></p><p><br></p><p><span style=\"color: black;\">À travers une écriture intime, où les questions comptent davantage que les réponses, Marie Davidson transforme les fragments du quotidien en poésie et nous invite à habiter pleinement ce qui nous traverse.</span></p><p><br></p><p><span style=\"color: black;\">Pour l'occasion, nous avons imaginé une soirée qui révèle une autre facette de son travail, au-delà de la musique.</span></p><p><strong style=\"color: black;\">Dès 19 h</strong><span style=\"color: black;\">, découvrez </span><em style=\"color: black;\">Deep Fried</em><span style=\"color: black;\">, un court métrage réalisé par Marie Davidson.</span></p><p><strong style=\"color: black;\">À 20 h 30</strong><span style=\"color: black;\">, assistez à une lecture d'extraits de </span><em style=\"color: black;\">Traveler's Faith</em><span style=\"color: black;\">.</span></p><p><br></p><p><span style=\"color: black;\">La soirée se poursuivra avec un DJ set spécialement imaginé pour l'occasion par </span><strong style=\"color: black;\"><a href=\"https://www.instagram.com/courteousgirl\" rel=\"noopener noreferrer\" target=\"_blank\">Myfanwy</a></strong><span style=\"color: black;\"> et </span><strong style=\"color: black;\"><a href=\"https://www.instagram.com/francescodegallo\" rel=\"noopener noreferrer\" target=\"_blank\">FDG</a></strong><span style=\"color: black;\">, afin de prolonger cette traversée dans le mouvement.</span></p><p><br></p><p><span style=\"color: rgb(0, 0, 0);\">Sur place, des exemplaires du recueil seront disponibles à l'achat au coût de </span><strong style=\"color: rgb(0, 0, 0);\">35 $</strong><span style=\"color: rgb(0, 0, 0);\">, taxes incluses.</span></p><p><br></p><p><em style=\"color: rgb(0, 0, 0);\">Traveler's Faith</em><span style=\"color: rgb(0, 0, 0);\"> est publié par DEEWEE 2026 et distribué par Antenne Books &amp; DEEWEE.</span></p><p><em style=\"color: rgb(0, 0, 0);\">Deep Fried </em><span style=\"color: rgb(0, 0, 0);\">a été réalisé avec le soutien du Conseil des arts et des lettres du Québec et du Conseil des arts du Canada. </span></p><p><br></p><p><span style=\"color: rgb(0, 0, 0);\">Photo : Nadine Fraczkowski</span></p><p><span style=\"color: rgb(0, 0, 0);\">Design : Gio Murolo</span></p><p><br></p><p><span style=\"color: rgb(0, 0, 0);\">Tarif d’entrée : 10 $ </span></p>"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en",
        "@value": "Marie Davidson - Traveler’s Faith"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://festivalphenomena.tuxedobillet.com/Web/lancement-travelers-faith-marie-davidson"
      }
    ]
  },
