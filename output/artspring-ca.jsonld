  {
    "@id": "https://artspring.ca/genid/3678799bb15b5f5c",
    "@type": [
      "https://schema.org/WebPage"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://artspring.ca/event/water-words/"
