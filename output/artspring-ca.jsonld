  {
    "@id": "https://artspring.ca/genid/4572b541a4c716ff",
    "@type": [
      "https://schema.org/WebPage"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://artspring.ca/event/sweetgrassshowcase/"
