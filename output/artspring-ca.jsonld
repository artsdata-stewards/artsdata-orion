    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "The Magic of Nature presented by Thomas Hyslop"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>&nbsp; Thomas Hyslop is a local artist, aged 12 years old. His photography originates from curiosity and interest in the world around us, and ranges from dramatic day and night-time skies to beautiful flowers and shells. This is his first exhibition, and most of his photographs were taken here on Salt Spring Island.</p>\\n"
      }
    ],
