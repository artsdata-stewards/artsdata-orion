  {
    "@id": "https://artspring.ca/genid/1f5b1204fe253a1e",
    "@type": [
      "https://schema.org/WebPage"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://artspring.ca/event/makana-youth-choirs-fall-term-2026/"
