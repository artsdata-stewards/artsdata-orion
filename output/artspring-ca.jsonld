    "https://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Water Words | Mouat’s Family Series - ArtSpring"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "While some performances are aimed squarely at younger audiences, this colourful, flowing and thought-provoking experience engages children and adults alike, as it invites us all to reflect on how water shapes our lives, communities, and identities."
      }
    ],
