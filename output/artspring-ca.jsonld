    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;&nbsp; To Have a Face explores the tension between visibility and vulnerability. The face—our first site of encounter—acts as both a mask and a mirror, an invitation into the vastness [&hellip;]&lt;/p&gt;\\n"
      }
