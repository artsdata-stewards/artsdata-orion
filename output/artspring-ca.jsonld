  {
    "@id": "https://artspring.ca/genid/c2dca119841c5155",
    "@type": [
      "https://schema.org/WebPage"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://artspring.ca/event/salt-spring-film-festival-presents-have-you-heard-judi-singh/"
