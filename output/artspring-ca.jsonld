  {
    "@id": "https://artspring.ca/genid/3a2c15bc0fb0714d",
    "@type": [
      "https://schema.org/WebPage"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://artspring.ca/event/ssi-spinners-weavers-fall-exhibition-sale/"
