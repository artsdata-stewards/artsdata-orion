  {
    "@id": "https://artspring.ca/genid/ae3ad6c6ada37715",
    "@type": [
      "https://schema.org/WebPage"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://artspring.ca/event/the-comic-strippers-2026/"
