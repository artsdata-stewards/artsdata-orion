  {
    "@id": "https://artspring.ca/genid/14d22a54b8e7c2fe",
    "@type": [
      "https://schema.org/WebPage"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://artspring.ca/event/salt-spring-film-festival-presents-marlee-matlin-not-alone-anymore/"
