      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>&nbsp; Fiercely independent journalist Amy Goodman has spent three decades holding the powerful to account, reporting from war zones to the Democracy Now! newsroom. Steal This Story, Please! crafts a riveting portrait of journalism’s power—and peril—in an era of corporate control and political attacks on truth. BUY TICKETS</p>\\n"
      }
