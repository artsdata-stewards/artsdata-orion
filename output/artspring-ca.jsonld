  {
    "@id": "https://artspring.ca/genid/960c26a5eeb8674f",
    "@type": [
      "https://schema.org/WebPage"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://artspring.ca/event/pacific-baroque-orchestra-goldberg-variations/"
