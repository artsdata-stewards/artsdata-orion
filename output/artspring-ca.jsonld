    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;ArtSpring is an 11,800 square-foot, two-level heavy timber structure boasting a 5,200-square-foot exhibition/ multi- purpose area and a 6,600-square-foot, 265-seat theatre.&lt;/p&gt;\\n"
