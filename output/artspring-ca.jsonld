  {
    "@id": "https://artspring.ca/genid/876486f07c168449",
    "@type": [
      "https://schema.org/WebPage"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://artspring.ca/event/the-flame-storytelling-slam-submissions-now-open/"
