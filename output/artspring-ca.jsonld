    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "<p>&nbsp; Daryl Chonka and Daniel Howlett reunite for their first duo performance in over a decade, sharing songs from Daryl’s new album, HOME. Join them at ArtSpring for an intimate evening of music, presented in two sets with an intermission. Doors open at 7:00 p.m. First set: 7:30–8:30 p.m. Intermission: 8:30–9:00 p.m. Second set: 9:00–10:00 [&hellip;]</p>\\n"
      }
