    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Brushstrokes in conversation: A joint exhibition by two friends."
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;This show grew out of friendship, curiosity, and plenty of paint. Brushstrokes in Conversation, celebrates the creative exchange between two artists who paint, laugh, learn, and explore together. The collection [&hellip;]&lt;/p&gt;\\n"
