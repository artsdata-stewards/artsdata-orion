    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "&lt;p&gt;Tue Nov 4, 7:30pm | A meeting of musical worlds, 88 Strings is a remarkable Canadian quartet that blends Chinese, Persian, and Western plucked string instruments into a mesmerizing soundscape. [&hellip;]&lt;/p&gt;\\n"
