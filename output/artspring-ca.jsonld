  {
    "@id": "https://artspring.ca/genid/976054ccdc185390",
    "@type": [
      "https://schema.org/WebPage"
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://artspring.ca/event/tower-of-song/"
