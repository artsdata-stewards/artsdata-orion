        "@value": "\n\t\t\n\t\n\t\t\t\t\t\t\n\t\t\n\n\t\t\t\n\t\n\t  \n          \n        \n      \n    \n\n    Mon Nov 30, 2026 • 7:30pm\n\n  \n          Theatre\n    \n          Play\n      \n\n  Event length: 90 minutes\n\n      Adult $45.00 | Student $25.00\n    \n      Ticket prices include all taxes and fees.\n    \n  \n\n\n      \n  \n    Buy tickets\n  \n\n  \n  \n  \n  \n\n\n\t\n\t\t\n\t\n\n\n\t\n\t\t\t\t\t\t\n\t\t\n\n\t\t\t\n\t\n\t  \n    \n      \n                  TNB: To Every Thing There is a Season\n        \n                  \n            Adult $45 || Student $25.00 ||\nAdapted by NB Playwright Ryan Griffith from Alistair MacLeod’s classic 1977 short story,\nTo Every Thing There is a Season tells the story of four siblings who recall one Christmas, long ago,\nwhen their family changed forever. Set in Inverness County, Cape Breton, the show features\ntraditional and original Celtic music, and the poetic language and haunting characters\nboth Alistair and Ryan are celebrated for. Theatre\nNew Brunswick’s first Christmas\nproduction in several years is a timeless love letter to Maritime families and holiday traditions.\n          \n        \n              \n\n      \n  \n    Event Info\n\n          \n        Category: Theatre      \n    \n          \n        Genre: Play      \n    \n          \n        Event Length: 90 minutes\n      \n    \n      \n  \n  \t\t\n\n\n      \n      Venue\n\n              Imperial Theatre\n      \n              12 King Square South, Saint John NB, E2L 5B8\n      \n              \n          \n            View on Google Maps\n          \n        \n          \n  \n  \n\n\n\n{\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"Event\",\n    \"@id\": \"https://imperialtheatre.ca/event/tnb-to-every-thing-there-is-a-season/49001AHJBVTCVBRMRMLMCJSNSSQLBRQJR/#event-49001ahjbvtcvbrmrmlmcjsnssqlbrqjr\",\n    \"name\": \"TNB: To Every Thing There is a Season\",\n    \"url\": \"https://imperialtheatre.ca/event/tnb-to-every-thing-there-is-a-season/49001AHJBVTCVBRMRMLMCJSNSSQLBRQJR/\",\n    \"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",\n    \"eventStatus\": \"https://schema.org/EventScheduled\",\n    \"location\": {\n        \"@type\": \"Place\",\n        \"name\": \"Imperial Theatre\",\n        \"sameAs\": [\n            \"http://kg.artsdata.ca/resource/K11-193\",\n            \"http://www.wikidata.org/entity/Q3527482\"\n        ],\n        \"address\": {\n            \"@type\": \"PostalAddress\",\n            \"streetAddress\": \"12 King Square South\",\n            \"addressLocality\": \"Saint John\",\n            \"postalCode\": \"E2L 5B8\",\n            \"addressRegion\": \"New Brunswick\",\n            \"addressCountry\": {\n                \"@type\": \"Country\",\n                \"name\": \"CA\"\n            }\n        }\n    },\n    \"organizer\": {\n        \"@type\": \"Organization\",\n        \"name\": \"Imperial Theatre\",\n        \"url\": \"https://imperialtheatre.ca/\"\n    },\n    \"description\": \"Adult $45 || Student $25.00 || Adapted by NB Playwright Ryan Griffith from Alistair MacLeod’s classic 1977 short story, To Every Thing There is a Season tells the story of four siblings who recall one Christmas, long ago, when their family changed forever. Set in Inverness County, Cape Breton, the show features traditional and original Celtic music, and the poetic language and haunting characters both Alistair and Ryan are celebrated for. Theatre New Brunswick’s first Christmas production in several years is a timeless love letter to Maritime families and holiday traditions.\",\n    \"image\": [\n        \"https://system.spektrix.com/imperialtheatrenewbrunswick/files/44028d87-b8be-4dc9-99eb-4a46331f4640.jpg\"\n    ],\n    \"startDate\": \"2026-11-30T19:30:00-04:00\",\n    \"offers\": {\n        \"@type\": \"Offer\",\n        \"url\": \"https://imperialtheatrenewbrunswick.spektrix.com/imperialtheatrenewbrunswick/website/EventDetails.aspx?EventId=49001AHJBVTCVBRMRMLMCJSNSSQLBRQJR\",\n        \"availability\": \"https://schema.org/InStock\",\n        \"validFrom\": \"2026-11-30T19:30:00-04:00\"\n    },\n    \"performer\": {\n        \"@type\": \"Thing\",\n        \"additionalType\": [\n            \"http://dbpedia.org/ontology/Agent\",\n            \"http://xmlns.com/foaf/0.1/Agent\"\n        ],\n        \"name\": \"TNB: To Every Thing There is a Season\"\n    }\n}\n\n\n\n\n\t\n\t\t\n\t\n\n\t"
      }
