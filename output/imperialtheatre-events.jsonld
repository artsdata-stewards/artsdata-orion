    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "\n\t\t\n\t\n\t\t\t\t\t\t\n\t\t\n\n\t\t\t\n\t\n\t  \n          \n        \n      \n    \n\n    Sat Jan 23, 2027 • 7:30pm\n\n  \n          Music\n    \n          Trad\n      \n\n  Event length: 90 minutes\n\n      Admission $40.00\n    \n      Ticket prices include all taxes and fees.\n    \n  \n\n\n      \n  \n    Buy tickets\n  \n\n      \n      IT Member Event\n    \n  \n  \n  \n  \n\n\n\t\n\t\t\n\t\n\n\n\t\n\t\t\t\t\t\t\n\t\t\n\n\t\t\t\n\t\n\t  \n    \n      \n                  Puuluup\n        \n                  \n            $40 Regular || $35 Member ||\nPuuluup (Estonian pronunciation: [ˈpuːluːp]) are an Estonian nu-folk duo that was established in 2014 by Ramo Teder [et] (a.k.a. Pastacas) and Marko Veisson [et].\nIn November 2023, they were announced alongside 5 miinust as one of the semi-finalists of Eesti Laul 2024, the Estonian selection for the Eurovision Song Contest 2024, with the song \"\"(Nendest) narkootikumidest ei tea me (küll) midagi\"\". They qualified for the final during the first round of the semi-final. They ultimately won the final and represented Estonia at the contest. At Eurovision they were drawn to compete in the second semi-final, where they placed sixth out of 16 with 79 points, qualifying to the final, where they placed 20th out of 26 with 37 points.\"\n          \n        \n              \n\n      \n  \n    Event Info\n\n          \n        Category: Music      \n    \n          \n        Genre: Trad      \n    \n          \n        Event Length: 90 minutes\n      \n    \n      \n  \n  \t\t\n\n\n      \n      Venue\n\n              Imperial Theatre\n      \n              12 King Square South, Saint John NB, E2L 5B8\n      \n              \n          \n            View on Google Maps\n          \n        \n          \n  \n      \n        \n          \n        Season Sponsor\n              \n    \n    \n      \n      \n  \n\n\n\n{\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"Event\",\n    \"@id\": \"https://imperialtheatre.ca/event/puuluup/39001AMGJLTQNTKSVBHSJCGGLBSSLLVJK/#event-39001amgjltqntksvbhsjcgglbssllvjk\",\n    \"name\": \"Puuluup\",\n    \"url\": \"https://imperialtheatre.ca/event/puuluup/39001AMGJLTQNTKSVBHSJCGGLBSSLLVJK/\",\n    \"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",\n    \"eventStatus\": \"https://schema.org/EventScheduled\",\n    \"location\": {\n        \"@type\": \"Place\",\n        \"name\": \"Imperial Theatre\",\n        \"sameAs\": [\n            \"http://kg.artsdata.ca/resource/K11-193\",\n            \"http://www.wikidata.org/entity/Q3527482\"\n        ],\n        \"address\": {\n            \"@type\": \"PostalAddress\",\n            \"streetAddress\": \"12 King Square South\",\n            \"addressLocality\": \"Saint John\",\n            \"postalCode\": \"E2L 5B8\",\n            \"addressRegion\": \"New Brunswick\",\n            \"addressCountry\": {\n                \"@type\": \"Country\",\n                \"name\": \"CA\"\n            }\n        }\n    },\n    \"organizer\": {\n        \"@type\": \"Organization\",\n        \"name\": \"Imperial Theatre\",\n        \"url\": \"https://imperialtheatre.ca/\"\n    },\n    \"description\": \"$40 Regular || $35 Member || Puuluup (Estonian pronunciation: [ˈpuːluːp]) are an Estonian nu-folk duo that was established in 2014 by Ramo Teder [et] (a.k.a. Pastacas) and Marko Veisson [et]. In November 2023, they were announced alongside 5 miinust as one of the semi-finalists of Eesti Laul 2024, the Estonian selection for the Eurovision Song Contest 2024, with the song \\\"\\\"(Nendest) narkootikumidest ei tea me (küll) midagi\\\"\\\". They qualified for the final during the first round of the semi-final. They ultimately won the final and represented Estonia at the contest. At Eurovision they were drawn to compete in the second semi-final, where they placed sixth out of 16 with 79 points, qualifying to the final, where they placed 20th out of 26 with 37 points.\\\"\",\n    \"image\": [\n        \"https://system.spektrix.com/imperialtheatrenewbrunswick/files/2ad67dad-0806-4240-a5be-8ebb0552ca3a.jpg\"\n    ],\n    \"startDate\": \"2027-01-23T19:30:00-04:00\",\n    \"offers\": {\n        \"@type\": \"Offer\",\n        \"url\": \"https://imperialtheatrenewbrunswick.spektrix.com/imperialtheatrenewbrunswick/website/EventDetails.aspx?EventId=39001AMGJLTQNTKSVBHSJCGGLBSSLLVJK\",\n        \"availability\": \"https://schema.org/InStock\",\n        \"validFrom\": \"2027-01-23T19:30:00-04:00\"\n    },\n    \"performer\": {\n        \"@type\": \"Thing\",\n        \"additionalType\": [\n            \"http://dbpedia.org/ontology/Agent\",\n            \"http://xmlns.com/foaf/0.1/Agent\"\n        ],\n        \"name\": \"Puuluup\"\n    }\n}\n\n\n\n\n\t\n\t\t\n\t\n\n\t"
