        "@language": "en",
        "@value": "\n\t\t\n\t\n\t\t\t\t\t\t\n\t\t\n\n\t\t\t\n\t\n\t  \n          \n        \n      \n    \n\n    Fri Feb 5, 2027 • 7:00pm\n\n  \n          Dance\n    \n          Outreach\n      \n\n  Event length: 90 minutes\n\n      Admission $10.00\n    \n      Ticket prices include all taxes and fees.\n    \n  \n\n\n      \n  \n    Buy tickets\n  \n\n  \n  \n  \n  \n\n\n\t\n\t\t\n\t\n\n\n\t\n\t\t\t\t\t\t\n\t\t\n\n\t\t\t\n\t\n\t  \n    \n      \n                  Movement for Wellness\n        \n                  \n            Patrons of all ages are invited to join Sarah Power from Connection Dance Works and shake off the winter blues on stage in a 90-minute Movement For Wellness workshop.  *Features elements of yoga, contemporary dance, and authentic movement. Capacity: 30 people\n          \n        \n              \n\n      \n  \n    Event Info\n\n          \n        Category: Dance      \n    \n          \n        Genre: Outreach      \n    \n          \n        Event Length: 90 minutes\n      \n    \n      \n  \n  \t\t\n\n\n      \n      Venue\n\n              Imperial Theatre\n      \n              12 King Square South, Saint John NB, E2L 5B8\n      \n              \n          \n            View on Google Maps\n          \n        \n          \n  \n  \n\n\n\n{\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"Event\",\n    \"@id\": \"https://imperialtheatre.ca/event/movement-for-wellness/51801AMMMQBBLVKCCNBKCBSKVNJHHMGKP/#event-51801ammmqbblvkccnbkcbskvnjhhmgkp\",\n    \"name\": \"Movement for Wellness\",\n    \"url\": \"https://imperialtheatre.ca/event/movement-for-wellness/51801AMMMQBBLVKCCNBKCBSKVNJHHMGKP/\",\n    \"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",\n    \"eventStatus\": \"https://schema.org/EventScheduled\",\n    \"location\": {\n        \"@type\": \"Place\",\n        \"name\": \"Imperial Theatre\",\n        \"sameAs\": [\n            \"http://kg.artsdata.ca/resource/K11-193\",\n            \"http://www.wikidata.org/entity/Q3527482\"\n        ],\n        \"address\": {\n            \"@type\": \"PostalAddress\",\n            \"streetAddress\": \"12 King Square South\",\n            \"addressLocality\": \"Saint John\",\n            \"postalCode\": \"E2L 5B8\",\n            \"addressRegion\": \"New Brunswick\",\n            \"addressCountry\": {\n                \"@type\": \"Country\",\n                \"name\": \"CA\"\n            }\n        }\n    },\n    \"organizer\": {\n        \"@type\": \"Organization\",\n        \"name\": \"Imperial Theatre\",\n        \"url\": \"https://imperialtheatre.ca/\"\n    },\n    \"description\": \"$10.00 // Patrons of all ages are invited to join Sarah Power from Connection Dance Works and shake off the winter blues on stage in a 90-minute Movement For Wellness workshop. *Features elements of yoga, contemporary dance, and authentic movement. Capacity: 30 people\",\n    \"image\": [\n        \"https://system.spektrix.com/imperialtheatrenewbrunswick/files/8740bd95-6523-4beb-bb7a-72958cec709c.jpg\"\n    ],\n    \"startDate\": \"2027-02-05T19:00:00-04:00\",\n    \"offers\": {\n        \"@type\": \"Offer\",\n        \"url\": \"https://imperialtheatrenewbrunswick.spektrix.com/imperialtheatrenewbrunswick/website/EventDetails.aspx?EventId=51801AMMMQBBLVKCCNBKCBSKVNJHHMGKP\",\n        \"availability\": \"https://schema.org/InStock\",\n        \"validFrom\": \"2027-02-05T19:00:00-04:00\"\n    },\n    \"performer\": {\n        \"@type\": \"Thing\",\n        \"additionalType\": [\n            \"http://dbpedia.org/ontology/Agent\",\n            \"http://xmlns.com/foaf/0.1/Agent\"\n        ],\n        \"name\": \"Movement for Wellness\"\n    }\n}\n\n\n\n\n\t\n\t\t\n\t\n\n\t"
