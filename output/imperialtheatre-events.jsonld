    "https://schema.org/mainContentOfPage": [
      {
        "@language": "en",
        "@value": "\n\n\t\t\n\n\t\n\t\t\n\t\t\t\n\n\t\t\t\n\t\t\n\t\n\t\t\t\t\t\t\n\t\t\n\n\t\t\t\n\t\n\t  \n          \n        \n      \n    \n\n    Thu Dec 17, 2026 • 7:30pm\n\n  \n          Comedy\n    \n          Stand Up\n      \n\n  Event length: 120 minutes\n\n      Admission $45.25\n    \n      Ticket prices include all taxes and fees.\n    \n  \n\n\n      \n  \n    Buy tickets\n  \n\n  \n  \n  \n  \n\n\n\t\n\t\t\n\t\n\n\n\t\n\t\t\t\t\t\t\n\t\t\n\n\t\t\t\n\t\n\t  \n    \n      \n                  James Mullinger - Canadian Comedian Live!\n        \n                  \n            \n\tThe Final Night Of The Award-Winning British-Canadian Comedian’s 2026 Tour! A Canadian Christmas Comedy Spectacular in James Mullinger’s beloved Saint John with special guests. “James Mullinger is Britain’s greatest gift to Canadian comedy.” Montreal Times “James Mullinger has the audience laughing uproariously.” The Globe & Mail James Mullinger returns to the historic Imperial Theatre for the first time in almost three years, ending his national tour with a huge Christmas celebration in his home city. After twelve years of living in Saint John, he loves this place more than ever, and there is nowhere he would rather wrap up a fifty-four date cross Canada tour. Join him on Thursday 17 December for a festive night of stand up comedy filled with brand new material and stories from a year spent travelling the country, learning the joys and disasters of performing in every province, and navigating life, work, family and fun. This final performance of James’s tour is his Christmas gift to the city that has given him everything. It is the perfect seasonal night out for couples, friends, colleagues and comedy lovers. Come celebrate Christmas with James and enjoy a night of big laughs in one of the most beautiful theatres in the country. It’s a Very Mullinger Christmas at the Imperial… Be sure to book early before it sells out.\n\n          \n        \n              \n\n      \n  \n    Event Info\n\n          \n        Category: Comedy      \n    \n          \n        Genre: Stand Up      \n    \n          \n        Event Length: 120 minutes\n      \n    \n      \n  \n  \t\t\n\n\n      \n      Venue\n\n              Imperial Theatre\n      \n              12 King Square South, Saint John NB, E2L 5B8\n      \n              \n          \n            View on Google Maps\n          \n        \n          \n  \n  \n\n\n\n{\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"Event\",\n    \"@id\": \"https://imperialtheatre.ca/event/james-mullinger-canadian-comedian-live/19601ASQHGTDLVRHPVGMRMDVHLHMGNGQV/#event-19601asqhgtdlvrhpvgmrmdvhlhmgngqv\",\n    \"name\": \"James Mullinger - Canadian Comedian Live!\",\n    \"url\": \"https://imperialtheatre.ca/event/james-mullinger-canadian-comedian-live/19601ASQHGTDLVRHPVGMRMDVHLHMGNGQV/\",\n    \"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",\n    \"eventStatus\": \"https://schema.org/EventScheduled\",\n    \"location\": {\n        \"@type\": \"Place\",\n        \"name\": \"Imperial Theatre\",\n        \"sameAs\": [\n            \"http://kg.artsdata.ca/resource/K11-193\",\n            \"http://www.wikidata.org/entity/Q3527482\"\n        ],\n        \"address\": {\n            \"@type\": \"PostalAddress\",\n            \"streetAddress\": \"12 King Square South\",\n            \"addressLocality\": \"Saint John\",\n            \"postalCode\": \"E2L 5B8\",\n            \"addressRegion\": \"New Brunswick\",\n            \"addressCountry\": {\n                \"@type\": \"Country\",\n                \"name\": \"CA\"\n            }\n        }\n    },\n    \"organizer\": {\n        \"@type\": \"Organization\",\n        \"name\": \"Imperial Theatre\",\n        \"url\": \"https://imperialtheatre.ca/\"\n    },\n    \"description\": \"$45.25 // The Final Night Of The Award-Winning British-Canadian Comedian’s 2026 Tour! A Canadian Christmas Comedy Spectacular in James Mullinger’s beloved Saint John with special guests. “James Mullinger is Britain’s greatest gift to Canadian comedy.” Montreal Times | “James Mullinger has the audience laughing uproariously.” The Globe & Mail | James Mullinger returns to the historic Imperial Theatre for the first time in almost three years, ending his national tour with a huge Christmas celebration in his home city. After twelve years of living in Saint John, he loves this place more than ever, and there is nowhere he would rather wrap up a fifty-four date cross Canada tour. Join him on Thursday 17 December for a festive night of stand up comedy filled with brand new material and stories from a year spent travelling the country, learning the joys and disasters of performing in every province, and navigating life, work, family and fun. This final performance of James’s tour is his Christmas gift to the city that has given him everything. It is the perfect seasonal night out for couples, friends, colleagues and comedy lovers. Come celebrate Christmas with James and enjoy a night of big laughs in one of the most beautiful theatres in the country. It’s a Very Mullinger Christmas at the Imperial… Be sure to book early before it sells out.\",\n    \"image\": [\n        \"https://system.spektrix.com/imperialtheatrenewbrunswick/files/f2c37324-f56e-4c70-9ac1-efda6004c232.jpg\"\n    ],\n    \"startDate\": \"2026-12-17T19:30:00-04:00\",\n    \"offers\": {\n        \"@type\": \"Offer\",\n        \"url\": \"https://imperialtheatrenewbrunswick.spektrix.com/imperialtheatrenewbrunswick/website/EventDetails.aspx?EventId=19601ASQHGTDLVRHPVGMRMDVHLHMGNGQV\",\n        \"availability\": \"https://schema.org/InStock\",\n        \"validFrom\": \"2026-12-17T19:30:00-04:00\"\n    },\n    \"performer\": {\n        \"@type\": \"Thing\",\n        \"additionalType\": [\n            \"http://dbpedia.org/ontology/Agent\",\n            \"http://xmlns.com/foaf/0.1/Agent\"\n        ],\n        \"name\": \"James Mullinger - Canadian Comedian Live!\"\n  