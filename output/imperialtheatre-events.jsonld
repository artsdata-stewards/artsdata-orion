    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://imperialtheatre.ca/event/smokey-mountain-songbird-tribute-to-dolly-parton/21601ATQCRBPJGGKQCSQSNJJDGKGBDPBP/"
      }
    ],
    "https://schema.org/mainContentOfPage": [
      {
        "@language": "en",
        "@value": "\n\n\t\t\n\n\t\n\t\t\n\t\t\t\n\n\t\t\t\n\t\t\n\t\n\t\t\t\t\t\t\n\t\t\n\n\t\t\t\n\t\n\t  \n          \n        \n      \n    \n\n    Sat Dec 5, 2026 • 7:30pm\n\n  \n          Music\n    \n          Tribute\n      \n\n  Event length: 120 minutes\n\n      Admission $56.25\n    \n      Ticket prices include all taxes and fees.\n    \n  \n\n\n      \n  \n    Buy tickets\n  \n\n  \n  \n  \n  \n\n\n\t\n\t\t\n\t\n\n\n\t\n\t\t\t\t\t\t\n\t\t\n\n\t\t\t\n\t\n\t  \n    \n      \n                  Smokey Mountain Songbird: Tribute to Dolly Parton\n        \n                  \n            \n\t$56.25 // TIME WARP PROMOTIONS PRESENTS SMOKEY MOUNTAIN SONGBIRD: TRIBUTE TO DOLLY PARTON. Newfoundland born vocalist \"Laurie Lynn\" began performing Country music at the age of 9, first performing in the Corner Brook Arts and Culture Center. Coming from a family that listened to Country music from dusk till dawn and beyond, Laurie Lynn felt totally connected to Dolly Parton as an individual and to her lyrics as relatable to her life. Over the course of her childhood and adolescent years, she performed on countless stages in Western Newfoundland before moving out of the province. After raising her children, she returned to performing once again, only this time, in tribute to to her childhood idol, \"Dolly Parton.\" \"It didn't matter which song I would sing, it could have been Willie Nelson, people always said, you sound like Dolly\". It’s been brought to Laurie Lynns attention many times, that her authentic vibrato voice, was remarkably similar to that of Dolly, and that her petite frame, witty sense of humor and one liners portrayed her naturally. \" I am a dreamer, so being able to perform on stage and tribute to whom I feel is the greatest female legend in country music, is truly a dream come true, it keeps my heart beating.\" Laurie Lynn is now an International Dolly Parton tribute artist, performing across Canada, USA and Mexico. If you are looking for a high-energy, fun-loving performance, that captures the essence of \"Dolly” Laurie Lynn as Dolly, Smoky Mountain Songbird will give you a nostalgic moment and leave you thoroughly entertained.WATCH HERE:  Dolly\n\n          \n        \n              \n\n      \n  \n    Event Info\n\n          \n        Category: Music      \n    \n          \n        Genre: Tribute      \n    \n          \n        Event Length: 120 minutes\n      \n    \n      \n  \n  \t  \t  \n    \tPerformer Website:\n    \t\n      Visit Website\n    \t\n      \n\t\t\n\n\n      \n      Venue\n\n              Imperial Theatre\n      \n              12 King Square South, Saint John NB, E2L 5B8\n      \n              \n          \n            View on Google Maps\n          \n        \n          \n  \n  \n\n\n\n{\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"Event\",\n    \"@id\": \"https://imperialtheatre.ca/event/smokey-mountain-songbird-tribute-to-dolly-parton/21601ATQCRBPJGGKQCSQSNJJDGKGBDPBP/#event-21601atqcrbpjggkqcsqsnjjdgkgbdpbp\",\n    \"name\": \"Smokey Mountain Songbird: Tribute to Dolly Parton\",\n    \"url\": \"https://imperialtheatre.ca/event/smokey-mountain-songbird-tribute-to-dolly-parton/21601ATQCRBPJGGKQCSQSNJJDGKGBDPBP/\",\n    \"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",\n    \"eventStatus\": \"https://schema.org/EventScheduled\",\n    \"location\": {\n        \"@type\": \"Place\",\n        \"name\": \"Imperial Theatre\",\n        \"sameAs\": [\n            \"http://kg.artsdata.ca/resource/K11-193\",\n            \"http://www.wikidata.org/entity/Q3527482\"\n        ],\n        \"address\": {\n            \"@type\": \"PostalAddress\",\n            \"streetAddress\": \"12 King Square South\",\n            \"addressLocality\": \"Saint John\",\n            \"postalCode\": \"E2L 5B8\",\n            \"addressRegion\": \"New Brunswick\",\n            \"addressCountry\": {\n                \"@type\": \"Country\",\n                \"name\": \"CA\"\n            }\n        }\n    },\n    \"organizer\": {\n        \"@type\": \"Organization\",\n        \"name\": \"Imperial Theatre\",\n        \"url\": \"https://imperialtheatre.ca/\"\n    },\n    \"description\": \"$56.25 // TIME WARP PROMOTIONS PRESENTS SMOKEY MOUNTAIN SONGBIRD: TRIBUTE TO DOLLY PARTON. Newfoundland born vocalist \\\"Laurie Lynn\\\" began performing Country music at the age of 9, first performing in the Corner Brook Arts and Culture Center. Coming from a family that listened to Country music from dusk till dawn and beyond, Laurie Lynn felt totally connected to Dolly Parton as an individual and to her lyrics as relatable to her life. Over the course of her childhood and adolescent years, she performed on countless stages in Western Newfoundland before moving out of the province. After raising her children, she returned to performing once again, only this time, in tribute to to her childhood idol, \\\"Dolly Parton.\\\" \\\"It didn't matter which song I would sing, it could have been Willie Nelson, people always said, you sound like Dolly\\\". It’s been brought to Laurie Lynns attention many times, that her authentic vibrato voice, was remarkably similar to that of Dolly, and that her petite frame, witty sense of humor and one liners portrayed her naturally. \\\" I am a dreamer, so being able to perform on stage and tribute to whom I feel is the greatest female legend in country music, is truly a dream come true, it keeps my heart beating.\\\" Laurie Lynn is now an International Dolly Parton tribute artist, performing across Canada, USA and Mexico. If you are looking for a high-energy, fun-loving performance, that captures the essence of \\\"Dolly” Laurie Lynn as Dolly, Smoky Mountain Songbird will give you a nostalgic moment and leave you thoroughly entertained.\",\n    \"image\": [\n        \"https://system.spektrix.com/imperialtheatrenewbrunswick/files/2c7a8f80-8994-49fc-85ca-dd6b5705a185.jpg\"\n    ],\n    \"startDate\": \"2026-12-05T19:30:00-04:00\",\n    \"offers\": {\n        \"@type\": \"Offer\",\n        \"url\": \"https://imperialtheatrenewbrunswick.spektrix.com/imperialtheatrenewbrunswick/website/EventDetails.aspx?EventId=21601ATQCRBPJGGKQCSQSNJJDGKGBDPBP\",\n        \"availability\": \"https://schema.org/InStock\",\n        \"validFrom\": \"2026-12-05T19:30:00-04:00\"\n    },\n    \"performer\": {\n        \"@type\": \"Thing\",\n        \"additionalType\": [\n            \"http://dbpedia.org/ontology/Agent\",\n            \"http://xmlns.com/foaf/0.1/Agent\"\n        ],\n        \"name\": \"Smokey Mountain Songbird: Tribute to Dolly Parton\"\n    }\n}\n\n\n\n\n\t\n\t\t\n\t\n\n\t\n\t\n\n\n\n\t\t\n\t\n\n\n\n\t"
      }
