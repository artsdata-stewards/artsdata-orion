flineEventAttendanceMode\",\n    \"eventStatus\": \"https://schema.org/EventScheduled\",\n    \"location\": {\n        \"@type\": \"Place\",\n        \"name\": \"Imperial Theatre\",\n        \"sameAs\": [\n            \"http://kg.artsdata.ca/resource/K11-193\",\n            \"http://www.wikidata.org/entity/Q3527482\"\n        ],\n        \"address\": {\n            \"@type\": \"PostalAddress\",\n            \"streetAddress\": \"12 King Square South\",\n            \"addressLocality\": \"Saint John\",\n            \"postalCode\": \"E2L 5B8\",\n            \"addressRegion\": \"New Brunswick\",\n            \"addressCountry\": {\n                \"@type\": \"Country\",\n                \"name\": \"CA\"\n            }\n        }\n    },\n    \"organizer\": {\n        \"@type\": \"Organization\",\n        \"name\": \"Imperial Theatre\",\n        \"url\": \"https://imperialtheatre.ca/\"\n    },\n    \"description\": \"5 PM - Charlie Brown Christmas 6 PM - Frosty the Snowman 7 PM - Mickey's Christmas Carol 8 PM - Rudolph the Red-Nosed Reindeer Member RSVP: up to 4 tickets // Join us for a free and fun night of holiday films! Every hour on the hour, we're going to show a different classic! IT Members can reserve up to four seats in our Member VIP section in the Balcony, and join us at Golding's Lounge in the Upper Lobby for treats. Stay for one film or stay for them all, then go enjoy all that Uptown Sparkles has to offer. [IT Members are welcome to sit on the Orchestra level, but it will be open to the public]\",\n    \"image\": [\n        \"https://system.spektrix.com/imperialtheatrenewbrunswick/files/25d2fdf1-9777-4bbb-bfa5-caa88c72e107.jpg\"\n    ],\n    \"startDate\": \"2026-12-04T17:00:00-04:00\",\n    \"offers\": {\n        \"@type\": \"Offer\",\n        \"url\": \"https://imperialtheatrenewbrunswick.spektrix.com/imperialtheatrenewbrunswick/website/EventDetails.aspx?EventId=44801AVQJMVSBSCDMRGLRKNLTGJPHPNQG\",\n        \"availability\": \"https://schema.org/InStock\"