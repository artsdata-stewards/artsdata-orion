        "@language": "en",
        "@value": "\n\n\t\t\n\n\t\n\t\t\n\t\t\t\n\n\t\t\t\n\t\t\n\t\n\t\t\t\t\t\t\n\t\t\n\n\t\t\t\n\t\n\t  \n          \n        \n      \n    \n\n    Thu Jan 21, 2027 • 7:00pm\n\n  \n          Film\n    \n          Screening\n      \n\n  Event length: 135 minutes\n\n      Admission $40.00\n    \n      Ticket prices include all taxes and fees.\n    \n  \n\n\n      \n  \n    Buy tickets\n  \n\n  \n  \n  \n  \n\n\n\t\n\t\t\n\t\n\n\n\t\n\t\t\t\t\t\t\n\t\t\n\n\t\t\t\n\t\n\t  \n    \n      \n                  Banff Centre Mountain Film Festival World Tour\n        \n                  \n            Hot on the heels of the Festival that is held every fall in beautiful Banff, Alberta, the Banff Centre Mountain Film Festival World Tour hits the road.\nWith stops planned in about 550 communities and more than 40 countries across the globe, the Banff World Tour celebrates amazing achievements in outdoor storytelling and filmmaking worldwide!\nJoin River & Trail when the Banff Centre Mountain Film Festival World Tour brings the spirit of outdoor adventure to Saint John, at the Imperial Theatre on January 21st, 2027 at 7:00PM.\nBe moved! Be inspired! Don’t miss out!\n          \n        \n              \n\n      \n  \n    Event Info\n\n          \n        Category: Film      \n    \n          \n        Genre: Screening      \n    \n          \n        Event Length: 135 minutes\n      \n    \n      \n  \n  \t\t\n\n\n      \n      Venue\n\n              Imperial Theatre\n      \n              12 King Square South, Saint John NB, E2L 5B8\n      \n              \n          \n            View on Google Maps\n          \n        \n          \n  \n  \n\n\n\n{\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"Event\",\n    \"@id\": \"https://imperialtheatre.ca/event/banff-centre-mountain-film-festival-world-tour/51401AJNDJJSCSRDMGDPMBDQVCNBMPCNB/#event-51401ajndjjscsrdmgdpmbdqvcnbmpcnb\",\n    \"name\": \"Banff Centre Mountain Film Festival World Tour\",\n    \"url\": \"https://imperialtheatre.ca/event/banff-centre-mountain-film-festival-world-tour/51401AJNDJJSCSRDMGDPMBDQVCNBMPCNB/\",\n    \"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",\n    \"eventStatus\": \"https://schema.org/EventScheduled\",\n    \"location\": {\n        \"@type\": \"Place\",\n        \"name\": \"Imperial Theatre\",\n        \"sameAs\": [\n            \"http://kg.artsdata.ca/resource/K11-193\",\n            \"http://www.wikidata.org/entity/Q3527482\"\n        ],\n        \"address\": {\n            \"@type\": \"PostalAddress\",\n            \"streetAddress\": \"12 King Square South\",\n            \"addressLocality\": \"Saint John\",\n            \"postalCode\": \"E2L 5B8\",\n            \"addressRegion\": \"New Brunswick\",\n            \"addressCountry\": {\n                \"@type\": \"Country\",\n                \"name\": \"CA\"\n            }\n        }\n    },\n    \"organizer\": {\n        \"@type\": \"Organization\",\n        \"name\": \"Imperial Theatre\",\n        \"url\": \"https://imperialtheatre.ca/\"\n    },\n    \"description\": \"$40.00 // Hot on the heels of the Festival that is held every fall in beautiful Banff, Alberta, the Banff Centre Mountain Film Festival World Tour hits the road. With stops planned in about 550 communities and more than 40 countries across the globe, the Banff World Tour celebrates amazing achievements in outdoor storytelling and filmmaking worldwide! Join River & Trail when the Banff Centre Mountain Film Festival World Tour brings the spirit of outdoor adventure to Saint John, at the Imperial Theatre on January 21st, 2027 at 7:00PM. Be moved! Be inspired! Don’t miss out!\",\n    \"image\": [\n        \"https://system.spektrix.com/imperialtheatrenewbrunswick/files/e1e51c07-0ece-4b15-9bed-26bd216f6b96.jpg\"\n    ],\n    \"startDate\": \"2027-01-21T19:00:00-04:00\",\n    \"offers\": {\n        \"@type\": \"Offer\",\n        \"url\": \"https://imperialtheatrenewbrunswick.spektrix.com/imperialtheatr