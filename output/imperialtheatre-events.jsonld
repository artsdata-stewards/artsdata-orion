    "https://schema.org/mainContentOfPage": [
      {
        "@language": "en",
        "@value": "\n\n\t\t\n\n\t\n\t\t\n\t\t\t\n\n\t\t\t\n\t\t\n\t\n\t\t\t\t\t\t\n\t\t\n\n\t\t\t\n\t\n\t  \n          \n        \n      \n    \n\n    Tue Jun 22, 2027 • 7:30pm\n\n  \n          Music\n    \n          Rock\n      \n\n  Event length: 125 minutes\n\n      Admission $66.25\n    \n      Ticket prices include all taxes and fees.\n    \n  \n\n\n      \n  \n    Buy tickets\n  \n\n  \n  \n  \n  \n\n\n\t\n\t\t\n\t\n\n\n\t\n\t\t\t\t\t\t\n\t\t\n\n\t\t\t\n\t\n\t  \n    \n      \n                  The Ultimate Tribute to CCR & John Fogerty - Mystic Highway\n        \n                  \n            VaughnCo Entertainment Proudly Presents\nThe Ultimate CCR & John Fogerty Tribute Show - MYSTIC HIGHWAY \nThe Ultimate CCR tribute experience, Mystic Highway brings the legendary music of Creedence Clearwater Revival and John Fogerty to life with remarkable authenticity, energy, and passion.\nFeaturing seasoned musician Gil Gaidola, whose powerful vocals and impressive guitar work capture the unmistakable sound and style of John Fogerty, Mystic Highway delivers the hits that defined a generation.\nFrom the opening chord to the final encore, audiences are treated to an electrifying, top-shelf live performance featuring outstanding musicianship, soaring vocals, keyboards, guitars, drums, and rich vocal harmonies. Relive the timeless classics, sing along to the unforgettable songs, and experience the music that continues to bring generations together.\nMystic Highway delivers an exceptional live entertainment experience that audiences won't soon forget.\nThe music! The memories! The magic of CCR! Get ready to take a trip back to the golden era of rock ’n’ roll!  \n          \n        \n              \n\n      \n  \n    Event Info\n\n          \n        Category: Music      \n    \n          \n        Genre: Rock      \n    \n          \n        Event Length: 125 minutes\n      \n    \n      \n  \n  \t\t\n\n\n      \n      Venue\n\n              Imperial Theatre\n      \n              12 King Square South, Saint John NB, E2L 5B8\n      \n              \n          \n            View on Google Maps\n          \n        \n          \n  \n  \n\n\n\n{\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"Event\",\n    \"@id\": \"https://imperialtheatre.ca/event/the-ultimate-tribute-to-ccr-john-fogerty-mystic-highway/50201AJQJMNKPVNTVBTBMSCMBRSMTGJSS/#event-50201ajqjmnkpvntvbtbmscmbrsmtgjss\",\n    \"name\": \"The Ultimate Tribute to CCR & John Fogerty - Mystic Highway\",\n    \"url\": \"https://imperialtheatre.ca/event/the-ultimate-tribute-to-ccr-john-fogerty-mystic-highway/50201AJQJMNKPVNTVBTBMSCMBRSMTGJSS/\",\n    \"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",\n    \"eventStatus\": \"https://schema.org/EventScheduled\",\n    \"location\": {\n        \"@type\": \"Place\",\n        \"name\": \"Imperial Theatre\",\n        \"sameAs\": [\n            \"http://kg.artsdata.ca/resource/K11-193\",\n            \"http://www.wikidata.org/entity/Q3527482\"\n        ],\n        \"address\": {\n            \"@type\": \"PostalAddress\",\n            \"streetAddress\": \"12 King Square South\",\n            \"addressLocality\": \"Saint John\",\n            \"postalCode\": \"E2L 5B8\",\n            \"addressRegion\": \"New Brunswick\",\n            \"addressCountry\": {\n                \"@type\": \"Country\",\n                \"name\": \"CA\"\n            }\n        }\n    },\n    \"organizer\": {\n        \"@type\": \"Organization\",\n        \"name\": \"Imperial Theatre\",\n        \"url\": \"https://imperialtheatre.ca/\"\n    },\n    \"description\": \"$66.25 // VaughnCo Entertainment Proudly Presents The Ultimate CCR & John Fogerty Tribute Show - MYSTIC HIGHWAY The Ultimate CCR tribute experience, Mystic Highway brings the legendary music of Creedence Clearwater Revival and John Fogerty to life with remarkable authenticity, energy, and passion. Featuring seasoned musician Gil Gaidola, whose powerful vocals and impressive guitar work capture the unmistakable sound and style of John Fogerty, Mystic Highway delivers the hits that defined a generation. From the opening chord to the final encore, audiences are treated to an electrifying, top-shelf live performance featuring outstanding musicianship, soaring vocals, keyboards, guitars, drums, and rich vocal harmonies. Relive the timeless classics, sing along to the unforgettable songs, and experience the music that continues to bring generations together. Mystic Highway delivers an exceptional live entertainment experience that audiences won't soon forget. The music! The memories! The magic of CCR! Get ready to take a trip back to the golden era of rock ’n’ roll!\",\n    \"image\": [\n        \"https://system.spektrix.com/imperialtheatrenewbrunswick/files/b44210b7-4e67-4884-b73f-27e5bcbf6827.jpg\"\n    ],\n    \"startDate\": \"2027-06-22T19:30:00-03:00\",\n    \"offers\": {\n        \"@type\": \"Offer\",\n        \"url\": \"https://imperialtheatrenewbrunswick.spektrix.com/imperialtheatrenewbrunswick/website/EventDetails.aspx?EventId=50201AJQJMNKPVNTVBTBMSCMBRSMTGJSS\",\n        \"availability\": \"https://schema.org/InStock\",\n        \"validFrom\": \"2027-06-22T19:30:00-03:00\"\n    },\n    \"performer\": {\n        \"@type\": \"Thing\",\n        \"additionalType\": [\n            \"http://dbpedia.org/ontology/Agent\",\n            \"http://xmlns.com/foaf/0.1/Agent\"\n        ],\n        \"name\": \"The Ultimate Tribute to CCR & John Fogerty - Mystic Highway\"\n    }\n}\n\n\n\n\n\t\n\t\t\n\t\n\n\t\n\t\n\n\n\n\t\t\n\t\n\n\n\n\t"
