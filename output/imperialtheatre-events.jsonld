    "https://schema.org/text": [
      {
        "@language": "en",
        "@value": "\n\t\t\n\t\n\t\t\t\t\t\t\n\t\t\n\n\t\t\t\n\t\n\t  \n          \n        \n      \n    \n\n    Wed Nov 25, 2026 • 7:30pm\n\n  \n          Theatre\n    \n          Musical\n      \n\n  Event length: 140 minutes\n\n      Adult $70.00 | Senior $65.00 | Student $40.00\n    \n      Ticket prices include all taxes and fees.\n    \n  \n\n\n      \n  \n    Buy tickets\n  \n\n  \n  \n  \n  \n\n\n\t\n\t\t\n\t\n\n\n\t\n\t\t\t\t\t\t\n\t\t\n\n\t\t\t\n\t\n\t  \n    \n      \n                  SJTC: Frozen\n        \n                  \n            \n\tFrozenExperience the magic of Frozen! Join Anna, Elsa, Olaf, and friends on an electrifying, heart-melting adventure packed with unforgettable songs, dazzling magic, and a celebration of sisterhood that will have you laughing, crying, and cheering all the way to the final note.Performances-Wednesday, November 25th, 2026 at 7:30pm-Thursday, November 26th, 2026 at 7:30pm-Friday, November 27th, 2026 at 7:30pm-Saturday, November 28th, 2026 at 2:00pm-Saturday, November 28th, 2026 at 7:30pmPurchase a SJTC Subscription and save 25% off single ticket prices!We are happy to hold prior season subscribers' seats until September 1st 2026. Single tickets on sale September 1st 2026 at noon.\n\n          \n        \n              \n\n      \n  \n    Event Info\n\n          \n        Category: Theatre      \n    \n          \n        Genre: Musical      \n    \n          \n        Event Length: 140 minutes\n      \n    \n      \n  \n  \t  \t  \n    \tPerformer Website:\n    \t\n      Visit Website\n    \t\n      \n\t\t\n\n\n      \n      Venue\n\n              Imperial Theatre\n      \n              12 King Square South, Saint John NB, E2L 5B8\n      \n              \n          \n            View on Google Maps\n          \n        \n          \n  \n  \n\n\n\n{\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"Event\",\n    \"@id\": \"https://imperialtheatre.ca/event/sjtc-frozen/29801AKHGBCBQNDCCBHCDGNPLGJBDMJSD/#event-29801akhgbcbqndccbhcdgnplgjbdmjsd\",\n    \"name\": \"SJTC: Frozen\",\n    \"url\": \"https://imperialtheatre.ca/event/sjtc-frozen/29801AKHGBCBQNDCCBHCDGNPLGJBDMJSD/\",\n    \"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",\n    \"eventStatus\": \"https://schema.org/EventScheduled\",\n    \"location\": {\n        \"@type\": \"Place\",\n        \"name\": \"Imperial Theatre\",\n        \"sameAs\": [\n            \"http://kg.artsdata.ca/resource/K11-193\",\n            \"http://www.wikidata.org/entity/Q3527482\"\n        ],\n        \"address\": {\n            \"@type\": \"PostalAddress\",\n            \"streetAddress\": \"12 King Square South\",\n            \"addressLocality\": \"Saint John\",\n            \"postalCode\": \"E2L 5B8\",\n            \"addressRegion\": \"New Brunswick\",\n            \"addressCountry\": {\n                \"@type\": \"Country\",\n                \"name\": \"CA\"\n            }\n        }\n    },\n    \"organizer\": {\n        \"@type\": \"Organization\",\n        \"name\": \"Imperial Theatre\",\n        \"url\": \"https://imperialtheatre.ca/\"\n    },\n    \"description\": \"$70 Regular | $65 Senior | $40 Student // Experience the magic of Frozen! Join Anna, Elsa, Olaf, and friends on an electrifying, heart-melting adventure packed with unforgettable songs, dazzling magic, and a celebration of sisterhood that will have you laughing, crying, and cheering all the way to the final note.\",\n    \"image\": [\n        \"https://system.spektrix.com/imperialtheatrenewbrunswick/files/88c4ea5c-cefc-4953-b018-9d227345beff.jpg\"\n    ],\n    \"startDate\": \"2026-11-25T19:30:00-04:00\",\n    \"offers\": {\n        \"@type\": \"Offer\",\n        \"url\": \"https://imperialtheatrenewbrunswick.spektrix.com/imperialtheatrenewbrunswick/website/EventDetails.aspx?EventId=29801AKHGBCBQNDCCBHCDGNPLGJBDMJSD\",\n        \"availability\": \"https://schema.org/InStock\",\n        \"validFrom\": \"2026-11-25T19:30:00-04:00\"\n    },\n    \"performer\": {\n        \"@type\": \"Thing\",\n        \"additionalType\": [\n            \"http://dbpedia.org/ontology/Agent\",\n            \"http://xmlns.com/foaf/0.1/Agent\"\n        ],\n        \"name\": \"SJTC: Frozen\"\n    }\n}\n\n\n\n\n\t\n\t\t\n\t\n\n\t"
