    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://imperialtheatre.ca/event/igniting-excellence-nbyo-live-in-saint-john/35401APNVLPNRJRDCGRRCTSSJTSMNRNQD/"
