    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Stadacona Band Holiday Tour"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "$0 [limit of 6] // The Longest Night, a holiday concert with the Stadacona Band of the Royal Canadian Navy With special guest Terra Spencer Celebrate the warmth and wonder of the holiday season with the Stadacona Band of the Royal Canadian Navy and acclaimed Nova Scotian singer-songwriter Terra Spencer. This festive concert brings together the rich sound of one of Canada's premier military bands with Terra's heartfelt storytelling, wit, and distinctive folk-inspired artistry. Featuring Christmas classics, locally inspired originals, and unique collaborative performances, this heartwarming concert celebrates the joy, wonder, and spirit of the season."
      }
    ],
