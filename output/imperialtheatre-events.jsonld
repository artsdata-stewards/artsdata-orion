        "@value": "\n\t\t\n\t\n\t\t\t\t\t\t\n\t\t\n\n\t\t\t\n\t\n\t  \n          \n        \n      \n    \n\n    Thu Dec 10, 2026 • 4:00pm\n\n  \n          Other\n    \n          Community\n      \n\n  Event length: 180 minutes\n\n  \n\n\n      \n  \n    Buy tickets\n  \n\n  \n  \n  \n  \n\n\n\t\n\t\t\n\t\n\n\n\t\n\t\t\t\t\t\t\n\t\t\n\n\t\t\t\n\t\n\t  \n    \n      \n                  Invisible Books' Holiday Book Market\n        \n                  \n            Get your holiday book buying done in style and with drink in hand. Join a selection of indie publishers and booksellers for a holiday book market at Imperial Theatre. We guarantee you'll find something for every reader on your list. // Faites vos achats du temps des fêtes tout en douceur, une boisson délicieuse à la main! Nous vous invitons à un marché du livre au Imperial Theatre, où vous retrouverez beaucoup maisons d’édition et librairies indépendantes. Il y aura sûrement de quoi pour tous les goûts de lecture sur votre liste!\n          \n        \n              \n\n      \n  \n    Event Info\n\n          \n        Category: Other      \n    \n          \n        Genre: Community      \n    \n          \n        Event Length: 180 minutes\n      \n    \n      \n  \n  \t\t\n\n\n      \n      Venue\n\n              Imperial Theatre\n      \n              12 King Square South, Saint John NB, E2L 5B8\n      \n              \n          \n            View on Google Maps\n          \n        \n          \n  \n  \n\n\n\n{\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"Event\",\n    \"@id\": \"https://imperialtheatre.ca/event/invisible-books-holiday-book-market/51001ARVGTVPPNTBQGVCQJBVQPDQSJLSM/#event-51001arvgtvppntbqgvcqjbvqpdqsjlsm\",\n    \"name\": \"Invisible Books' Holiday Book Market\",\n    \"url\": \"https://imperialtheatre.ca/event/invisible-books-holiday-book-market/51001ARVGTVPPNTBQGVCQJBVQPDQSJLSM/\",\n    \"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",\n    \"eventStatus\": \"https://schema.org/EventScheduled\",\n    \"location\": {\n        \"@type\": \"Place\",\n        \"name\": \"Imperial Theatre\",\n        \"sameAs\": [\n            \"http://kg.artsdata.ca/resource/K11-193\",\n            \"http://www.wikidata.org/entity/Q3527482\"\n        ],\n        \"address\": {\n            \"@type\": \"PostalAddress\",\n            \"streetAddress\": \"12 King Square South\",\n            \"addressLocality\": \"Saint John\",\n            \"postalCode\": \"E2L 5B8\",\n            \"addressRegion\": \"New Brunswick\",\n            \"addressCountry\": {\n                \"@type\": \"Country\",\n                \"name\": \"CA\"\n            }\n        }\n    },\n    \"organizer\": {\n        \"@type\": \"Organization\",\n        \"name\": \"Imperial Theatre\",\n        \"url\": \"https://imperialtheatre.ca/\"\n    },\n    \"description\": \"Get your holiday book buying done in style and with drink in hand. Join a selection of indie publishers and booksellers for a holiday book market at Imperial Theatre. We guarantee you'll find something for every reader on your list. // Faites vos achats du temps des fêtes tout en douceur, une boisson délicieuse à la main! Nous vous invitons à un marché du livre au Imperial Theatre, où vous retrouverez beaucoup maisons d’édition et librairies indépendantes. Il y aura sûrement de quoi pour tous les goûts de lecture sur votre liste!\",\n    \"image\": [\n        \"https://system.spektrix.com/imperialtheatrenewbrunswick/files/711d25fc-5d9b-4084-9a58-481e56d06388.jpg\"\n    ],\n    \"startDate\": \"2026-12-10T16:00:00-04:00\",\n    \"offers\": {\n        \"@type\": \"Offer\",\n        \"url\": \"https://imperialtheatrenewbrunswick.spektrix.com/imperialtheatrenewbrunswick/website/EventDetails.aspx?EventId=51001ARVGTVPPNTBQGVCQJBVQPDQSJLSM\",\n        \"availability\": \"https://schema.org/InStock\",\n        \"validFrom\": \"2026-12-10T16:00:00-04:00\"\n    },\n    \"performer\": {\n        \"@ty