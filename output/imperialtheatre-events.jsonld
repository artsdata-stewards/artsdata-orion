        "@id": "https://system.spektrix.com/imperialtheatrenewbrunswick/files/2c7a8f80-8994-49fc-85ca-dd6b5705a185.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
