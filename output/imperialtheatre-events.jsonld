        "@language": "en",
        "@value": "\n\t\t\n\t\n\t\t\t\t\t\t\n\t\t\n\n\t\t\t\n\t\n\t  \n          \n        \n      \n    \n\n    Sat May 8, 2027 • 6:00pm\n\n  \n          Music\n    \n          Pop\n      \n\n  Event length: 105 minutes\n\n      Adult $50.00 | Youth $30.00\n    \n      Ticket prices include all taxes and fees.\n    \n  \n\n\n      \n  \n    Buy tickets\n  \n\n      \n      IT Member Event\n    \n  \n  \n  \n  \n\n\n\t\n\t\t\n\t\n\n\n\t\n\t\t\t\t\t\t\n\t\t\n\n\t\t\t\n\t\n\t  \n    \n      \n                  K-Hunters: The Show\n        \n                  \n            $50 Regular || $45 Member || $30 Youth ||\nK-Hunters: The Show is a live K-pop tribute concert produced by Productions Alter-Ego, inspired by the animated sensation K-Pop Demon Hunters. The 45-minute show features professional singers, high-energy choreography, and no lip-syncing. It’s a family-friendly event featuring hits from popular K-pop groups.\n          \n        \n              \n\n      \n  \n    Event Info\n\n          \n        Category: Music      \n    \n          \n        Genre: Pop      \n    \n          \n        Event Length: 105 minutes\n      \n    \n      \n  \n  \t\t\n\n\n      \n      Venue\n\n              Imperial Theatre\n      \n              12 King Square South, Saint John NB, E2L 5B8\n      \n              \n          \n            View on Google Maps\n          \n        \n          \n  \n      \n        \n          \n        Season Sponsor\n              \n    \n    \n          \n        Event Sponsor\n        \n                                        \n      \n      \n      \n  \n\n\n\n{\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"Event\",\n    \"@id\": \"https://imperialtheatre.ca/event/k-hunters-the-show/44001AKHDCPNJVQSMNLNQHNSSDQNDPLVJ/#event-44001akhdcpnjvqsmnlnqhnssdqndplvj\",\n    \"name\": \"K-Hunters: The Show\",\n    \"url\": \"https://imperialtheatre.ca/event/k-hunters-the-show/44001AKHDCPNJVQSMNLNQHNSSDQNDPLVJ/\",\n    \"eventAttendanceMode\": \"https://schema.org/OfflineEventAttendanceMode\",\n    \"eventStatus\": \"https://schema.org/EventScheduled\",\n    \"location\": {\n        \"@type\": \"Place\",\n        \"name\": \"Imperial Theatre\",\n        \"sameAs\": [\n            \"http://kg.artsdata.ca/resource/K11-193\",\n            \"http://www.wikidata.org/entity/Q3527482\"\n        ],\n        \"address\": {\n            \"@type\": \"PostalAddress\",\n            \"streetAddress\": \"12 King Square South\",\n            \"addressLocality\": \"Saint John\",\n            \"postalCode\": \"E2L 5B8\",\n            \"addressRegion\": \"New Brunswick\",\n            \"addressCountry\": {\n                \"@type\": \"Country\",\n                \"name\": \"CA\"\n            }\n        }\n    },\n    \"organizer\": {\n        \"@type\": \"Organization\",\n        \"name\": \"Imperial Theatre\",\n        \"url\": \"https://imperialtheatre.ca/\"\n    },\n    \"description\": \"$50 Regular || $45 Member || $30 Youth || K-Hunters: The Show is a live K-pop tribute concert produced by Productions Alter-Ego, inspired by the animated sensation K-Pop Demon Hunters. The 45-minute show features professional singers, high-energy choreography, and no lip-syncing. It’s a family-friendly event featuring hits from popular K-pop groups.\",\n    \"image\": [\n        \"https://system.spektrix.com/imperialtheatrenewbrunswick/files/d00d3d33-7048-41ef-9f43-252fd0894169.jpg\"\n    ],\n    \"startDate\": \"2027-05-08T18:00:00-03:00\",\n    \"offers\": {\n        \"@type\": \"Offer\",\n        \"url\": \"https://imperialtheatrenewbrunswick.spektrix.com/imperialtheatrenewbrunswick/website/EventDetails.aspx?EventId=44001AKHDCPNJVQSMNLNQHNSSDQNDPLVJ\",\n        \"availability\": \"https://schema.org/InStock\",\n        \"validFrom\": \"2027-05-08T18:00:00-03:00\"\n    },\n    \"performer\": {\n        \"@type\": \"Thing\",\n        \"additionalType\": [\n            \"http://dbpedia.org/ontology/Agent\",\n            \"http://