    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "<em>texuvie</em> | Léonie Bélanger et Éloi Angers-Roy"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "texuvie est un projet d’installation-performance en développement par l’artiste en danse Léonie Bélanger et l’artiste visuel Éloi Angers-Roy. Le tissage – sa souplesse, sa périssabilité, sa pratique – inspire leur recherche. Dans leur processus, l’image numérique et le geste usurpent la fibre textile. Ces deux matières premières s’entrelacent dans un rituel de tissage chorégraphique assisté [&hellip;]"
      }
    ],
