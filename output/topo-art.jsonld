    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "<em>Brume</em> | pixels·collectif"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Un nouveau jeu vidéo artistique de pixels·collectif (Andrée-Anne Mercier, Frédérique Bordeleau et Sandrine Cadieux), Brume, a ouvert la programmation 2024-2026 de TOPO, qui s&rsquo;inscrit sous les thèmes de la nostalgie, de l’écologie et du simulacre. Le 29 février 2024, dès 17h30, cette nouvelle installation dans la vitrine de TOPO mettait en scène un futur chaleureux [&hellip;]"
      }
    ],
