    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "<em>Marcel</em> | Pascale Tétrault"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "« Le 2 mars 1988, le long du fleuve St-Laurent, l’usine de construction navale Vickers ferme officiellement ses portes. Après y avoir travaillé 38 ans comme machiniste, mon grand-père est le dernier employé à quitter les lieux. Marcel aura passé ses derniers mois à l’usine à construire des boîtes en bois pour y déposer les [&hellip;]"
      }
    ],
