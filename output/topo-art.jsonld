    "http://ogp.me/ns#title": [
      {
        "@language": "fr-fr",
        "@value": "MIRAGES | Emmanuel Jouthe - Danse Carpe Diem • TOPO - Centre de création numérique"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "Présenté dans la vitrine de TOPO, le module « sable », tiré du corpus de l’exposition MIRAGES, est une installation immersive où la projection d’un court métrage expérimental de danse se déploie sur une large surface de sable, transformée en écran vivant. Le film, réalisé par le cinéaste Xavier Curnillon en collaboration avec Emmanuel Jouthe […]"
      }
    ],
