      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "TOPO a eu le plaisir de vous inviter, le samedi 5 mars de 16 à 18 h (heure de Montréal, UTC-5), à une discussion autour du nouveau Graal de l&rsquo;achat d&rsquo;œuvres d&rsquo;art numériques : les NFT (Non Fungible Token ou jetons non fongibles). Cette rencontre ouverte et gratuite a eu lieu via Zoom. L&rsquo;artiste Johann [&hellip;]"
      }
    ],
