    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dream State est une performance inspirée par l&rsquo;impact culturel de l&rsquo;intelligence artificielle générative. Elle se concentre sur les appréhensions de la société à l&rsquo;égard de cette nouvelle technologie et de ses applications et met en balance ces craintes avec ses prétendus avantages. La performance se concentre sur les applications contemporaines de l&rsquo;intelligence artificielle générative, telles [&hellip;]"
      }
    ],
