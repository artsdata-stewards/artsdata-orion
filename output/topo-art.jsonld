    "http://ogp.me/ns#title": [
      {
        "@language": "fr-fr",
        "@value": "Un Jardin la nuit  | Caroline Hayeur et D. Kimm • TOPO - Centre de création numérique"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-fr",
        "@value": "La nuit tombe et le jardin si paisible et accueillant se transforme en un lieu mystérieux. Que font les fleurs et les petites bêtes durant la nuit ? On entend des bruits étranges… Est-ce un chevreuil, un esprit ou… le chat de la voisine ? Réalisé par la photographe Caroline Hayeur et l’artiste interdisciplinaire D. […]"
      }
    ],
