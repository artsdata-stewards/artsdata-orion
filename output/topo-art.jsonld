    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "<em>De la Frontière</em> | Michel Huneault"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Transposée pour une diffusion en ligne avec TOPO, De la frontière est une proposition de l’artiste Michel Huneault qui documente et met en récit un segment de la frontière canado-américaine. À chaque visite, l’utilisateur fait une expérience unique d’un corpus de soixante images – et autant d’histoires orales – associées et séquencées aléatoirement à l’infini. Au-delà des [&hellip;]"
      }
    ],
