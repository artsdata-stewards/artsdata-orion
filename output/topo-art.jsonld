    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "<em>Pinch to awaken</em> | Yesica Duarte"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "À partir du 6 février 2023, TOPO a accueillit en résidence l’artiste argentine Yesica Duarte. Lors de sa résidence, Yesica a proposé un projet en réalité virtuelle qui communique avec le corps tout entier, et notamment le souffle de la personne qui en fait l’expérience. Elle a fabriqué son propre système pour capter la respiration [&hellip;]"
      }
    ],
