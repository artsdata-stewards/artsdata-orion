    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "<em>Fantasmagorie de semences potagères</em> | Fernande Forest"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le 8 septembre 2021, TOPO relançait son programme d&rsquo;expositions en vitrine en entamant un nouveau cycle thématique sous le thème de la fluidité. L&rsquo;artiste rimouskoise Fernande Forest exposait jusqu&rsquo;au 23 octobre son projet Fantasmagorie de semences potagères, une exploration audiovisuelle magnifiée depuis la nature même de trois semences : oignon, chou et salsifis. Suite à [&hellip;]"
      }
    ],
