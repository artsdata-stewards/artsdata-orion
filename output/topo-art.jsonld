    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "<em>MIRAGES</em> | Emmanuel Jouthe - Danse Carpe Diem"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Présenté dans la vitrine de TOPO, le module « sable », tiré du corpus de l’exposition MIRAGES, est une installation immersive où la projection d’un court métrage expérimental de danse se déploie sur une large surface de sable, transformée en écran vivant. Le film, réalisé par le cinéaste Xavier Curnillon en collaboration avec Emmanuel Jouthe [&hellip;]"
      }
    ],
