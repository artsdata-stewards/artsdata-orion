    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Incubateur de littérature numérique (ILINU) dans la francophonie canadienne"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "L’Incubateur de littérature numérique -ILINU- est un programme virtuel de formation, de création et de diffusion visant à développer la pratique d’écrivains, d&rsquo;écrivaines, d’artistes et de programmeurs de la Francophonie canadienne. L&rsquo;ILINU c&rsquo;est : des rencontres virtuelles autour d&rsquo;initiatives inspirantes en édition et création littéraire numériques. des ateliers conceptuels et techniques. un appel de projets [&hellip;]"
      }
    ],
