    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Balades poétiques | Mes mots, mon quartier"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "À partir du 2 septembre 2021, TOPO donnait un nouvel élan au projet Mes mots, mon quartier en proposant des balades poétiques dans le Vieux-Rosemont avec la troupe de théâtre de rue Toxique Trottoir. En puisant dans le répertoire d’anecdotes et de phrases poétiques du site web mesmots.ca, Toxique Trottoir a animeé cinq déambulations poétiques donnant vie aux témoignages [&hellip;]"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
