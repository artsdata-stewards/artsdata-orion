    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "LopLop en résidence ouverte"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "LopLop est une entreprise montréalaise de programmation de logiciels alliant interactivité, réalité augmentée et réalité fragmentée. Depuis 2018, LopLop se consacre à la modélisation de paysages, à la conception et à l’animation d’univers végétaux pour la génération d’expériences créatives et interactives. Un exemple probant est l’application Jardin créée pour le Jardin botanique de Montréal, qui [&hellip;]"
      }
    ],
