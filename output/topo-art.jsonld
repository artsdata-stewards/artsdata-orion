    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Marcel | Pascale Tétrault • TOPO - Centre de création numérique"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Une sculpture en mouvement de l'artiste Pascale Tétrault, mêlant archives et poésie, en exposition dans la vitrine de TOPO."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-FR"
      }
    ]
  },
  {
    "@id": "https://topo.art/programmation/marcel-pascale-tetrault/#primaryimage",
    "@type": [
      "http://schema.org/ImageObject"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://i0.wp.com/topo.art/chantier/wp-content/uploads/2025/02/marcel_16x9.jpg?fit=1920%2C1080&ssl=1"
      }
    ],
    "http://schema.org/contentUrl": [
      {
        "@id": "https://i0.wp.com/topo.art/chantier/wp-content/uploads/2025/02/marcel_16x9.jpg?fit=1920%2C1080&ssl=1"
      }
    ],
    "http://schema.org/width": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": "1920"
      }
    ],
    "http://schema.org/height": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": "1080"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-FR"
      }
    ],
    "http://schema.org/caption": [
      {
        "@language": "fr",
        "@value": "Deux personnes se tiennent debout sur une pelouse au bord d’un plan d’eau, déroulant un long ruban de papier entre elles. L'une porte une veste beige et l'autre une veste foncée avec une casquette. Une boîte en bois est posée sur le sol à proximité. En arrière-plan, on aperçoit des lignes électriques et un paysage ouvert sous un ciel clair."
      }
    ]
  },
