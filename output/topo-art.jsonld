      {
        "@language": "fr",
        "@value": "<em>Niyolchoca</em> | Rodrigo Velasco"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Du 20 février au 28 mars, TOPO présente l&rsquo;installation de poésie numérique et visuelle Niyolchoca de l&rsquo;artiste Rodrigo Velasco dans sa vitrine d’exposition du Pôle de diffusion de Gaspé. L&rsquo;installation explore quatre poèmes dont chacun est une constellation explorant un univers symbolique fortement associé à la cosmogonie aztèque. Joignant poésie visuelle et littérature numérique, l&rsquo;œuvre active des [&hellip;]"
      }
    ],
