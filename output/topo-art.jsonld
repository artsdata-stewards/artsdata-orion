    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "<em>ALÉAS : Échos et reflets des éolithes​</em> | Cléo Palacio-Quintin"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Pour sa dernière exposition en vitrine de 2023, TOPO annonce une œuvre toute en poésie qui donne une voix à des roches choisies ou imaginées par Cléo-Palacio Quintin. Lors du lancement, le vendredi 3 novembre, on invite le Quatuor Bozzini, qui a réalisé la musique du projet, afin d&rsquo;interpréter la voix musicale de quelques roches, [&hellip;]"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
