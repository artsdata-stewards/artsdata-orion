    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "<em>Unstable Intermediated Forms</em> | Rob Feulner, Sam Meech"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dès le 11 novembre 2021, TOPO annoncait une nouvelle exposition en vitrine avec une proposition médiatique des artistes Rob Feulner et Sam Meech, Unstable Intermediated Forms [Formes instables intermédiées]. Les artistes ont proposé une série d&rsquo;œuvres génératives de rétroaction vidéo (feedback) et de distorsion analogique qui exploraient la dynamique des fluides, la génération de motifs [&hellip;]"
      }
    ],
