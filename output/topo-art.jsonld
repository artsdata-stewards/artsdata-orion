    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "<em>Au jour le jour</em> | Leila Zelli"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Alors que l’été arrive à grands pas, TOPO annonce un nouveau corpus de l’artiste Leila Zelli pour ce troisième cycle de la programmation sur le thème Frontière, « Géopolitique, espaces variables ». Dans cette proposition vidéo adaptée pour le web, l’artiste aligne quelques extraits de reportages de grands médias réalisés dans les zones de conflit en Syrie, [&hellip;]"
      }
    ],
