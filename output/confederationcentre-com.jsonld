    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Arts Mixers at Confederation Centre in partnership w/ANCHOR Fest! - Confederation Centre of the Arts"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Calling All Arts & Culture Folks! No agenda, just great conversations, new connections, and meeting fellow artists and arts workers. The Arts Mixers are back and this October, in celebration of ANCHOR Fest, we are partnering up! Thursday, October 15th Mavor’s Lounge | 4:00–7:00 PM Come raise a glass, swap stories, and reconnect with your arts, culture and creative industries community. Register ANCHOR Fest (Formerly The Charlottetown Film Festival) is five days of film screenings, concerts, comedy shows, and conference activities spread across downtown Charlottetown October 14 to 18. You can find the full schedule and ticket info on the website and social media."
      }
    ],
    "http://ogp.me/ns#url": [
