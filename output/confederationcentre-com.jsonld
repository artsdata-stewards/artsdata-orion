  {
    "@id": "https://confederationcentre.com/genid/be906362502bb042",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://confederationcentre.com/event/by-a-thread/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://confederationcentre.com/wp-content/uploads/2026/07/ByAThread-1.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-03-10T19:30:00-04:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-03-10T19:30:00-04:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://confederationcentre.com/genid/4ab664d5583e2df8"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://confederationcentre.com/genid/3f3af091c4ea6ff1"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://confederationcentre.com/genid/c600fccf2fbea34c"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://confederationcentre.com/event/by-a-thread/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "By a Thread"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Seven Australian acrobats and 30 metres of rope make up By a Thread. Two industrial pulleys and a heavy-duty sailing rope are transformed by the cast of ‘By a Thread’ to create a mesmerising work of aerial circus. By a Thread weaves virtuosic acrobatics and intricate choreography through moments of confusion, hilarity, romance, playfulness, fear and friendship, uncovering the threads of connection present in all relationships. Fresh from touring in Europe, Canada and Asia, By a Thread redefines contemporary circus with inventive aerial acrobatics and a truly unique physical premise. This highly experienced ensemble have pooled their knowledge and skills to create a show where classic techniques are used in expansive ways, with the only prop onstage being 30 metres of white, cotton rope. The rope is a physical manifestation of the trust needed in any relationship, acrobatic or otherwise. The performers use this metaphor for community, to explore the give and take, balance, and dynamics of connecting with one another. More than mere bodies in space, By a Thread is an exploration of trust 6 metres above the ground. &nbsp; ★★★★★ “This is a work of art – if I could give it six stars I would.” – The [&hellip;]"
      }
    ],
    "http://schema.org/keywords": [
      {
