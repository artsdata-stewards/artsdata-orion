  {
    "@id": "https://confederationcentre.com/event/beyond-admiring-the-problem/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Beyond Admiring the Problem: Solutions for a Stronger Canada - Confederation Centre of the Arts"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The Confederation Centre’s Palmer Institute for Canadian Leadership and the University of Calgary’s School of Public Policy are teaming up to host Beyond Admiring the Problem: Solutions for a Stronger Canada, a half-day public forum on October 7, 2026, at the School’s downtown Calgary campus. Canada’s economic competitiveness, sovereignty and national unity have been diagnosed plenty but resolved rarely, so this forum flips the script. Former first ministers, senior military leaders, national business figures and top political commentators from every region of the country will take part in panels and a keynote discussion focused on practical, achievable ideas for a stronger, more united and more competitive Canada. “Canada does not suffer from a shortage of challenges but rather a shortage of venues where leaders are asked to bring solutions,” says Dr. Jeff Collins, inaugural Director of the Palmer Institute. Across three panels, leaders from government, business, defence, Indigenous policy and journalism will tackle some of the biggest questions facing the country. Both hosts share the legacy of James S. Palmer, a Prince Edward Island native, descendant of Father of Confederation Edward Palmer and prominent Calgary lawyer whose lifelong commitment to national unity helped shape both institutions. Date and Time: Wednesday, […]"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://confederationcentre.com/event/beyond-admiring-the-problem/"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en-us",
        "@value": "Confederation Centre of the Arts"
      }
    ],
