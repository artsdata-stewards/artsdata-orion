    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Join us at the Confederation Centre Art Gallery for our Seniors Art Activities. Explore and discuss the diverse works in our current exhibitions through a guided tour, followed by refreshments and a relaxed art and craft session in the Michael S. Schurman Family Studio. Sessions are from 10:00am to 12:00pm. Coffee, tea and cookies will be provided. Dates: January 7, 2027 February 4, 2027 March 4, 2027 April 1, 2027 May 6, 2027 Time: 10:00am – 12:00pm Day: Thursday Ages: 55+ Register Here"
      }
    ],
