      {
        "@language": "en-us",
        "@value": "A Panto in Wonderland - Confederation Centre of the Arts"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The Arts Academy Performance Group invites you down the rabbit hole as its dance and musical theatre students bring the beloved holiday pantomime tradition to life with a Wonderland twist! Featuring classic panto laughs, musical hits from the past four decades, and a heartwarming message about standing up for what's right when the world has gone mad, this show will have the whole family cheering for the heroes, booing the villains, and singing along from beginning to end."
      }
    ],
