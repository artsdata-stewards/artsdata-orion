    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Exploring Visual Arts - Confederation Centre of the Arts"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Students explore the elements of art through drawing, painting, and sculpting activities. Through fun exercises and lessons, students develop their visual literacy and technical abilities. Activities are supplemented by gallery visits exploring contemporary and historical artworks."
      }
    ],
