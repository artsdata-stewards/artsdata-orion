      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://confederationcentre.com/genid/3f3af091c4ea6ff1"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://confederationcentre.com/genid/6c46049453869f63"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://confederationcentre.com/event/peiso-revolution/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "PEI Symphony Orchestra Presents: Revolution"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "On November 15, be prepared to be rocked out of your seat when the orchestra closes the Revolution-themed concert with the daunting and towering 11th Symphony of Dmitiri Shostakovich, ‘The year 1905.’ Recounting the story of a people fed up with tyranny and oppression, this sonically descriptive work is terrifying for its entire fourth movement played as loud as the orchestra can deliver. Canada may not be known as the site of a major revolution, but Our Story chronicles a country seeking its own identity and resolving fundamental questions. To set the scene of Canada’s story and revolution, Maritimer Emily Doolittle’s ‘Falling Still’ opens the concert with a gentle exploration of sounds from natural processes – some the result of choices and preferences by living beings. Then the orchestra launches into Franz Liszt’s dark, yet triumphant ‘A Hero’s Funeral,’ telling the tale of a heroism against terrible odds, and ending the afternoon with Shostakovich’s revolutionary bang. The partnership between the P.E.I. Symphony Orchestra and Confederation Centre of the Arts is supported through the Lou MacEachern Community Partnership Program, which helps foster meaningful collaborations within Prince Edward Island’s arts community."
      }
    ],
