  {
    "@id": "https://confederationcentre.com/event/legacy-of-the-eagles/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
