  {
    "@id": "https://confederationcentre.com/event/the-sheepdogs/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
