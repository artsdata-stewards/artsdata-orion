    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Horizons: Dare to Dream, Dare to Change - Confederation Centre of the Arts"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Finding the strength and voice to be the change.Horizons is an inspiring dance showcase that brings together a variety of dance styles to celebrate the power of positive change. Featuring the Intermediate, Senior, Advanced, I.T.P. (Intensive Training Program) and Adult classes of all genres. Through movement, music, and storytelling, performers explore the idea of looking beyond boundaries, embracing new perspectives, and creating a brighter future."
      }
    ],
