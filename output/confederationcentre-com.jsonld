    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "June Zinck"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "FOR THE CENTRE:\r\nGlenda’s Kitchen, Spoon River\r\nTHEATRE:\r\nDisney’s Frozen (Theatre Aquarius); Mamma Mia!, Little Shop of Horrors, Disney’s Frozen, Dear Rita, The Play That Goes Wrong (Neptune Theatre); Sh-Boom! Life Could Be a Dream (Drayton Entertainment); It’s a Wonderful Life (Western Canada Theatre); Kamp the Musical (EFT)\r\nFILM/TV:\r\nDirty Deeds (SwearNet); Sifting (Eastlink TV)\r\nTRAINING:\r\nStratford Design Apprentice Program, Neptune Chrysalis Program\r\nOTHER:\r\nRobert Merritt Award for Outstanding Sound Design (2018)\r\n\r\n“Beyond excited to be back at the Festival to work on this incredible Canadian story, with this amazing team of cast and creatives!”\r\n\r\nIG:\r\n\r\n@realjzinck89"
      }
    ]
  },
