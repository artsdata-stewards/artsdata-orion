        "@value": "Loreena McKennitt: The Mask and The Mirror – 30th Anniversary Tour - Confederation Centre of the Arts"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Loreena McKennitt brings The Mask and The Mirror – 30th Anniversary Tour to the Sobey Family Theatre at Confederation Centre of the Arts in Charlottetown, Prince Edward Island, on Thursday, October 15, 2026, at 7:30 PM. This one-night performance celebrates the 30th anniversary of her acclaimed 1994 album, described by Billboard as “timeless and transcendent.”"
      }
    ],
