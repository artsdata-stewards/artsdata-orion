  {
    "@id": "https://confederationcentre.com/event/menofthedeeps26/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "The Men of the Deeps Diamond Sunset Tours 2026 - Confederation Centre of the Arts"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "An Olive Street Entertainment Production  The Men of the Deeps first raised their voices together in 1966, but the friendships and hardships that initially bound them were born in the tunnels beneath the Cape Breton coastline. Men, shaped by the pressure of a life lived underground, where the daylight couldn’t reach. But now, the industry that shaped them is no more, and so they stand and sing in reflection, gratitude, and quiet pride.  But no sunset falls without a dawn, and so, in the same way, their stories and songs are passed forward, evolving, always finding new beginnings.  "
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://confederationcentre.com/event/menofthedeeps26/"
      }
    ],
