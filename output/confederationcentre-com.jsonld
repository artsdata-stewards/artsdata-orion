      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://confederationcentre.com/genid/3f3af091c4ea6ff1"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://confederationcentre.com/genid/2ddbc38b4ee02be1"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://confederationcentre.com/event/symons-2026/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "2026 Symons Presentation and Lecture"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The Confederation Centre of the Arts is pleased to announce that the Honourable Bob Rae, PC, CC, OOnt, and KC will join the Honourable Rosalie Silberman Abella, CC, FRSC when she receives the 2026 Symons Medal, for a conversation on Canadian confederation, moderated by veteran journalist Steve Paikin. The Honourable Marie Deschamps, CC, former Justice of the Supreme Court of Canada, along with Robert Sear, co-chair of the Symons Medal Committee and board chair for the Confederation Centre of the Arts, will present the award to Justice Abella. This year&#8217;s presentation also marks the inaugural convening of the Palmer Institute for Canadian Leadership at Confederation Centre of the Arts, bringing together leaders and thinkers to build on the dialogue sparked by the Symons Lecture. The medal presentation will take place on September 25, 2026, at 1 p.m., during a public ceremony at the Sobey Family Theatre in Charlottetown, with a free livestream available for those joining remotely. Tickets for the Symons Medal Presentation and Lecture are available now. The event is free to attend, in person or via livestream."
      }
    ],
    "http://schema.org/keywords": [
      {
        "@language": "en",
        "@value": "Palmer Institute for Canadian Leadership, Symons Medal"
      }
    ],
