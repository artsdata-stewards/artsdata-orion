      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "FOR THE CENTRE:\r\nDebut\r\nTHEATRE:\r\nDisney’s Frozen, Fully Committed, Casey &amp; Diana, King James (Theatre Aquarius); The Blue Castle (NCNM Workshop); Mamma Mia! (Neptune Theatre); The New Canadian Curling Club (Lighthouse Festival); Hedda Gabler, Production Assistant 2023 Season (Stratford Festival); Charlie and the Chocolate Factory (YPT)\r\nTRAINING:\r\nSociology/Theatre &amp; Film (McMaster University), Production Design &amp; Technical Arts (National Theatre School of Canada)\r\nBri would like to dedicate her Charlottetown debut to Lanie Anderson."
      }
    ]
  },
  {
    "@id": "https://confederationcentre.com/genid/0267b0c06d6dc135",
    "@type": [
      "http://schema.org/Person"
    ],
    "http://schema.org/image": [
