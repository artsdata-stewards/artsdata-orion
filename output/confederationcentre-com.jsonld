    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Awesome ABBA"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "AWESOME ABBA is a high-energy touring tribute band that brings the timeless magic of ABBA to life with stunning authenticity and electrifying stage presence. Featuring a talented group of seasoned performers, the band captures the sound, style, and spirit of ABBA — with powerful vocals, dazzling costumes, and dynamic live performances. Delivering hit after hit with precision, passion, and flair, AWESOME ABBA truly lives up to their name: creating an unforgettable experience that has audiences singing, dancing, and feeling completely elevated."
      }
    ],
