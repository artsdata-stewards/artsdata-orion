    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://confederationcentre.com/event/anne-of-green-gables-the-musical-2026/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Anne of Green Gables–The Musical™"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "See Prince Edward Island&#8217;s iconic redhead on stage this summer! This Canadian classic is a humorous, touching, and dynamic musical that will inspire your imagination, tickle your funny bone, and mesmerize you with its graceful and exhilarating singing and dancing. This cherished family musical tells the poignant and funny story of a freckle-faced, red-haired orphan named Anne Shirley who arrives at the Bright River Railway Station full of hope for a new life. Her destination is the home of brother and sister Matthew and Marilla Cuthbert in Avonlea, Prince Edward Island. When she arrives at Green Gables, Anne is devastated when she discovers that the elderly siblings were expecting a boy from the orphanage, and then ecstatic when they decide to keep her. With her fiery temper, love of melodrama and romance, and penchant for misadventure, she brings laughter, love, and more than a little consternation to the Cuthberts&#8217; quiet lives. In return, Anne finds the happiness and the home she has longed for all her life. With a 26-member company and a 14-member live orchestra, this legendary musical has delighted millions of people at Confederation Centre of the Arts. Running Time: Act One 1h 10 | 20 Min Intermission [&hellip;]"
      }
    ],
    "http://schema.org/keywords": [
      {
        "@language": "en",
        "@value": "Dance, Music, On Stage, Theatre"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
  {
    "@id": "https://confederationcentre.com/genid/3d1efe9eda858be4",
    "@type": [
      "http://schema.org/Person"
    ],
    "http://schema.org/image": [
      {
        "@id": "https://confederationcentre.com/wp-content/uploads/2024/02/Pottle-Kristen-Headshot-2024-scaled.jpg"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Kristen Pottle*"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "FOR THE CENTRE:\r\n10 Seasons, 9 with Anne of Green Gables—The Musical™, Tell Tale Harbour, Jesus Christ Superstar, I’m Every Woman\r\nTHEATRE:\r\nTell Tale Harbour (Mirvish); Wizard of Oz (Mirvish and US National Tour); West Side Story (Banff/Citadel Program and Vancouver Opera); Matilda, Newsies, Addams Family (Choreographer); Associate Artistic Director (Craig Fair Productions); Owner (Blossoming Heart Yoga)\r\n\r\n“Always a joy to be back home in Avonlea. My 9th production and I somehow love it more each time. We couldn’t have a better cast to do it with! This season is dedicated to my incredibly supportive family, to Simon, and to my favourite redhead, Clark.”\r\n\r\nIG:\r\n\r\n@blossomingheartyoga\r\n\r\n*Female Swing/Dance Captain/ Covering Mrs. Spencer. Mrs. Sloane,Lucilla Pye/ Gillis, Mrs. Pye, Mrs. Barry, Mrs. Blewett, Prissy, Andrews, Tillie Boulter, Gertie Pye."
      }
    ]
  },
