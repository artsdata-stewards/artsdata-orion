  {
    "@id": "https://confederationcentre.com/event/small-steps-big-dreams/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Small Steps, Big Dreams - Confederation Centre of the Arts"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Dreaming, discovering, and taking flight.Small Steps, Big Dreams is a heartwarming dance umbrella showcase that shares how every great achievement begins with a single step. Through a variety of dance styles, featuring Creative Movement, Junior, Primary and Elementary classes, this matinee highlights the power of dreams and the confidence to pursue them. Together, the dancers inspire audiences to believe in themselves, embrace new opportunities, and recognize that even the smallest steps can lead to extraordinary destinations."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://confederationcentre.com/event/small-steps-big-dreams/"
      }
