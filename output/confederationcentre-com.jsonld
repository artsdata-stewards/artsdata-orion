    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "FOR THE CENTRE (SELECT):\r\n11th Season. Anne of Green Gables&mdash;The Musical&trade;, Jersey Boys, Evangeline, Jesus Christ Superstar, Atlantic Blue\r\nTHEATRE:\r\nShear Madness, Legends of the 80s, Step By Step (Stage West Calgary); Maggie, A Christmas Story, Hairspray (Theatre Aquarius); The Little Prince (Theatre Calgary); West Side Story, Elf (Neptune Theatre); Grow, Hair (The Grand Theatre); A Kind of Magic, Still Standing (Craig Fair Productions)\r\nTRAINING:\r\nBachelor of Music Theatre Performance (Sheridan College)\r\n\r\n&ldquo;Thank you to Robin, Adam, Bob, Jen and Rachel for their support and friendship! This one is for Matthew MacInnis! End it.&rdquo;\r\n\r\nIG:\r\n\r\n@andrewjamesmcallister"
      }
    ]
