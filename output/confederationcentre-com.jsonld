  {
    "@id": "https://confederationcentre.com/event/pd-day-camp/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "PD Day Camp - Confederation Centre of the Arts"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Campers in our PD Day Arts Camp will get a full range of our arts education offerings, receiving a unique opportunity to explore the arts through both hand-on and observational experiences. In the morning, our Visual Arts Educators will lead campers through a variety of art activities including (but not limited to) drawing, painting, sculpting, crafts and more. In the afternoon, they will hop on over to the dance studio where they will explore drama, music, and dance! Alongside these activities campers may venture on a guided tour of the current gallery exhibitions, meet our Heritage Players, and more! Gallery and Theatre tours are subject to availability throughout the year depending on exhibition and performance schedules. Date: November 27,2026 Ages:5-12 Time: 9:00 AM – 4:00 PM PD Day — Extended Care* 8:00 AM – 5:00 PM   Register Here  "
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://confederationcentre.com/event/pd-day-camp/"
      }
    ],
