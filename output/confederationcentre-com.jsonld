    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "God Is A Scottish Drag Queen - Confederation Centre of the Arts"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "After sold-out runs with Toronto’s Mirvish Productions, and direct from London’s West End, the hit one man play comes to Charlottetown! God, dressed in a floral power suit, comes down to expound on everything from Noah’s Ark to Star wars in a hilarous, heartwarming, and unforgettable night of comedy.   ★★★★★ “A hilarious & heavenly way to spend an evening!” CBC ★★★★★ “A cross between Dame Edna & Billy Connoly with a dollop of Eddie Izzard!” National Post"
      }
    ],
    "http://ogp.me/ns#url": [
