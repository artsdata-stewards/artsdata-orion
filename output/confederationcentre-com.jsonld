      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Confederation Centre Presents 65 million years ago, dinosaurs ruled the earth… 30 years ago, a movie about dinosaurs ruled the box office… This year, you are invited to… Hold On To Your Butts Following its critically acclaimed UK Tour and West End debut, the Fringe 2024 smash hit comes to Confederation Centre of the Arts! Two actors and a Foley artist perform a live, shot-for-shot parody of the greatest dinosaur film of all time. A wildly inventive tour-de-force of comedy, physical theatre and live Foley. Instagram TikTok Website"
      }
    ],
