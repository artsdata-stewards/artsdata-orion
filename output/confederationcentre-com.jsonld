      {
        "@language": "en-us",
        "@value": "Confederation Centre of the Arts"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "en-us",
        "@value": "https://confederationcentre.com/wp-content/uploads/2026/05/Matt-Dusk_In-Charlottetown_1200x600-SHOWPASS.png"
      }
    ],
    "http://ogp.me/ns#image:width": [
      {
