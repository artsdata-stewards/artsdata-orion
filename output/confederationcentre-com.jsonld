  {
    "@id": "https://confederationcentre.com/genid/614d733c5cd43761",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://confederationcentre.com/event/peiso-revolution/"
      }
    ],
    "http://schema.org/image": [
