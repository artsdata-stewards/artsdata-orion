  {
    "@id": "https://confederationcentre.com/event/celebrating-celine/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Celebrating Celine-A New Day... - Confederation Centre of the Arts"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Celebrating Celine comes to the Confederation Centre of the Arts on 27 November, delivering the ultimate live concert experience honouring the legendary music of Celine Dion. This spectacular touring production has captivated audiences across the UK and beyond, celebrating the passion, power, and unforgettable songs that define one of the world’s most iconic voices. Starring the phenomenal Lisa Harter as ‘Celine’, alongside an exceptional live band under the musical direction of Stephen ‘Stretch’ Price, this is a show not to be missed. With breathtaking sound and lighting, and stunning screen visuals, audiences are taken on an immersive journey through Celine’s greatest hits. From timeless ballads like My Heart Will Go On and Because You Loved Me to high-energy anthems including River Deep, Mountain High, every moment is a heartfelt tribute to her extraordinary career. Whether you’re a lifelong fan or discovering her music for the first time, Celebrating Celine promises an evening filled with joy, emotion, and unforgettable entertainment. This is a tribute production and is not affiliated with any original artistes, estates, or management companies."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://confederationcentre.com/event/celebrating-celine/"
      }
    ],
