    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://confederationcentre.com/event/loreena-mckennitt-the-mask-and-the-mirror-30th-anniversary-tour/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Loreena McKennitt: The Mask and The Mirror – 30th Anniversary Tour"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Rubin Fogel Productions Presents &nbsp; Loreena McKennitt brings The Mask and The Mirror – 30th Anniversary Tour to the Sobey Family Theatre at Confederation Centre of the Arts in Charlottetown, Prince Edward Island, on Thursday, October 15, 2026, at 7:30 PM. This one-night performance celebrates the 30th anniversary of her acclaimed 1994 album, described by Billboard as “timeless and transcendent.” The concert is presented in two parts. The first set features fan favourites from across McKennitt’s career, followed by a complete performance of The Mask and The Mirror, an album known for its rich blend of Celtic, Spanish, and Moroccan musical influences and its exploration of enduring spiritual and historical themes. McKennitt will be joined on stage by longtime musical collaborators Caroline Lavelle (cello), Brian Hughes (guitar), Hugh Marsh (violin), Dudley Phillips (bass), and Robert Brian (drums), creating a powerful and immersive live experience for audiences in Charlottetown. This performance marks a rare return to Atlantic Canada and offers Prince Edward Island audiences the opportunity to witness a milestone celebration from one of Canada’s most respected and internationally acclaimed artists. Loreena McKennitt Website"
      }
    ],
