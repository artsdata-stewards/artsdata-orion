  {
    "@id": "https://confederationcentre.com/genid/0065fe5b9d791ce9",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://confederationcentre.com/event/symons-2026/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://confederationcentre.com/wp-content/uploads/2026/06/SymonsEventGraphic_PICL-1.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-09-25T13:00:00-03:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-09-25T13:00:00-03:00"
      }
    ],
    "http://schema.org/location": [
      {
