    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Lennie Gallant: The Innkeeper’s Christmas"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "CONFEDERATION CENTRE PRESENTS Come join Lennie Gallant and his band for some Christmas cheer! Lennie is excited to bring his Christmas concert to you this year. This holiday favourite is full of original Christmas songs, stories and exciting accompanying visuals on screen. Lennie and his amazing band will bring you laughs, lots of wonder, and maybe a few tears, as they look at Christmas from many points of view in 2026. Don’t miss this unique Yuletide Feast for the eyes, ears and heart!"
      }
    ],
