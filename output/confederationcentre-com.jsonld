    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Arts Mixers at Confederation Centre – Holiday Edition!"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The Arts Mixers are back for the holidays! Confederation Centre of the Arts, in partnership with Innovation PEI, is inviting the Island’s arts, culture, and creative industries community to celebrate the season together on Tuesday, December 8, from 4:00 to 6:00 PM in Mavor’s Lounge. This festive edition keeps the same easygoing format: no agenda, no presentations, just good company and great conversation. Artists, arts workers, and creative professionals are encouraged to drop in, raise a glass of holiday cheer, swap stories from the year, meet new collaborators, and reconnect with familiar faces before the season gets busy. Whether you’re wrapping up a big year or already dreaming up what’s next, this is the perfect chance to toast the creative community that makes the Island shine. The Arts Mixer is free to attend, and registration is encouraged. Register Here"
      }
    ],
    "http://schema.org/keywords": [
      {
        "@language": "en",
        "@value": "Art Mixer"
      }
