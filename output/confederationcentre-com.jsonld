    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "The Confederation Centre of the Arts is proud to announce The Honourable Justice Rosalie Silberman Abella as the winner of the 2026 Symons Medal."
      }
