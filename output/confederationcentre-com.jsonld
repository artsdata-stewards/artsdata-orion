  {
    "@id": "https://confederationcentre.com/event/adult-drama/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Adult Drama - Confederation Centre of the Arts"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Participants will be provided with tips and techniques on how to audition for a show. They will audition and be cast in a short play or series of scenes from a play, which they will then spend the 6 weeks developing and rehearsing in their groups. Each class will begin with a lesson on blocking, scene analysis, or character development activities and then participants will spend the rest of the time working with their groups on their plays, with feedback and guidance from the instructor. At the end of the 6 weeks they will perform their plays for the other groups in the class. Dates: September 16 – October 28, 2026 Time: 6:30pm – 8:30pm Day: Wednesday Ages: 18+ Register Here"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://confederationcentre.com/event/adult-drama/"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "en-us",
        "@value": "Confederation Centre of the Arts"
      }
