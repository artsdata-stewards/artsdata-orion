  {
    "@id": "https://confederationcentre.com/event/thane-dunns-elvis-in-concert/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
