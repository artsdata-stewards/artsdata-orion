      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Dwayne Gretzky is Canada’s greatest party band and a can’t miss live music experience celebrating classic hits from the 70s, 80s and 90s. Celebrating the classic rock and pop songs that unite people across generations, Dwayne Gretzky has delivered electrifying renditions of over 800 songs."
