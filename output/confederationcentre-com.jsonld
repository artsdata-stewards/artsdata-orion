  {
    "@id": "https://confederationcentre.com/event/a-panto-in-wonderland/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
