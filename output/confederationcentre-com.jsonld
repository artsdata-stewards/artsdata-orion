    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Students explore the elements of art through drawing, painting, and sculpting activities. Through fun exercises and lessons, students develop their visual literacy and technical abilities. Activities are supplemented by gallery visits exploring contemporary and historical artworks. NEW! Sessions are now 10 weeks instead of 8. Exploring Visual Arts I Dates: January 9 – Mar 13, 2027 Time: 9:00am – 10:00am Day: Saturday Ages: 6 to 8 Exploring Visual Arts II Dates: January 9 –  Mar 13, 2027 Time: 11:00am – 12:00pm Day: Saturday Ages: 9 to 12 &nbsp; Register Here"
      }
