    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Festive Wreath Contest and Exhibition - Confederation Centre of the Arts"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Spread some holiday spirit with us at the Centre during the annual Festive Wreath Contest and Exhibition, organized by the Friends of Confederation Centre of the Arts. All are welcome to participate—adults, youth, youth groups, businesses, and other groups. Wreaths will be displayed through December. Categories include: • Traditional • The Dunes – “Off the Wall” • Green Living (recycled materials) • Children’s Solo • Children’s Group • Fan Choice Fee: $5 per entry Prize winners will be announced in December. WREATH DROPOFF Studio 1 at the Centre Saturday, November 14 + Sunday, November 15 Between 1 p.m. and 3 p.m. For more information, email friends@confederationcentre.com"
      }
    ],
