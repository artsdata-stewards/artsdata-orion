    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Adult Visual Arts - Confederation Centre of the Arts"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "No experience needed! In this relaxed, welcoming class, you’ll explore the basics of drawing, painting, and sculpture through hands-on projects and guided exercises. Each week introduces a new artistic concept, helping you build confidence and sharpen your visual skills in a fun, supportive environment. Activities will be supplemented by visits to the Confederation Centre Art Gallery, where students will explore a range of contemporary and historical artworks. Dates: September 22 – November 24, 2026 Time: 6:00pm – 8:00pm Day: Tuesday Ages: 18+ NEW! Session is now 10 weeks instead of 8.   Register Here"
      }
    ],
