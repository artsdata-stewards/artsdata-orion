  {
    "@id": "https://confederationcentre.com/event/inside-island-history-26/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Inside Island History - Confederation Centre of the Arts"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Soak in the fascinating stories of Prince Edward Island’s past at this engaging cabaret-style presentation. An expert in Island history will guide you through engrossing tales, rare images, and little-known facts. Whether you're a history buff, a curious visitor, or a proud Islander, you’ll walk away with a deeper appreciation for the people, events, and forces that shaped this remarkable place."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
