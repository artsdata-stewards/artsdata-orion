        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Spooky Walk - Confederation Centre of the Arts"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Gather your bravest family and friends for a spine-tingling evening of storytelling, shadows, and strange sightings on the second annual Spooky Walk — a family-friendly event exploring PEI’s most chilling legends and cryptids. This immersive experience is brought to life through a unique collaboration between Confederation Centre’s Arts Academy and Heritage programs. Inspired by the Centre’s popular Ghost Tour, the Spooky Walk winds through the misty streets of Charlottetown, all while guided by tales that blend the historical with the haunted. Throughout the evening, expect haunting performances from the Arts Academy’s Performance Group and the Confederation Centre Choirs, setting the mood for an unforgettable night. Not recommended for children under 10."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://confederationcentre.com/event/spooky-walk/"
      }
