  {
    "@id": "https://confederationcentre.com/event/pei-arts-awards/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
