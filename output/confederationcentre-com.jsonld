      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Join instructor Kelly Caseley in creating a paper mache mask with a fully articulated jaw.  Caseley will guide students through the design and creation of their own individual wearable works of art.No experience required. Please note that chemicals and other materials with strong odours may be used. Participants must be comfortable wearing PPE as needed."
      }
    ],
