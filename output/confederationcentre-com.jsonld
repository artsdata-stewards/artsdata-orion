  {
    "@id": "https://confederationcentre.com/event/the-price-is-right-live/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
