  {
    "@id": "https://confederationcentre.com/event/adult-improv/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-us",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-us",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-us",
        "@value": "Adult Improv - Confederation Centre of the Arts"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "A lively and laughter-filled workshop designed for adults! Discover the joy of improvisation through simple, engaging games and storytelling exercises that spark creativity, boost confidence, and foster connection—no experience needed. This welcoming session invites you to play, explore, and embrace the unexpected in a relaxed and supportive environment. Whether you’re a longtime improv fan or trying it for the first time, come ready to laugh, share, and create unforgettable moments together! No scripts, no pressure—just pure fun! Upcoming class: January 6, ending February 10 Wednesdays 6:30 p.m. – 8 p.m. 18+ Register Here"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-us",
        "@value": "https://confederationcentre.com/event/adult-improv/"
      }
    ],
