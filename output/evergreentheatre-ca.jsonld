    "https://ogp.me/ns#description": [
      {
        "@language": "en-us",
        "@value": "Bob Wiseman (original Blue Rodeo) and Mike Boguski (current Blue Rodeo pianist) — two of Canada's most unpredictable keyboard minds — take turns dismantling what a piano set can be. A Halloween night unlike any other."
      }
    ],
