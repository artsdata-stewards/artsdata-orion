    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The Evergreen Theatre is the sole project of the Fundy Folk Association; founded in 1991 as a not-for-profit, volunteer-run organization with a committed Board of Directors.\nOur Mandate is: \nTo offer quality professional performing arts with an emphasis on music.\nTo provide cultural enrichment, and social and volunteer opportunities for our rural community.\nTo provide a performance venue, meeting, and workshop space for the use of the local community."
      }
    ]
