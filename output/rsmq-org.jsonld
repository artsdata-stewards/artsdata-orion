    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "DANSE CONTEMPORAINE"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "En préparation à notre résidence au Diefenbunker à Ottawa pour lancer un projet de danse qui se penche sur l'âgisme et un dialogue artistique intergénérationnel en mouvement, tout en venant à l'appui de la relève artistique d'Ottawa. Ce dernier a pour but de faire rayonner les voix artistiques émergentes et établies d'ici et d'ailleurs, issues de divers courants culturels."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
