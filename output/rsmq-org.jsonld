    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "SIMON PELLERIN JAZZ QUARTET"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Simon Pellerin et son quartette vous convient à un voyage dans le temps, à la rencontre d'un siècle de jazz. De la Nouvelle-Orléans des années 1900 aux grooves funky des années 70, les musiciens vous guideront à travers les grandes époques d'une musique née dans les marges et façonnée par l'histoire."
      }
    ],
