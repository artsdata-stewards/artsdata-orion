      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://www.rsmq.org/genid/f4785e03d8378dc1"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.rsmq.org/concerts/concert-de-no%C3%ABl"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Concert de Noël"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Sous la direction de Charles-André Lauzon, l’Ensemble Cordes-à-Vent a le bonheur de vous présenter, encore une fois un concert qui saura vous mettre dans l'atmosphère des Fêtes.  \n \nAu programme : la beauté de la musique baroque avec un concerto de Vivaldi, l’élégance des grandes mélodies classiques, la magie et la féerie du Casse-Noisette de Tchaïkovski, ainsi que des airs traditionnels, des chants de Noël et des mélodies qui traversent le temps. Du classique aux airs folkloriques, en passant par les incontournables du temps des Fêtes et quelques airs bien de chez nous. Ambiance conviviale et la magie du temps des fêtes garantis!"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
