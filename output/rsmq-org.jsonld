    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "La pianiste et compositrice Ariane Racicot nous entraîne dans un univers jazz vibrant, où se rencontrent virtuosité, sensibilité et énergie rythmique. Accompagnée de son trio, elle propose une musique originale, expressive et pleine de surprises."
      }
