    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Le grand André Laplante en récital"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Lauréat du deuxième prix au prestigieux Concours international Tchaïkovski de Moscou et de nombreuses distinctions internationales, le pianiste québécois André Laplante compte parmi les plus grands pianistes de sa génération. Admiré pour la profondeur de ses interprétations, son raffinement musical et sa maîtrise exceptionnelle du clavier, il nous propose un récital consacré à trois grands compositeurs : Schubert, Chopin et Beethoven."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
