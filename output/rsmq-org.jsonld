      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.rsmq.org/concerts/piazzola-fl%C3%BBte-et-piano"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Vagabondage"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Passion, nostalgie, sensualité : le tango est une musique qui ne laisse personne indifférent. La chanteuse et flûtiste Sophie Lemaire et le pianiste argentin Juan Hermida nous invitent à vagabonder au cœur de cet univers où les mélodies se font tour à tour caresses, confidences et déchirements. Au programme, des œuvres d'Astor Piazzolla et d’autres géants du tango, quelques surprises et la participation spéciale de la chanteuse Pascale Guertin. Un après-midi où les voix, la flûte et le piano feront vibrer toutes vos cordes sensibles."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
