    "http://schema.org/image": [
      {
        "@id": "https://static.wixstatic.com/media/6981d4_ddc2fe5a1e394dbda2f848a81709f416~mv2.avif"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.rsmq.org/concerts/concert-de-no%C3%ABl"
      }
    ],
