    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Les ondes fantaisistes !"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Rêves, vagues, fables et danses : laissez-vous charmer par l'univers hautement évocateur de Schumann, Ravel et Chopin. Puisant sa source dans la poésie et l'imaginaire pur, ce programme invite à un voyage au cœur de la création, entre mysticisme, envoûtement et exaltation. "
      }
    ],
