  {
    "@id": "https://thecultch.com/event/a-bird-never-flew-on-one-wing-an-evening-with-martin-shaw/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-ca",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "A Bird Never Flew On One Wing — An Evening with Martin Shaw"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Join revered storyteller Martin Shaw for an electrifying night of Celtic tales, life adventures, wit, grief, and deep reflection. Oct 14 at 7pm at York Theatre in Vancouver, BC."
