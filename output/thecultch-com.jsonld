    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Palestine Comedy Club"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Palestine Comedy Club is a road-movie following six Palestinian stand-up comedians from Haifa, Ramallah, Jenin, Hebron and the Golan Heights as they devise a show exploring the dark humour of Palestinian identity. With no tradition of comedy clubs and communities divided by walls and checkpoints, connecting across the divides proves enormously challenging. Despite differing travel permissions, the tour gains momentum and audiences flock in. Word spreads internationally, leading to London gigs that begin, tragically, on October 7th, 2023. As war erupts at home, performing in English to a conflicted British public becomes an existential mission to find joy and connection through laughter."
      }
    ],
