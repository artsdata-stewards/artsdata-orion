    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Новое прочтение классики! Мы сменили пол героев, время изменило декорации, но механизм остался прежним. «Инкогнито» - комедия о власти, страхе и нас самих."
      }
