  {
    "@id": "https://capitol.nb.ca/#1107_2027-05-02T15:00:00",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://capitol.nb.ca/en/tickets-events/when-you-wish-upon-a-star"
