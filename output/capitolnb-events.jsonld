  {
    "@id": "https://capitol.nb.ca/#951_2026-11-20T19:30:00",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://capitol.nb.ca/en/tickets-events/ria-mae"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-20T19:30:00"
      }
    ],
    "http://schema.org/endDate": [
