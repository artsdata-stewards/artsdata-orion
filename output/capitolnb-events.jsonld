    "http://schema.org/image": [
      {
        "@id": "https://capitol.nb.ca/images/stories/flexicontent/item_1107_field_41/original/tuttamusica-wish-upon-a-star-700x460.jpg"
      }
    ],
    "http://schema.org/offers": [
