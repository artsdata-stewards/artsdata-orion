        "@value": "World #1 Tribute to Luke Combs"
      },
      {
        "@language": "fr",
        "@value": "World #1 Tribute to Luke Combs"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Dust off your hats and boots, Luke Combs UK (the worlds leading tribute to Luke Combs and is endorsed by the man himself) is coming to town for an unforgettable night of country music with his full band.\r\nLuke Combs UK is the closest you’ll get to the real deal with the look and authentic sound of the GRAMMY nominated country music megastar.\r\nOpening Performance by American Idol Alum Louis Knight "
      },
      {
        "@language": "fr",
        "@value": "Dépoussiérez vos chapeaux et vos bottes : Luke Combs UK (le meilleur groupe hommage au monde dédié à Luke Combs, approuvé par l’artiste lui-même) débarque en ville pour une soirée inoubliable de musique country avec son groupe au complet.\r\nLuke Combs UK est ce qui se rapproche le plus de l’original, avec le look et le son authentique de cette mégastar de la musique country nominée aux Grammy Awards.\r\nLouis Knight en première partie, ancien participant à American Idol "
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
