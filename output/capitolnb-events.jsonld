    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Stadacona Band Holiday Concert"
      },
      {
        "@language": "fr",
        "@value": "Stadacona Band Holiday Concert"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Celebrate the warmth and wonder of the holiday season with the Stadacona Band of the Royal Canadian Navy and acclaimed Nova Scotian singer-songwriter Terra Spencer. This festive concert brings together the rich sound of one of Canada's premier military bands with Terra's heartfelt storytelling, wit, and distinctive folk-inspired artistry. Featuring Christmas classics, locally inspired originals, and unique collaborative performances, this heartwarming concert celebrates the joy, wonder, and spirit of the season. "
      },
      {
        "@language": "fr",
        "@value": "Célébrez la chaleur et la magie des Fêtes avec la Musique Stadacona de la Marine royale canadienne et la célèbre autrice-compositrice-interprète de la Nouvelle-Écosse, Terra Spencer. Ce concert festif allie la richesse sonore de l'une des plus grandes fanfares militaires du Canada au talent narratif, au sens de la répartie et au style artistique folk de Terra. Avec au programme des classiques de Noël, des compositions originales inspirées de la région et des performances collaboratives exceptionnelles, ce concert réconfortant célèbre la joie, la magie et l'esprit de cette période de l'année. "
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
