      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://capitol.nb.ca/genid/313e60a9a137ea3c"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://capitol.nb.ca/en/tickets-events/when-you-wish-upon-a-star"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "When You Wish Upon a Star"
      },
      {
        "@language": "fr",
        "@value": "When You Wish Upon a Star"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "\r\nA Magical Celebration of Disney's Most Beloved Music\r\nStep into a world of wonder, imagination and unforgettable music as Tutta Musica brings the magic of Disney to life in a spectacular live orchestral experience.\r\nFrom timeless classics to modern favourites, When You Wish Upon a Star takes audiences on an enchanting musical journey through the songs, stories and characters that have captured hearts and inspired generations.\r\nFeaturing the extraordinary voices of Josée Boudreau, Véronique Hébert and Émilien Cormier, alongside the rich, powerful sound of a live orchestra, this celebration promises moments of nostalgia, excitement and pure Disney magic.\r\nWhether you're rediscovering childhood favourites or sharing the magic with a new generation, this is a musical experience for dreamers of all ages.\r\nConducted by Tony Delgado.\r\n "
      },
      {
        "@language": "fr",
        "@value": "Une célébration magique des plus belles mélodies de Disney\r\nPlongez dans un univers de merveilles, d’imagination et de musique inoubliable : Tutta Musica donne vie à la magie de Disney à travers un spectacle orchestral en direct.\r\nDes grands classiques intemporels aux succès contemporains, When You Wish Upon a Star emmène le public dans un voyage musical enchanteur à travers les chansons, les histoires et les personnages qui ont conquis les cœurs et inspiré des générations.\r\nMettant en vedette les voix extraordinaires de Josée Boudreau, Véronique Hébert et Émilien Cormier, accompagnées par la sonorité riche et puissante d’un orchestre en direct, cette célébration promet des moments de nostalgie, d’émotion et de pure magie à la Disney.\r\nQue vous redécouvriez les succès de votre enfance ou que vous partagiez cette magie avec une nouvelle génération, cette expérience musicale est destinée aux rêveurs de tous âges.\r\nSous la direction de Tony Delgado. "
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
