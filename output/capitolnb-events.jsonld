  {
    "@id": "https://capitol.nb.ca/#983_2027-05-09T15:00:00",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://capitol.nb.ca/en/tickets-events/k-hunters-le-spectacle"
