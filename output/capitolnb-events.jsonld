  {
    "@id": "https://capitol.nb.ca/#873_2026-12-04T19:30:00",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://capitol.nb.ca/en/tickets-events/smokey-mountain-songbird"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
