  {
    "@id": "https://capitol.nb.ca/#982_2027-04-18T18:30:00",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://capitol.nb.ca/en/tickets-events/ballet-jorgen"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-04-18T18:30:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-04-18"
      }
    ],
    "http://schema.org/sameAs": [
      {
        "@id": "https://capitol.nb.ca/en/tickets-events/ballet-jorgen"
      }
    ],
    "http://schema.org/location": [
