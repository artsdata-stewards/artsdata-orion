    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "United by Song"
      },
      {
        "@language": "fr",
        "@value": "Unis par la Chanson"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Local stories made possible by your support, brought to life through original music.\r\nPresented by BMO Private Wealth, United by Song is a one of-a-kind evening where real stories from individuals across southeastern New Brunswick, whose lives have been changed through United Way–supported programs, are transformed into powerful songs by local songwriters.\r\nAudiences can expect an evening of inspiring narratives, heartfelt performances, and a celebration of the generosity that helps agencies in our region focus on what matters most: delivering life-changing programs. "
      },
      {
        "@language": "fr",
        "@value": "Des témoignages d’ici rendus possibles grâce à votre appui et mis en vie par la musique originale.\r\nPrésenté par BMO Gestion privée, Unis par la chanson est une soirée unique où de véritables témoignages de personnes du sud-est du Nouveau-Brunswick, dont la vie a été transformée grâce aux programmes soutenus par Centraide, sont mis en musique par des auteurs-compositeurs locaux.\r\nLe public peut s’attendre à une soirée de récits inspirants, de prestations touchantes et d’une célébration de la générosité qui permet aux organismes de notre région de se concentrer sur l’essentiel : offrir des programmes qui changent des vies. "
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
