      {
        "@id": "https://capitol.nb.ca/images/stories/flexicontent/item_986_field_41/original/jean-michel-blais-intro.jpg"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://capitol.nb.ca/genid/e07fe8d67d237249"
      }
    ],
    "http://schema.org/organizer": [
