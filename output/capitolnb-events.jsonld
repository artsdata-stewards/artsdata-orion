    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Hot Cocoa with Kevin"
      },
      {
        "@language": "fr",
        "@value": "Chocolat chaud avec Kevin"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Enjoy some delicious hot chocolate with Kevin!\r\nBefore the Greater Moncton Santa Claus Parade, our adorable mascot Kevin will be in the Capitol Theatre Lobby to serve you hot chocolate and cookies, as well as pose for a selfie.\r\nThe event is free and open to everyone, young and old.\r\n*Donations to the Capitol Theatre Academy are welcome during this event. "
      },
      {
        "@language": "fr",
        "@value": "Dégustez un bon chocolat chaud avec Kevin!\r\nAvant le défilé du Père Noël du Grand Moncton, notre adorable mascotte Kevin sera dans le hall d’entrée du Théâtre Capitol pour vous offrir du chocolat chaud et des biscuits, en plus de prendre la pose pour un égoportrait.\r\nL’activité est gratuite et ouverte à tout le monde, petits et grands.\r\n*Les dons à l’Académie de théâtre du Capitol sont les bienvenus durant cette activité. "
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
