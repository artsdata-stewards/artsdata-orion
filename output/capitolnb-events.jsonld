    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Luc LeBlanc : À Moitié Fou"
      },
      {
        "@language": "fr",
        "@value": "Luc LeBlanc : À Moitié Fou"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "en",
        "@value": ""
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Luc LeBlanc returns to the stage with his third one-man show, À Moitié fou! A hilarious journey into the mind of a comedian who’s not quite like the others... Between fears, quirks, and the little annoyances of everyday life, he bares his soul without holding back. A perspective on life, aging, and its absurdities that’s both lucid and off-the-wall. Get ready to laugh (and maybe recognize yourself a little… too much)!\r\nPerformance in French "
      },
      {
        "@language": "fr",
        "@value": "Luc LeBlanc revient sur scène avec son troisième one-man-show, À Moitié fou! Un voyage hilarant dans la tête d'un humoriste pas tout à fait comme les autres... Entre peurs, tocs et petites bébittes du quotidien, il se dévoile sans filtre. Un regard à la fois lucide et éclaté sur la vie, l'âge et ses absurdités. Préparez-vous à rire (et peut-être à vous reconnaître un peu... trop)! "
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
