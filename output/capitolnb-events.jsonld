  {
    "@id": "https://capitol.nb.ca/#1106_2026-11-02T16:30:00",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://capitol.nb.ca/en/tickets-events/art-opening-annie-lebouthillier"
      }
    ],
    "http://schema.org/startDate": [
