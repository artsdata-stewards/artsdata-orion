    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "An evening that illuminates the many shapes of love — from yearning and destiny to tenderness and rediscovery.\r\nConductor: Mélanie LéonardGuest artist: Danielle Sametz, violin\r\nProgramM Mozetich: Affairs of the Heart (1997)R Wagner: Siegfried Idyll (1870)J Sibelius: Pelléas et Mélisande Op. 46 (1905) "
      },
      {
        "@language": "fr",
        "@value": "Une soirée qui explore les multiples visages de l’amour : du désir et de la destinée à la tendresse et aux retrouvailles.\r\nCheffe d’orchestre : Mélanie LéonardArtiste invitée : Danielle Sametz, violon\r\nProgrammeM. Mozetich : Affairs of the Heart (1997)R. Wagner : L’Idylle de Siegfried (1870)J. Sibelius : Pelléas et Mélisande, op. 46 (1905) "
      }
    ],
    "http://schema.org/eventAttendanceMode": [
